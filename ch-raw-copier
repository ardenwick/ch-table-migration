#!/bin/bash

declare -g HOSTNAME=$(
    if [[ "$USE_INTERNAL_IP" == true && -n "$SSH_CONNECTION" ]]; then
        echo "$SSH_CONNECTION" | awk '{print$3}' # client IP, client port, server IP, server port
    else
        hostname -f
    fi
)

# Logging facility
export NORMAL=$'\e[0m' BOLD=$'\e[1m' FAINT=$'\e[2m' ITALIC=$'\e[3m' UNDERLINE=$'\e[4m' REVERSED=$'\e[7m'
export RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' MAGENTA=$'\e[35m' CYAN=$'\e[36m' WHITE=$'\e[37m' 
export BG_RED=$'\e[41m' BG_GREEN=$'\e[42m' BG_YELLOW=$'\e[43m' BG_BLUE=$'\e[44m' BG_MAGENTA=$'\e[45m' BG_CYAN=$'\e[46m' BG_WHITE=$'\e[47m'
export NC=$'\e[0m' RST=$'\e[0m'

export LOG_FD_STDOUT=11 LOG_FD_STDERR=12
eval "exec $LOG_FD_STDOUT>&1 $LOG_FD_STDERR>&2"

### LOGGING BLOCK FULL BEGIN

# level name ==> level priority number
declare -Ax LOG_LEVELS=( [TRACE]=1 [DEBUG]=10 [INFO]=20 [NOTIFY]=25 [WARN]=30 [ERROR]=40 [FATAL]=50 )
# level name ==> color escape sequence
declare -Ax LOG_COLORS=( [TRACE]="$FAINT$WHITE" [DEBUG]="$FAINT$GREEN" [INFO]="$BOLD$WHITE" [NOTIFY]="$UNDERLINE$BOLD$YELLOW" [WARN]="$BOLD$YELLOW" [ERROR]="$BOLD$RED" [FATAL]="$REVERSED$RED" )

declare -ux LOG_LEVEL=${LOG_LEVEL:-INFO}
declare -- MYPID=''

function LOG()
{
    local MYPID=${MYPID:-$BASHPID}
    local levelName=$1; shift; local s="$*"
    [[ ${LOG_LEVELS[$levelName]} ]] || return 0
    (( LOG_LEVELS[$levelName] >= LOG_LEVELS[$LOG_LEVEL] )) || return 0

    local time=$(date +'%m%d %T.%2N') color=${LOG_COLORS[$levelName]}
    echo -e "$MAGENTA$time$NC <$MAGENTA$MYPID$NC> [${color}${levelName}$NC] ${color}${s}$NC"
}

### LOGGING BLOCK PATCH BEGIN
function log_trace(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG TRACE "$@" >&$LOG_FD_STDOUT ); }
function log_debug(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG DEBUG "$@" >&$LOG_FD_STDOUT ); }
function log_info(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG INFO "$@" >&$LOG_FD_STDOUT ); }
function log_notify(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG NOTIFY "$@" >&$LOG_FD_STDOUT ); }
function log_warn(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG WARN "$@" >&$LOG_FD_STDERR ); }
function log_warning(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG WARN "$@" >&$LOG_FD_STDERR ); }
function log_error(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG ERROR "$@" >&$LOG_FD_STDERR ); }
function log_fatal(){ local MYPID=${MYPID:-$BASHPID}; ( set +x; LOG FATAL "$@" >&$LOG_FD_STDERR ); }
### LOGGING BLOCK PATCH END

function log_prefix() { local prefix=$1; awk "{ printf \"${MAGENTA}%s${NC}    %s %s\n\",strftime(\"%m%d %T\"),\"$prefix\",\$0 }"; }
function log_error_prefix() { local prefix=$1; awk "{ printf \"${MAGENTA}%s${NC}    %s %s\n\",strftime(\"%m%d %T\"),\"$prefix\",\$0; fflush() }" >&2; }
### LOGGING BLOCK FULL END

function redefine_logger_for_host()
{
    local color=$(get_color $HOSTNAME)
    declare -gx LOG_MARKER_FOR_HOST=''
    if [ -z "$POD" ]; then
        LOG_MARKER_FOR_HOST="($color$HOSTNAME$NC)"
    else
        color=$(get_color $POD)
        LOG_MARKER_FOR_HOST="$color$POD$NC($color$HOSTNAME${WORKER_MODE:+:$WORKER_MODE}$NC)"
    fi
    function LOG()
    {
        local MYPID=${MYPID:-$BASHPID}
        local levelName=$1; shift; local s="$*"
        [[ ${LOG_LEVELS[$levelName]} ]] || return 0
        (( ${LOG_LEVELS[$levelName]} < ${LOG_LEVELS[$LOG_LEVEL]} )) && return 0

        local time=$(date +'%m%d %T.%2N') color=${LOG_COLORS[$levelName]}
        echo -e "$MAGENTA$time$NC $LOG_MARKER_FOR_HOST <$MAGENTA$MYPID$NC> [${color}${levelName}$NC] ${color}${s}$NC"
    }
    function log_prefix() { local prefix=$1; awk "{ printf \"${MAGENTA}%s${NC}    %s %s %s\n\",strftime(\"%m%d %T\"),\"$LOG_MARKER_FOR_HOST\",\"$prefix\",\$0 }"; }
    function log_error_prefix() { local prefix=$1; awk "{ printf \"${MAGENTA}%s${NC}    %s %s %s\n\",strftime(\"%m%d %T\"),\"$LOG_MARKER_FOR_HOST\",\"$prefix\",\$0; fflush() }" >&2; }
}

# log_error_and_exit <code> <message>
function log_error_and_exit(){ local code=$1; shift; log_error "$@"; exit $code; }

# Eval-able snapshot of master's logging context (colors, levels, log_* helpers). Pipe it to bash on a
# remote host (e.g. a bastion) and log_info/log_warn/log_error work the same way as on the master.
# LOG_FD_STDOUT/STDERR are rewritten to 2 so logs leave via the SSH stderr channel and don't taint
# captured stdout.
declare -gx repr_LOGGING_PATCH repr_LOGGING;

[ -z "$BASH_SOURCE" ] || {
    repr_LOGGING_PATCH=$(
        # Pull the canonical logging block verbatim — sidesteps bash<4.4's 'declare -f' bug that rewrites
        # '>&$VAR' as '&>$VAR' (a file redirect to a path named "2").
        # Comment/blank lines are stripped so `$(...)`'s trailing-newline strip can't leave a dangling `#`
        # comment that swallows the next statement when the snapshot is spliced with `;`.
        sed -nr '/^### LOGGING BLOCK PATCH BEGIN/,/^### LOGGING BLOCK PATCH END/{/^\s*#/d;p}' "$BASH_SOURCE"
    )
    repr_LOGGING=$(
        declare -p NORMAL BOLD FAINT ITALIC UNDERLINE REVERSED \
                RED GREEN YELLOW BLUE MAGENTA CYAN WHITE \
                BG_RED BG_GREEN BG_YELLOW BG_BLUE BG_MAGENTA BG_CYAN BG_WHITE \
                NC RST
        sed -nr '/^### LOGGING BLOCK FULL BEGIN/,/^### LOGGING BLOCK FULL END/{/^\s*#/d;p}' "$BASH_SOURCE"
    )
}

function timestamp() { date +%s; }
function timestamp_ms() { date +%s%3N; }
function datetime() { date +'%F %T'; }
function datetime_ms() { date +'%F %T.%3N'; }

function init_tmpdir() { declare -gx TMPDIR="/tmp/crc/$TASK_SIGNATURE"; mkdir -p $TMPDIR; }
function mktmp() { local file=$(mktemp -t crc_XXXXXX); echo $file; log_trace "Temporary file $file acquired by ${FUNCNAME[1]}"; }

function get_color()
{
    local text="$*"; [ -z "$text" ] && text=$(cat);
    local hash=$(( 0x$(echo "$text" | sha256sum | cut -c 1-8) ))

    # Make a random RGB color that has constant brightness.
    # https://en.wikipedia.org/wiki/YCbCr

    # Note that this is darker than the middle relative luminance, see "Gamma_correction" and "Luma_(video)".
    # It still looks awesome.
    local y=128;

    local cb=$((hash % 256));
    local cr=$((hash / 256 % 256));

    local r=$(( (y*1000 + 1402 * (cr - 128)) / 1000 )); r=$(( r <= 255 ? r : 255 )); r=$(( r > 0 ? r : 0 ));
    local g=$(( (y*1000 - 344 * (cb - 128) - 714 * (cr - 128)) / 1000 )); g=$(( g <= 255 ? g : 255 )); g=$(( g > 0 ? g : 0 ));
    local b=$(( (y*1000 + 1772 * (cb - 128)) / 1000 )); b=$(( b <= 255 ? b : 255 )); b=$(( b > 0 ? b : 0 ));

    # ANSI escape sequence to set 24-bit foreground font color in terminal.
    echo $'\033'"[38;2;${r};${g};${b}m";
    # echo -e "text=$text\t y=$y\t cb=$cb\t cr=$cr\t r=$r\t g=$g\t b=$b" >&2
}

declare -g SIGNAL_QUEUE_FILE=ch-table-migration.$BASHPID.sig

declare -A BACKUP_SIGNAL_ACTIONS=()

function disable_signals() { for sig; do BACKUP_SIGNAL_ACTIONS[$sig]=$(trap -p $sig); trap "echo $sig >> $SIGNAL_QUEUE_FILE; log_info 'Received signal $sig'" $sig; done; }
function restore_signals() { for sig; do eval "${BACKUP_SIGNAL_ACTIONS[$sig]:-"trap - $sig"}"; unset "BACKUP_SIGNAL_ACTIONS[$sig]"; done; }

function pid_descendants()
{
    local include_parent=${1:-true}; shift
    local pids=$(echo $(IFS=$'\n'; echo "${*:-$BASHPID}" | sort -u))
    [ $include_parent == true ] && echo $pids;
    ps -eo pid,ppid | awk -v pids="$pids" '
        BEGIN { n = split(pids, arr); for (i=1; i<=n; i++) descendants[arr[i]]=1 }
        {
            if ($2 in descendants) {
                descendants[$1]=1
                print $1
            }
        }
    '
}

function trap_kill_group(){
    local terminate=${1:-'false'}
    trap "
        code=\$?; set +x;
        trap - SIGINT SIGTERM EXIT
        [ $terminate == true ] && kill -s SIGTERM -- -$$;
        pid_descendants true \$(jobs -p) | xargs --no-run-if-empty kill -s SIGTERM 2> >(grep -vF 'No such process' >&2) || :
        exit \$code
    " SIGINT SIGTERM EXIT;
}
function trap_restore_kill_group(){ trap - SIGINT SIGTERM EXIT; }

function wait_pids_patiently()
{
    local initial_interval=$1 pids=( $2 ) names=( $3 ) regex_pattern="${4:-.*}"
    local N=${#pids[@]} ret=0

    if [ $N == 0 ]; then return; fi
    if [ $N -gt 1 ]; then
        log_debug "Will wait for $N pids ${pids[*]}, each named ${names[*]}"
    else
        log_debug "Will wait for pid ${pids[*]} named ${names[*]}"
    fi

    local interval=$initial_interval last=$(timestamp_ms) last_remaining=""
    while true; do
        sleep 0.2
        local i=0 remaining=""
        while (( i < N )); do
            local pid=${pids[i]}
            if [ -n "$pid" ]; then
                if [ -e /proc/$pid ] && grep -Pqe "$regex_pattern" /proc/$pid/cmdline 2>/dev/null; then
                    remaining+="${names[i]}($pid) "
                else
                    if ! wait $pid; then ret=1; fi
                    pids[i]=''
                fi
            fi
            ((++i));
        done
        if [ -z "$remaining" ]; then break; fi

        if (($(timestamp_ms) - last > interval * 1000)); then
            log_debug "Still waiting for $(echo $remaining | wc -w) PIDs: $remaining";
            if [ "$remaining" == "$last_remaining" ]; then
                ((interval+=3));
            else
                ((interval=initial_interval));
            fi
            last=$(timestamp_ms) last_remaining=$remaining
        fi
    done
    return $ret
}

function exit_when_orphaned()
{
    while true; do
        local ppid=$(ps -o ppid= $$)
        if [ -z "$ppid" ] || [ $ppid == 1 ]; then
            # log_notify "Exiting as I am left orphaned." # No one listens to an orphan process
            kill -s SIGTERM -- -$$
        fi
        sleep 1
    done
}

function unindent()
{
    local text=$1; [ -n "$text" ] || text=$(cat)
    text="${text##$'\n'}"
    local indent=$(sed -nr '/^ +/{s|^( +)[^ ].*$|\1|p}' <<<"$text" | head -1)
    sed -r "s|^$indent||g; s|^\s+$||g" <<<"$text"
}

function with_prefix() { SEP='/'; sed "s${SEP}^${SEP}$1${SEP}"; }
function with_suffix() { SEP='/'; sed "s${SEP}\$${SEP}$1${SEP}"; }

function var_defined() { declare -p "$1" >/dev/null 2>&1; }
function func_defined() { declare -F "$1" >/dev/null 2>&1; }

function variables_declaration() { for var; do declare -p $var 2>/dev/null | sed -r '1{ /^declare -[-aAfFgilrtux ]*a/{ s|\[[0-9]+\]=||g }; s|^declare |declare -g |g}'; done; }

# Tricky code for function invocations by `xargs` to work.
function bash_export_patch()
{
    # Declarations of indexed or associative array variables
    declare -p $(declare -p $(compgen -A variable) | awk -vFS='=| ' '$1 ~ /^declare$/ && $2 ~ /x/ && $2 ~ /[Aa]/ {print $3}')
    echo "$repr_LOGGING_PATCH" 
}

function variables_defined() { local names=''; for var; do [ "${!var}" == "" ] && names+="${names:+ }$var"; done; echo "$names"; [ -z "$names" ]; }
function check_variables_defined()
{
    [ $# -gt 0 ] || return 0;
    local names
    names=$(variables_defined "$@") || {
        log_error "${FUNCNAME[1]}: Logical error: $(plural "$names" 'required variable is' 'required variables are') not defined: $(csv_quoted $names)"
        return 1
    }
}

function parse_variable_assignments()
{
    local var=$1 expr=$2
    declare -gA $var
    while read -r l; do
        IFS='=' read -r name value <<<"$l"
        [[ -n "$name" && -n "$value" ]] || {
            log_error "Invalid variable assignment expression: '$l'."
            return 1
        }
        eval "$var[$name]=$value"
    done <<<"$(tr , '\n' <<<"$expr")"
}

function bash_map_variable_to_awk_repr()
{(
    local var=$1 repr=$(declare -p "$1" 2>/dev/null) awk_repr=''
    [ -n "$repr" ] || return 1;

    eval "unset __VAR__; declare -A __VAR__=${repr#*=}"

    for k in ${!__VAR__[@]}; do awk_repr+="$var[\"$k\"]=\"${__VAR__[$k]}\";"; done
    echo "$awk_repr"
)}

function read_variable()
{
    local variable=$1 file=${2:-$0}
    # shellcheck disable=SC2016
    sed -n "/^--- BEGIN VARIABLE $variable$/,/^--- END VARIABLE $variable$/p" $file | sed -n '1n;$b;p'
}

function array_transpose() { (IFS=$'\n'; echo "$*") }
function array_sorted() { (IFS=$'\n'; echo "$*" | sort) }
function csv_quoted(){ QM=${QM:-"'"}; echo -n $QM; for e; do echo -n "$e"$'\1'; done | sed -r "s|\x1\$||; s|\x1|$QM,$QM|g"; echo -n $QM; }

# Parses expressions "1,3,5-8,10" as "1 3 5 6 7 8 10"
function parse_discrete_ranges()
{
    local range ranges;
    local out=()
    IFS=',' read -a ranges <<<"$1"
    for range in ${ranges[@]}; do
        if [[ "$range" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            out+=( $(seq ${BASH_REMATCH[1]} ${BASH_REMATCH[2]}) )
        else
            out+=("$range")
        fi
    done
    echo "${out[@]}"
}

# Spaces in arguments are not supported
# This overrides EXIT signal handler
function rm_on_exit()
{
    if [ $$ == $BASHPID ]; then
        log_error "Function rm_on_exit should be invoked from within a subshell."
        return 1;
    fi
    trap "rm $*" EXIT;
}

function plural(){
    local v=$1 single=$2 plural=$3;
    [[ "$v" =~ ^[0-9]+$ ]] || v=$(array_transpose $v | wc -l);
    if [ "$v" -gt 1 ]; then echo "$v $plural"; else echo "$v $single"; fi;
}

function mktable(){ local sep=${1:-$'\t'}; column -t -s "$sep"; }

# Query exception code
declare -gx EXCEPTION_CODE=0

function grep_exception_code() { sed -nr 's|^Code: ([0-9]+)\. DB::.+|\1|p; s|^std::exception. Code: ([0-9]+)[^0-9].+|\1|p'; }
function grep_exception_code_no_anchor() { sed -nr 's|^.*Code: ([0-9]+)\. DB::.+|\1|p; s|^.*std::exception. Code: ([0-9]+)[^0-9].+|\1|p'; }

# Space characters in arguments are not supported.
function kube_ch()
{
    local pod=$1 cmd=$2 query=$3; shift 3
    log_trace "$KUBECTL exec -i $pod -- $cmd $* --query $query"

    EXCEPTION_CODE=0

    local pod_color=$(get_color $pod)
    local stderr_file=$(mktmp)
    local exit_code_file=$(mktmp)

    (
        set +e -o pipefail;
        $KUBECTL exec -i $pod -- bash -c "f=\$(mktemp);while [ -f \$f ];do sleep 0.02;((++i % 1000 == 0))&&echo -n ~@~@~@~HEARTBEAT~@~@~@~;done& $cmd $*;r=\$?;rm -f \$f 2>/dev/null;wait;exit \$r" 2>$stderr_file <<<"$query" | sed 's/~@~@~@~HEARTBEAT~@~@~@~//g';
        echo $? > $exit_code_file
    )

    local ret=$(cat $exit_code_file)
    if [ $ret != 0 ]; then
        EXCEPTION_CODE=$(cat $stderr_file | tee >(log_prefix "[$pod_color$pod$RST]" >&2) | grep_exception_code | head -1)
    elif [ $(stat -c %s $stderr_file) != 0 ]; then
        ret=1;
        log_error "Uncaught error with zero exit code but non-empty stderr content:\n$(cat $stderr_file)"
    fi
    log_debug "Exception code: $EXCEPTION_CODE, return: $ret."
    rm -f $stderr_file $exit_code_file
    return $ret
}

function kube_chc_query() { kube_ch $POD0 clickhouse-client "$@" "${CHC_FLAGS[@]}"; }

function kube_chc_query_all()
{
    local query=$1; shift
    log_trace "clickhouse-client ${CHC_FLAGS[*]} $* --query $query"

    EXCEPTION_CODE=0

    local -A stderr_files=()
    local -a pids=()

    trap_kill_group;
    for pod in ${PODS[@]}; do
        stderr_files[$pod]=$(mktmp)
        if [ ${LOG_PREFIX:-false} == true ]; then
            local pod_color=$(get_color $pod)
            $KUBECTL exec -i $pod -- clickhouse-client "${CHC_FLAGS[@]}" "$@" 2>${stderr_files[$pod]} <<<"$query" | log_prefix "[$pod_color$pod$RST]" &
        else
            $KUBECTL exec -i $pod -- clickhouse-client "${CHC_FLAGS[@]}" "$@" 2>${stderr_files[$pod]} <<<"$query" &
        fi
        pids+=" $!"
    done
    wait_pids_patiently 10 "$pids" "${PODS[*]}" # Don't return from here, or stderr_files are left behind.
    trap_restore_kill_group;

    # Messy error outputs
    local stderr_size=0
    for f in ${stderr_files[@]}; do stderr_size=$((stderr_size + $(stat -c %s $f) )); done

    if (( stderr_size > 0 )); then
        for pod in ${!stderr_files[@]}; do
            local pod_color=$(get_color $pod)
            local exception_code=$(cat ${stderr_files[$pod]} | tee >(log_error_prefix "[$pod_color$pod$RST]") | grep_exception_code | head -1)
            if ((EXCEPTION_CODE == 0 && exception_code != 0)); then EXCEPTION_CODE=$exception_code; fi
        done
    fi
    rm -rf ${stderr_files[*]};
    if [ $EXCEPTION_CODE != 0 ]; then
        log_debug "Exception code: $EXCEPTION_CODE, return 1"
        return 1
    fi
}

declare -gxa CHC_FLAGS=()

# Set '--name=value' flags for clickhouse-client
function set_chc_params()
{
    local override=${1:-'false'}; shift;
    local arg name value prefix regex='^([0-9]+[KMGTP])i?B?$';
    for arg; do
        [ -n "$arg" ] || continue
        if [[ ! "$arg" =~ ^- ]]; then log_error "[set_chc_params] Argument to pass to clickhouse-client should start with '-' or '--'."; exit 1; fi
        if [[ "$arg" =~ '=' ]]; then # has value
            name=${arg%%=*}; value=${arg#*=};
            [[ $value =~ $regex ]] && value=$(numfmt --from=iec --to=none ${BASH_REMATCH[1]}) || :;
            prefix="$name=";
            arg="$name=$value";
        else
            prefix="$arg";
        fi
        local i=$(
            i=0;
            for x in ${CHC_FLAGS[@]}; do if [[ "$x" =~ ^"$prefix" ]]; then echo $i; break; fi; ((++i)); done
        )
        if [ -n "$i" ]; then
            if [ "$override" == true ]; then
                unset "CHC_FLAGS[$i]";
            else
                continue;
            fi
        fi
        CHC_FLAGS=( "${CHC_FLAGS[@]}" "$arg" );
    done;
}

function distinct_engines_of_database()
{
    local db=$1
    kube_chc_query "SELECT arrayStringConcat(arraySort(groupUniqArray(engine)), ',') AS engines FROM clusterAllReplicas('{cluster}',system.databases) WHERE database='$db'"
}

function are_clickhouse_servers_ready()
{
    log_info "Checking ClickHouse server PODs with 'SELECT 1'"
    # Verify these are actually ClickHouse PODs
    local chosen_server_pods=( $(array_transpose ${PODS[@]} | grep -P "$POD_REGEX") )
    local res=$(
        PODS=( ${chosen_server_pods[@]} )
        kube_chc_query_all "SELECT 1"
    )
    regex="^1{${#chosen_server_pods[@]}}\$" # Regex to match N consecutive '1'

    if ! [[ "${res//$'\n'/}" =~ $regex ]]; then
        log_error "All chosen PODs should be healthy ClickHouse servers, but some are not responding to query 'SELECT 1'. Results: \n$res"
        return 1;
    fi
}

# PARTITION_CONDITION --> POD2PARTITIONIDS
function query_matching_partition_ids()
{
    local result condition="database='$DB' ${TABLES:+AND table IN ( $(csv_quoted $TABLES) )} ${PARTITION_CONDITION:+AND $PARTITION_CONDITION}"
    local query="
        SELECT hostname() AS Host,arrayStringConcat(groupUniqArray(partition_id),',') AS \`Partition IDs\`
        FROM clusterAllReplicas('{cluster}',system.parts)
        WHERE match(Host,'$POD_REGEX') AND active AND $condition
        GROUP BY Host
        FORMAT TabSeparatedWithNames"

    log_info "Querying for partitions IDs matching condition: \"$condition\""

    result=$(kube_chc_query "$query")

    if [ -z "$result" ]; then
        log_error "Error retrieving partition IDs with query: $query";
        return 1
    else
        log_info "$result"
    fi
    while read -r pod array_str; do POD2PARTITIONIDS[$pod]=$array_str; done < <(echo "$result" | tail -n+2)
    for pod in ${CHOSEN_PODS[@]}; do [ -n "${POD2PARTITIONIDS[$pod]}" ] || POD2PARTITIONIDS[$pod]="NONE"; done
}

function check_consistency_of_objects_on_cluster()
{(
    set -e
    log_info "Checking all ClickHouse servers for consistency of objects."
    local db=${1:-$DB}
    local pids='' names=''
    for query in "
        -- table columns
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,database,table,name,type,default_kind,default_expression
        FROM clusterAllReplicas('{cluster}', system.columns)
        WHERE database='$db'
        GROUP BY database,table,name,type,default_kind,default_expression
        HAVING count != count_hosts
        ORDER BY count,database,table,name,type,default_kind,default_expression
    " "
        -- table indexes
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,database,table,name,type_full,expr
        FROM clusterAllReplicas('{cluster}', system.data_skipping_indices)
        WHERE database='$db'
        GROUP BY database,table,name,type_full,expr
        HAVING count != count_hosts
        ORDER BY count,database,table,name,type_full,expr
    " "
        -- functions
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,name,create_query
        FROM clusterAllReplicas('{cluster}', system.functions)
        WHERE origin != 'System'
        GROUP BY name,create_query
        HAVING count != count_hosts
    " "
        -- user entities
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,name
        FROM clusterAllReplicas('{cluster}', system.users)
        GROUP BY name
        HAVING count != count_hosts
    " "
        -- grants
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,user_name,role_name,access_type,database,table,column,is_partial_revoke,grant_option
        FROM clusterAllReplicas('{cluster}', system.grants)
        GROUP BY user_name,role_name,access_type,database,table,column,is_partial_revoke,grant_option
        HAVING count != count_hosts
        ORDER BY count,user_name,role_name,access_type,database,table,column,is_partial_revoke,grant_option
    " "
        -- row policies
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            arraySort(groupArray(replaceOne(left(hostname(),-2),'chi-'||getMacro('installation')||'-'||getMacro('cluster')||'-',''))) AS hosts
        SELECT
            hosts,count() AS count,name,database,table,select_filter,is_restrictive,apply_to_all,apply_to_list,apply_to_except
        FROM clusterAllReplicas('{cluster}', system.row_policies)
        GROUP BY name,database,table,select_filter,is_restrictive,apply_to_all,apply_to_list,apply_to_except
        HAVING count != count_hosts
        ORDER BY count,name,database,table,select_filter,is_restrictive,apply_to_all,apply_to_list,apply_to_except
    "; do
        local name=$(echo "$query" | awk 'NR==2{$1=""; print substr($0,2)}')
        (
            tmp=$(mktmp); rm_on_exit -f $tmp

            kube_chc_query "$query" --format PrettyCompactMonoBlock --output_format_pretty_max_value_width=30 > $tmp
            [ $? == 0 ] || {
                log_error "Error checking consistency of $name."
                return 1
            }
            if [ $(stat -c %s $tmp) -gt 0 ]; then
                (
                    flock -x 9
                    log_error "${name^} are not consistent on cluster:$RST\n$(head -100 $tmp)"
                    count=$(cat $tmp | wc -l)
                    ((count <= 100)) || {
                        echo "(+ $((count - 100)) truncated lines)"
                    }
                ) 9</dev/stdout
                return 1
            fi
        ) &
        pids+=" $!"; names+=" consistency-check-${name// /_}"
    done
    wait_pids_patiently 5 "$pids" "$names"
)}

function lock_file()
{
    local lockfile=$1 fd=$2 timeout=${3:-60} ret=0

    if [ -f /proc/$$/fd/$fd ]; then
        log_error "Logical error: Fd $fd has been already taken."
        return 1
    fi

    eval "exec $fd< $lockfile"

    flock -E 249 -w $timeout -x $fd; ret=$?

    if [ $ret != 0 ]; then
        if [ $ret == 249 ]; then
            log_error "Unable to lock file '$lockfile'. Another instance is running.";
        else
            log_error "Unexpected error code $ret from flock."
        fi
        return $ret;
    fi
}

function init_cache()
{
    check_variables_defined TASK_SIGNATURE || return 1
    if [ "$NO_CACHE" == true ]; then
        rm -rf .crc/cache/$TASK_SIGNATURE
        return
    fi
    mkdir -p .crc/cache/$TASK_SIGNATURE
    touch .crc/cache/$TASK_SIGNATURE/lock
}

function read_cache()
{
    local dir=".crc/cache/$TASK_SIGNATURE" file=$1
    if [[ "$NO_CACHE" != true && -f "$file" && $(stat -c %Y $dir/$file) -le $(( $(date +%s) - 3600 )) ]]; then
        flock -x $dir/lock cat $dir/$file
    fi
}

function write_cache()
{
    local dir=".crc/cache/$TASK_SIGNATURE" file=$1
    if [ "$NO_CACHE" != true ]; then
        flock -x $dir/lock cat > $dir/$file
    fi
}

function real_detect_clickhouse_credentials()
{
    if [ -n "$CLICKHOUSE_USER" ]; then return 0; fi

    log_info "Detecting ClickHouse credentials."
    local chi_json=$($KUBECTL get $($KUBECTL get chi -oname | head -1) -o json)
    if [ -z "$chi_json" ]; then
        log_error "Cannot retrieve CHI object from kubernetes"
        return 1
    fi

    local password=''
    # General CHI
    local repr=''
    repr=$($KUBECTL get cm etc-clickhouse-operator-files -o json | jq -r '.data["config.yaml"]' | sed -nr '/^  access:/,/^ ? ?[^ ]/{ /^\s+(username|password)/ { s/^/local/; s/: */=/; p } }')
    if [[ "$repr" =~ "password" ]]; then
        eval "$repr"
        export CLICKHOUSE_USER=${username:-operator} CLICKHOUSE_PASSWORD=$password;
        return 0
    fi
    log_error "Cannot detect ClickHouse credentials in current environment."
    return 1
}

function detect_clickhouse_credentials()
{
    if [[ " ${CHC_FLAGS[*]}" =~ ' --user' ]]; then return 0; fi

    eval "$(read_cache credentials)"
    if [ -z "$CLICKHOUSE_USER" ]; then
        real_detect_clickhouse_credentials || return;
        variables_declaration CLICKHOUSE_USER CLICKHOUSE_PASSWORD | write_cache credentials
    fi
    set_chc_params true "--user=$CLICKHOUSE_USER" "${CLICKHOUSE_PASSWORD:+"--password=$CLICKHOUSE_PASSWORD"}"
}

declare -gx CLICKHOUSE_SERVER_POD_LABEL='clickhouse.altinity.com/chi'
# Assumes clickhouse-server be the first container in POD.
declare -gx GET_PODS_HEADER_WITH_NODE_NAME=".metadata.namespace .metadata.name .status.containerStatuses[0].containerID .spec.nodeName"
declare -gx GET_PODS_HEADER_WITH_NODE_IP=".metadata.namespace .metadata.name .status.containerStatuses[0].containerID .status.hostIP"

declare -gx PODS_INFO=''
# Do not use CHOSEN_PODS where '--keep-placeholder-pods' is applied
declare -gxa PODS=() CHOSEN_PODS=() CHOSEN_NODES=()
declare -gxA POD2NODE=() NODE2POD=()

# Shared kubectl + jq + namespace-disambiguation step, used by 'get_clickhouse_pods' (source side) and
# by 'discover_remote_hosts' over SSH. Env-driven: NAMESPACE (empty => '-A'), CLICKHOUSE_SERVER_POD_LABEL,
# GET_PODS_HEADER (jq projection), KUBECTL. Outputs one '<ns> <pod> <containerID> <node-info>' line per
# match. Returns 1 on: missing kubectl, no PODs matched, or multiple namespaces seen in '-A' mode.
function get_clickhouse_pods_raw()
{
    if ! command -v kubectl >/dev/null; then log_error "Command 'kubectl' not found."; return 1; fi

    local jq_get_pods_header="${GET_PODS_HEADER// /+\" \"+}" # quote it, or you get different behavior with different bash versions.
    local kubectl_args=() raw_result

    if [ -z "$NAMESPACE" ]; then
        log_info "Detecting namespace where ClickHouse servers live."
        kubectl_args+=(-A)
    else
        log_debug "Retrieving ClickHouse server PODs from namespace '$NAMESPACE'."
        kubectl_args+=(-n "$NAMESPACE")
    fi

    raw_result=$($KUBECTL get pods "${kubectl_args[@]}" -l "$CLICKHOUSE_SERVER_POD_LABEL" -o json | jq -r "(.items // [.])[] | $jq_get_pods_header")

    if [ -z "$raw_result" ]; then
        log_error "Not found any ClickHouse server PODs by \`$KUBECTL get pods ${kubectl_args[*]} -l $CLICKHOUSE_SERVER_POD_LABEL\`."
        return 1
    fi

    if [ -z "$NAMESPACE" ]; then
        local namespaces=$(echo "$raw_result" | awk '{print$1}' | sort -u)
        if [ $(wc -l <<<"$namespaces") -gt 1 ]; then
            log_error "Found multiple namespaces with ClickHouse server PODs: ${namespaces//$'\n'/, }."
            return 1
        fi
        log_info "Found sole namespace '$namespaces'."
    fi

    echo "$raw_result"
}

# Populate variables POD2NODE, NODE2POD, PODS, CHOSEN_PODS, POD0
function get_clickhouse_pods()
{
    local raw_result=$(read_cache server_pods) # information of all PODs

    if [ -z "$raw_result" ]; then
        raw_result=$(get_clickhouse_pods_raw) || return 1
        if [ -z "$NAMESPACE" ]; then
            # Pin KUBECTL to the auto-detected namespace so downstream kube_* calls scope to it.
            local sole_ns=$(echo "$raw_result" | awk 'NR==1{print$1}')
            declare -gx KUBECTL="$KUBECTL -n $sole_ns"
        fi
        echo "$raw_result" | write_cache server_pods;
    fi

    PODS_INFO=$(echo "$raw_result" | sed -r 's| [^ ]+://| |g') # remove docker:// containerd:// cri-o://

    local pattern=$POD_REGEX_FOR_REPLICA; [ "$KEEP_PLACEHOLDER_PODS" == true ] || pattern=$POD_REGEX
    while read _ pod _ node; do
        [ -n "$node" ] || { log_error "Bad PODs:$RST $(PODS_INFO=$'\n'"$PODS_INFO"; declare -p PODS_INFO)"; return 1; }
        POD2NODE[$pod]=$node; NODE2POD[$node]=$pod;
    done <<<"$(echo "$PODS_INFO" | awk "\$2 ~ /^$pattern$/")"

    PODS=( $(array_sorted ${!POD2NODE[@]}) )
    CHOSEN_PODS=( $(array_transpose ${PODS[@]} | grep -P "$POD_REGEX") )
    CHOSEN_NODES=( $(for pod in ${CHOSEN_PODS[@]}; do echo ${POD2NODE[$pod]}; done | sort -u) )

    # Randomly pick one POD as POD0
    local idx=$((RANDOM % ${#CHOSEN_PODS[@]}))
    declare -gx POD0=${CHOSEN_PODS[$idx]}
}

ip_route_src(){ ip route get "${1:-8.8.8.8}" 2>/dev/null | grep -Po 'src \K\S+' | head -1; }

# Populate REMOTE_HOSTS by querying the target ClickHouse cluster. Triggered by '--remote-bastion'
# (discovery runs on the bastion via SSH) and/or '--remote-namespace' (discovery runs locally, assuming
# same Kubernetes cluster). Filters by '--remote-k8s-label' + '--remote-shards' + '--remote-replica',
# reads '.status.hostIP' from each matching pod, then SSHes in and asks `ip route get <master-ip>` for the
# source IP — by construction that IP is on the network shared with our local nodes and is what they can
# actually rsync to.
function discover_remote_hosts()
{
    if [[ -z "$REMOTE_BASTION" && -z "$REMOTE_NAMESPACE" ]]; then return 0; fi

    if [ -n "$REMOTE_HOSTS" ]; then
        log_error "Option '--hosts' must NOT be combined with '--remote-bastion' or '--remote-namespace'."
        return 1
    fi

    if [ -z "$SSH_USER" ]; then
        log_error "Option '--user' is required for remote-host discovery (used to SSH into each remote node to determine its reachable IP)."
        return 1
    fi

    # Master's outbound IP — each remote node will route to this and report back its own source IP.
    local local_ip bastion_ip="${REMOTE_BASTION##*@}"  # strip user@ prefix
    local_ip=$(ip_route_src "${bastion_ip%%:*}")      # strip :port suffix
    if [ -z "$local_ip" ]; then
        log_error "Could not determine local outbound IP via 'ip route get'."
        return 1
    fi
    log_debug "Local outbound IP: $local_ip"

    local remote_label=${REMOTE_CLICKHOUSE_SERVER_POD_LABEL:-$CLICKHOUSE_SERVER_POD_LABEL}
    local remote_pod_regex="chi-.*-($REMOTE_SHARDS_REGEX)-($REMOTE_REPLICA_REGEX)-0"

    local snippet
    snippet=$(
        echo "$repr_LOGGING" | LOG_FD_STDOUT=2 LOG_FD_STDERR=2 envsubst '${LOG_FD_STDOUT} ${LOG_FD_STDERR}'
        declare -f with_prefix ip_route_src remote_bash remote_bash_default get_clickhouse_pods_raw
        variables_declaration SSH SSH_USER SSH_PORT # Env required by remote_bash / remote_bash_default
        variables_declaration GET_PODS_HEADER_WITH_NODE_IP
        LABEL_VAR=$remote_label POD_REGEX_VAR=$remote_pod_regex \
        LOCAL_IP_VAR=$local_ip \
        envsubst '${REMOTE_NAMESPACE} ${LABEL_VAR} ${POD_REGEX_VAR} ${LOCAL_IP_VAR}' <<'BLOCK'
set -o pipefail

local_ip='${LOCAL_IP_VAR}'
pod_regex='${POD_REGEX_VAR}'

# KUBECTL=kubectl forces the bastion's own kubeconfig (no '-n source-ns' from the master).
# GET_PODS_HEADER picks the hostIP variant so .status.hostIP lands in column 4.
raw=$(
    KUBECTL=kubectl
    NAMESPACE='${REMOTE_NAMESPACE}'
    CLICKHOUSE_SERVER_POD_LABEL='${LABEL_VAR}'
    GET_PODS_HEADER=$GET_PODS_HEADER_WITH_NODE_IP
    get_clickhouse_pods_raw
) || exit 1

# Filter to pods matching '--remote-shards' / '--remote-replica'.
result=$(echo "$raw" | awk "\$2 ~ /^$pod_regex$/")

if [ -z "$result" ]; then
    log_error "No remote ClickHouse server PODs matched pod_regex='$pod_regex'."
    exit 1
fi

# Probe ip_route_src in parallel; one tmpfile per pod -> no locking, stderr stays interleaved.
parallel_probes=$(( $(nproc) > 32 ? 32 : $(nproc) ))

tmpdir=$(mktemp -d)
trap "rm -rf '$tmpdir'" EXIT

batch_pids=()
while read -r _ pod_name _ host_ip; do
    [ -n "$pod_name" ] || continue
    [ -n "$host_ip" ] || { log_error "No hostIP for pod '$pod_name'."; exit 1; }
    (
        # Ask the host which source IP it would use to route to the master.
        reachable=$( echo "$(declare -f ip_route_src); ip_route_src $local_ip" | remote_bash "$host_ip" 2> >(log_error_prefix "($host_ip)") )
        if [ -z "$reachable" ]; then
            log_warn "Could not query reachable IP from pod '$pod_name' (tried SSH to $SSH_USER@$host_ip); falling back to hostIP."
            reachable=$host_ip
        fi
        echo "$reachable" > "$tmpdir/$pod_name"
    ) &
    batch_pids+=($!)
    if (( ${#batch_pids[@]} >= parallel_probes )); then
        wait "${batch_pids[@]}"
        batch_pids=()
    fi
done <<<"$result"

[ ${#batch_pids[@]} -eq 0 ] || wait "${batch_pids[@]}"

shopt -s nullglob
cat "$tmpdir"/* | sort -u
BLOCK
    )

    local discovered ret=0
    if [ -n "$REMOTE_BASTION" ]; then
        log_info "Discovering remote ClickHouse cluster nodes via bastion '$REMOTE_BASTION' (label='$remote_label', shards='$REMOTE_SHARDS_REGEX', replica='$REMOTE_REPLICA_REGEX', namespace='${REMOTE_NAMESPACE:-<auto>}', local_ip='$local_ip')."
        IFS=':' read -r address port <<<"$REMOTE_BASTION"
        # remote_bash_default (not remote_bash) so the bastion's .bashrc puts kubectl/jq on PATH.
        discovered=$(echo "$snippet" | SSH_PORT=${port:-22} remote_bash_default "$address") || ret=$?
    else
        log_info "Discovering remote ClickHouse cluster nodes in namespace '$REMOTE_NAMESPACE' of the source Kubernetes cluster (label='$remote_label', shards='$REMOTE_SHARDS_REGEX', replica='$REMOTE_REPLICA_REGEX', local_ip='$local_ip')."
        discovered=$(echo "$snippet" | bash --norc --noprofile) || ret=$?
    fi

    if [[ $ret != 0 || -z "$discovered" ]]; then
        log_error "Failed to discover remote node IPs (exit=$ret, label='$remote_label', shards='$REMOTE_SHARDS_REGEX', replica='$REMOTE_REPLICA_REGEX', namespace='$REMOTE_NAMESPACE', bastion='$REMOTE_BASTION')."
        return 1
    fi

    REMOTE_HOSTS=$(echo $discovered)
    log_info "Discovered $(plural "$REMOTE_HOSTS" 'remote host' 'remote hosts'): ${REMOTE_HOSTS// /,}"
}

declare -gxA POD2DATABASE_ENGINE=()

function get_database_engine_of_pods()
{
    # POD2DATABASE_ENGINE
    local result db=${1:-$DB}
    result=$(kube_chc_query "SELECT splitByChar('.',FQDN())[1] AS host,engine FROM clusterAllReplicas('{cluster}', system.databases) WHERE name='$db' ORDER BY host")

    [[ $? == 0 && -n "$result" ]] || {
        log_error "Error retrieving database engines of '$db' from servers."
        return 1;
    }
    while read pod engine; do POD2DATABASE_ENGINE[$pod]=$engine; done <<<"$result"
}

function is_pod_chosen() { local pod=$1; grep -Pq "$POD_REGEX" <<<"$pod"; }

declare -gxA DISK2PATH=() PATH2DISK=() PODPATH2HOSTPATH=() PODDISK2HOSTPATH=()

function get_disks_and_hostpaths()
{
    eval "$(read_cache disks_and_hostpaths)"
    (( ${#DISK2PATH[@]} == 0 || ${#PODPATH2HOSTPATH[@]} == 0 )) || return 0; # return if both are non-empty

    [ -n "$PODS_INFO" ] || { log_error "$FUNCNAME: Variable 'PODS_INFO' is not defined."; return 1; }

    # DISK2PATH PATH2DISK
    local result
    result=$(kube_chc_query "SELECT name,path FROM system.disks")
    [ -n "$result" ] || { log_error "Error querying table system.disks."; return 1; }
    while read -r name path; do path=${path%/}; DISK2PATH[$name]=$path; PATH2DISK[$path]=$name; done <<<"$result"

    # Check that $CHOSEN_DISK is a valid disk name
    [ -n "${DISK2PATH[$CHOSEN_DISK]}" ] || {
        log_error "'$CHOSEN_DISK' is not a valid disk name from system.disks, available disk names are $(csv_quoted ${!DISK2PATH[@]})."
        return 1
    }

    # PODPATH2HOSTPATH
    local cmd_inspect_container="docker inspect CONTAINERID | jq -r '\"POD \" + (.[].Mounts[] | .Destination + \" \" + .Source)'"

    local cri
    cri=$($KUBECTL get node -o jsonpath='{.items[0].status.nodeInfo.containerRuntimeVersion}')
    [ -n "$cri" ] || { log_error "Error retrieving Kubernetes container runtime version."; return 1; }

    [[ "$cri" =~ 'docker' ]] || cmd_inspect_container="crictl inspect CONTAINERID | jq -r '\"POD \" + (.info.runtimeSpec.mounts[] | .destination + \" \" + .source)'"

    local ret
    result=$(
        set +e
        local pids='' names=''
        while read -r _ pod containerID node; do
            is_pod_chosen $pod || continue
            (
                cmd_inspect_container=${cmd_inspect_container//CONTAINERID/$containerID}
                cmd_inspect_container=${cmd_inspect_container//POD/$pod}

                pod_mounts=$(echo "$cmd_inspect_container" | remote_bash $node)
                if [ $? != 0 ] || [ -z "$pod_mounts" ]; then
                    log_error "Error retrieving path mounts of POD '$pod' from host '$node', with command \`$cmd_inspect_container\`"
                    exit 1;
                else
                    flock -x /dev/stdout echo "$pod_mounts"
                fi
            ) &
            pids+=" $!"; names+=" inspect-pod-mounts-$node"
        done <<<"$PODS_INFO"
        wait_pids_patiently 1 "$pids" "$names"
    ); ret=$?
    [ $ret == 0 ] || return $ret;

    local -A pod2pathmounts=()
    while read -r pod path host_path; do pod2pathmounts[$pod]+="$path:$host_path"$'\n'; done <<<"$result"

    # Resolve final mappings on disks and path mounts:
    # 1. <disk name> --> <host path>
    # 2. <disk path> --> <host path>
    # Examples:
    #   <disk name>  <path in container>          <mount point in container>   <host path>
    #   'default'    /var/lib/clickhouse          /var/lib/clickhouse          **/pvc-ffff
    #   'disk1'      /tmp/clickhouse/disk1        /                            **/merged/tmp/clickhouse/disk1
    #   'disk2'      /var/lib/clickhouse/disk2    /var/lib/clickhouse          **/pvc-ffff/disk2
    result=$(
        set +e
        for pod in ${CHOSEN_PODS[@]}; do
            local hostpathmounts=$(echo "${pod2pathmounts[$pod]}" | sort -drst: -k1)
            (
                local stderr=$(mktmp); rm_on_exit -f $stderr
                result=$(
                    LF=$'\n'
                    echo "$(variables_declaration pod hostpathmounts DISK2PATH LF);" '
                        set -exo pipefail
                        writable_root=$(findmnt -T / -rno OPTIONS | tr , "\n" | grep ^upperdir | cut -d= -f2) # Only consider writable root
                        hostpathmounts="$hostpathmounts$LF/:$writable_root"
                        for disk in ${!DISK2PATH[@]}; do
                            path=${DISK2PATH[$disk]}
                            mountpoint=$(findmnt -T $path -rno TARGET) # find mountpoint of disk path
                            relpath=${path#${mountpoint%/}}
                            hostpath=$(echo "$hostpathmounts" | grep -m1 ^$mountpoint: | cut -d: -f2)/${relpath#/}
                            echo $pod $disk $path ${hostpath%/}
                        done
                    ' \
                    | $KUBECTL exec -i $pod -- bash 2> $stderr
                )
                if [ $? != 0 ] || [ -z "$result" ]; then
                    (
                        flock -x 100
                        log_error "Error retrieving disk path mounts of POD '$pod'."
                        log_debug "Stderr:$RST\n$(cat $stderr)"
                    ) 100< /dev/stdout
                    exit 1;
                else
                    flock -x /dev/stdout echo "$result"
                fi
            ) &
            pids+=" $!"; names+=" resolve-disks-$pod"
        done
        wait_pids_patiently 1 "$pids" "$names"
    ); ret=$?
    [ $ret == 0 ] || return $ret;

    while read -r pod disk path host_path; do
        PODDISK2HOSTPATH[$pod-$disk]=$host_path
        PODPATH2HOSTPATH[$pod-$path]=$host_path
    done <<<"$result"

    variables_declaration DISK2PATH PATH2DISK PODPATH2HOSTPATH PODDISK2HOSTPATH | write_cache disks_and_hostpaths
}

# Create and enter a cgroup with limited I/O bandwidth on all block devices.
create_and_enter_cgroup()
{
    local cgroup_name=${1:-'crc-shared'} io_bps=$2
    local cgroup_mount="/sys/fs/cgroup"
    local io_bandwidth_readable=$(numfmt --from=none --to=iec $io_bps)
    local success=0

    # Must be root
    if [ "$(id -u)" -ne 0 ]; then
        log_error "❌ Error: must be run as root (sudo)"
        return 1
    fi

    log_info "Creating cgroup '$cgroup_name' with IO limit ${io_bandwidth_readable}iB/s per device ..."

    # Detect all block devices (disks only)
    local devs=()
    while read -r name type; do
        if [ "$type" = "disk" ] && [ -b "/dev/$name" ]; then
            devs+=("/dev/$name")
        fi
    done < <(lsblk -ndo NAME,TYPE)

    if [ ${#devs[@]} -eq 0 ]; then
        log_error "❌ No physical block devices found to limit."
        return 1
    fi

    # cgroup v2
    if [ -f "$cgroup_mount/cgroup.controllers" ]; then
        log_info "Detected cgroup v2."
        local cgroup_path="$cgroup_mount/$cgroup_name"

        mkdir -p "$cgroup_path" || {
            log_error "❌ Failed to create $cgroup_path"
            return 1
        }

        # Enable io controller in parent
        if ! grep -qw io "$cgroup_mount/cgroup.subtree_control"; then
            echo "+io" > "$cgroup_mount/cgroup.subtree_control" 2>/dev/null || {
                log_error "❌ Could not enable io controller at $cgroup_mount"
                return 1
            }
        fi

        for dev in "${devs[@]}"; do
            local majmin
            majmin=$(stat -c '%t:%T' "$dev" 2>/dev/null | \
                     awk -F: '{printf "%d:%d", strtonum("0x"$1), strtonum("0x"$2)}')
            if [ -z "$majmin" ]; then
                log_warn "⚠️  Could not resolve major:minor for $dev"
                continue
            fi
            if echo "${majmin} rbps=${io_bps} wbps=${io_bps}" >> "$cgroup_path/io.max" 2>/dev/null; then
                log_info "  applied to $dev ($majmin)"
                success=1
            else
                log_warn "⚠️  Failed to apply IO limit to $dev"
            fi
        done

        if [ $success -eq 0 ]; then
            log_error "❌ No IO limits applied. Permissions or unsupported devices?"
            return 1
        fi

        echo $$ > "$cgroup_path/cgroup.procs" 2>/dev/null || \
            log_warn "⚠️  Failed to join cgroup $cgroup_name" >&2

    # cgroup v1
    else
        log_info "Detected cgroup v1."
        local blkio_path="$cgroup_mount/blkio/$cgroup_name"

        mkdir -p "$blkio_path" || {
            log_error "❌ Failed to create $blkio_path"
            return 1
        }

        for dev in "${devs[@]}"; do
            local majmin
            majmin=$(stat -c '%t:%T' "$dev" 2>/dev/null | \
                     awk -F: '{printf "%d:%d", strtonum("0x"$1), strtonum("0x"$2)}')
            if [ -z "$majmin" ]; then
                log_warn "⚠️  Could not resolve major:minor for $dev"
                continue
            fi
            if echo "$majmin $io_bps" > "$blkio_path/blkio.throttle.read_bps_device" 2>/dev/null \
               && echo "$majmin $io_bps" > "$blkio_path/blkio.throttle.write_bps_device" 2>/dev/null; then
                log_info "  applied to $dev ($majmin)"
                success=1
            else
                log_warn "⚠️  Failed to apply IO limit to $dev"
            fi
        done

        if [ $success -eq 0 ]; then
            log_error "❌ No IO limits applied. Permissions or unsupported devices?"
            return 1
        fi

        echo $$ > "$blkio_path/tasks" 2>/dev/null || \
            log_warn "⚠️  Failed to join blkio cgroup"
    fi

    log_info "✅ Cgroup '$cgroup_name' active, ${io_bandwidth_readable}iB/s IO limit per device."
    return 0
}

declare -gx RSYNC_STATS_FILE # Constant. Assigned after argument parsing on master node

declare -gx RSYNC_STATS_VARIABLES="
    TIMESTAMP_START
    TOTAL SENT
    INFLIGHT
"

unset $RSYNC_STATS_VARIABLES

function lock_stats_100()
{
    local timeout=${1:-60} ret=0 file="$RSYNC_STATS_FILE.lock"
    mkdir -p $(dirname $file)

    touch $file
    lock_file $file 100 $timeout
}

function init_rsync_stats()
{
    declare -g TIMESTAMP_START=$(timestamp)
    declare -g TOTAL=0 SENT=0
    declare -A INFLIGHT
    declare -p $RSYNC_STATS_VARIABLES 2>/dev/null > $RSYNC_STATS_FILE
}

function with_stats_locked()
{(
    # lock-read-update-write
    local expr=$1 timeout=${2:-86400000}
    {
        if ! flock -w $timeout -x 10; then
            ((timeout == 0)) || log_error "Timeout aquiring lock on file $RSYNC_STATS_FILE, callers ${FUNCNAME[*]}"
            return 1
        fi
        source $RSYNC_STATS_FILE
        truncate -s0 $RSYNC_STATS_FILE
        eval "$expr"
        # For performance reason， we dont use variables_declaration
        declare -p $RSYNC_STATS_VARIABLES 2>/dev/null >&10
    } 10<> $RSYNC_STATS_FILE
)}

function set_stats_var() { local var=$1 value=$2 timeout=$3; with_stats_locked "$var=$value" $timeout; }
function inc_stats_var() { local var=$1 value=$2 timeout=$3; with_stats_locked "$var=\$(($var + $value))" $timeout; }
function set_stats_var_nonblocking() { set_stats_var "$1" "$2" 0; }
function inc_stats_var_nonblocking() { inc_stats_var "$1" "$2" 0; }

declare -gx KiB=1024
declare -gx MiB=$((KiB*1024))
declare -gx GiB=$((MiB*1024))
declare -gx TiB=$((GiB*1024))

# Ignorable rsync exit codes
#   24 - Partial transfer due to vanished source files
declare -gx RSYNC_IGNORABLE_CODES='0 24'

function rsync_with_record()
{(
    set +e -o pipefail;
    if var_defined XARGS_SLOT; then
        eval "$repr_LOGGING; redefine_logger_for_host";
    fi
    local total_file=$(mktmp); rm_on_exit -f ${total_file:?} # exits if unset

    # 1TiB / 1GiB = 1024 ==> need to update the stats file 1024 times ==> 6s
    rsync "$@" --stats --info=progress1 \
    | tr '\r' '\n' \
    | awk -v batch_size_bytes=${RSYNC_STATS_BATCH_SIZE:-$((100*MiB))} -v total_file=$total_file '
            { last=$0 }
            /^ .+-chk=/ {
                gsub(/,/,"",$1); acc+=$1
                if (acc > batch_size_bytes) { print acc; fflush(); acc=0 }
            }
            END { print last > total_file }
        ' \
    | while read -r acc; do inc_stats_var INFLIGHT[P$XARGS_SLOT] $acc; done

    local rc=$PIPESTATUS
    [[ -n "$rc" && " $RSYNC_IGNORABLE_CODES " =~ " $rc " ]] || {
        with_stats_locked "unset INFLIGHT[P$XARGS_SLOT]"
        # log_error "rsync returned unignorable code $rc."
        return $rc
    }

    local line=$(grep '^total size is ' $total_file)

    if [ -n "$line" ]; then
        sent=$(echo $line | cut -d' ' -f4 | tr -d ,)
        with_stats_locked "SENT=\$((SENT+$sent)); unset INFLIGHT[P$XARGS_SLOT]"
    else
        with_stats_locked "unset INFLIGHT[P$XARGS_SLOT]"
        # log_error "Not found sent files size from 'rsync' output". 
        return 1
    fi
)}

function remote_bash()
{
    local host=$1; shift
    [[ "$host" == *@* ]] || host="$SSH_USER@$host"
    $SSH -T -p $SSH_PORT "$host" bash --norc --noprofile "$@" 2> >(grep -vF 'Warning: Permanently added' >&2)
}

# Like remote_bash but lets the remote's login files run — needed when bashrc puts kubectl/jq on PATH.
function remote_bash_default()
{
    local host=$1; shift
    [[ "$host" == *@* ]] || host="$SSH_USER@$host"
    $SSH -T -p $SSH_PORT "$host" "$@" 2> >(grep -vF 'Warning: Permanently added' >&2)
}

function call_remote_worker()
{
    local host=$1 worker=$2 env_repr=$3
    { echo "$env_repr; declare -g WORKER_MODE=$worker"; cat "$BASH_SOURCE"; } \
    | $SSH -T -p $SSH_PORT "$SSH_USER@$host" bash --norc --noprofile 2> >(grep -vF 'Warning: Permanently added' >&2)
}

function patch_bashrc_for_all_hosts()
{
    local pids='' names=''
    for host in $(array_transpose ${!NODE2POD[@]} $REMOTE_HOSTS | grep -vE '^(localhost|127.)' | sort -u); do
        log_info "Patching bashrc file for host $host"
        echo "set -e; $(declare -f unindent)" '
            ent=$(getent passwd $SSH_USER)
            home=$(echo "$ent" | cut -d: -f6)

            grep -q "SKIP_FOR_NONINTERACTIVE_SHELL" $home/.bashrc && { echo "Marker already present, nothing to do"; exit 0; }
            [ -f $home/.bashrc.bak ] || command cp -a $home/.bashrc $home/.bashrc.bak;

            unindent "
                # SKIP_FOR_NONINTERACTIVE_SHELL BEGIN
                [[ \$- == *i* ]] || return
                # SKIP_FOR_NONINTERACTIVE_SHELL END
            " \
            | cat - $home/.bashrc > $home/.bashrc.new && command mv $home/.bashrc.new $home/.bashrc;
        ' | envsubst '${SSH_USER}' | remote_bash $host | log_prefix $host &
        pids+=" $!"; names+=" patch-rc-$host"
    done
    wait_pids_patiently 5 "$pids" "$names"
}

function create_remote_dir()
{
    log_info "Creating directory on remote hosts: ${REMOTE_HOSTS// /,}"

    local lambda_inspect_fs="f='$REMOTE_DIR'"'; while [ "${f%/}" ]; do (set -x; file $f); f=$(dirname $f); done | column -t -s: -o: | sed "s|^|  |g"'

    local pids="" names="" localhost_created=false
    for host in $(array_transpose $REMOTE_HOSTS | sort -u); do

        if [[ "$host" =~ ^('localhost'|'127.') ]]; then # each node sends data parts to itself
            [ $localhost_created == false ] || continue

            log_info "Creating directory on each node for 'localhost'."
            for node in ${CHOSEN_NODES[@]}; do
                echo "mkdir -p $REMOTE_DIR || { $lambda_inspect_fs >&2; exit 1; }" | remote_bash $node 2> >(log_error_prefix "(from $node)") & pids+=" $!"
                names+=" create-dir-localhost-$node"
            done
            localhost_created=true
        else
            echo "mkdir -p $REMOTE_DIR || { $lambda_inspect_fs >&2; exit 1; }" | remote_bash $host 2> >(log_error_prefix "(from $host)") & pids+=" $!"
            names+=" create-dir-$host"
        fi
    done
    [ -z "$names" ] || wait_pids_patiently 5 "$pids" "$names"
}

function check_required_subdirectories()
{
    local dir=$1 names=''; shift
    if [ ! -d "$dir" ]; then
        log_error "Directory '$dir' does not exist."
        return 1
    fi
    [ $# -gt 0 ] || set -- data store; # necessary subdirectories by default
    for subdir; do [ -d $dir/$subdir ] || names+="${names:+ }$subdir"; done
    [ -z "$names" ] || {
        LOG $LOG_LEVEL "Directory '$dir' does not contain $(plural "$names" 'necessary subdirectory' 'necessary subdirectories') $(csv_quoted $names)." >&$LOG_FD_STDERR
        return 1
    }
}

function database_engine()
{
    local engine=${DATABASE_ENGINE}
    if [ -f database_engine.txt ]; then engine=$(cat database_engine.txt); fi
    echo ${engine:-'Atomic'}
}

function args_or_input() { local s="$*"; [ -n "$s" ] || s=$(cat); echo "$s"; }

function escape_filename()
{(
    set +x
    [ $# -gt 0 ] || set -- "$(cat)";
    while (( $# > 0 )); do
        local s=$1 res=''
        for (( i=0; i<${#s}; i++ )); do
            c=${s:$i:1};
            [[ "$c" =~ [^a-zA-Z0-9_] ]] && c=$(printf '%%%02X' "'$c")
            res+=$c;
        done
        echo -n "$res"
        shift;
        if (( $# > 0 )); then echo -n ' '; fi
    done
)}

function unescape_filename() { local s=$(args_or_input "$@"); echo -e "${s//%/\\x}"; }

function readlink_as_rpath()
{
    local link=$1 file_type='';
    file_type=$(stat $link -c%F)
    if [ "$file_type" == 'symbolic link' ]; then
        readlink $link | sed -r 's|^.*/(store/[^/]+/[^/]+)/?$|\1/|g'
    elif [ "$file_type" == 'directory' ]; then
        echo ${link%%/}/
    else
        log_error "File '$link' is not a symbolic link or directory."
        return 1
    fi
}

# Enumerate database directory names under 'data/'
# Requires: DEFAULT_DIR
function enumerate_database_directories()
{(
    set +e;
    local regex='.*'; [ -z "$DB" ] || regex="$(escape_filename $DB)";
    cd ${DEFAULT_DIR:-.}
    find data/ -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/$regex" -printf '%f\n'
)}

# Enumerate (link, real path) pairs in 'data/'
# Requires: DEFAULT_DIR
function enumerate_table_directories()
{(
    set +e;
    local regex='.*'; [ -z "$TABLES" ] || regex="($(escape_filename $TABLES | tr ' ' '|'))";
    cd ${DEFAULT_DIR:-.}
    for db in $(enumerate_database_directories); do
        if [ $(database_engine) == 'Atomic' ]; then
            find data/$db -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type l -regex ".*/$regex" -printf '%p %l\n'
        else
            find data/$db -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/$regex" -printf '%p %p\n'
        fi
    done | sed -r 's|([^ ]+) .*/(store/[^/]+/[^/]+/)$|\1 \2|g'
)}


declare -gx REGEX_PART_NAME='[0-9a-fl]+_[0-9]+_[0-9]+_[0-9_]+' # e5c54dc3af3e0240ec334505af0121ce_374516_374919_9, all_1170084_1170084_0

# Enumerate (link, partition ID, part path)
# Requires: DISK_DIR, DEFAULT_DIR
function enumerate_parts()
{(
    set +e;
    if [ "$PARTITION_IDS" == 'NONE' ]; then return 0; fi
    local partition_ids=${PARTITION_IDS//,/|} caller=${FUNCNAME[1]}
    cd ${DISK_DIR:-.}
    enumerate_table_directories | while read link rpath; do
        if [ -d $rpath ]; then
            log_trace "Enumerating parts in '$link ($rpath)' for caller function $caller"
            if [ ! -d $rpath/detached ]; then
                log_trace "Directory '$link ($rpath)' suspiciously does not contain subdirectory 'detached'."
            fi
            if [ -z "$partition_ids" ]; then
                find $rpath -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/$REGEX_PART_NAME$" -printf "${link//%/%%} %p\n"
            else
                find $rpath -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/($partition_ids)_[0-9_]+$" -printf "${link//%/%%} %p\n"
            fi
        else
            log_debug "Skipped non-existent directory '$link ($rpath)'."
        fi
    done | sed -r 's|^([^ ]+) (.+/([0-9a-fl]+)_[0-9_]+)$|\1 \3 \2|g'
    # time seq 1 100000 | sed 's|.*|data/business/http_log store/2ae/2ae234234/&_&_&|g' | sed -r 's|^([^ ]+) (.+/([0-9a-fl]+)_[0-9_]+)$|\1 \3 \2|g' >/dev/null
    # 1.492s
    # time seq 1 100000 | sed 's|.*|data/business/http_log store/2ae/2ae234234/&_&_&|g' | while read link path; do partition_id=${path##*/}; partition_id=${partition_id%%_*}; echo $link $partition_id $path; done >/dev/null
    # 7.667s
) 2> >(with_suffix " (stack ${FUNCNAME[*]} from $$)" >&2)
}

# log_trace() { echo "$@" >&2; }; log_debug() { echo "$@" >&2; }; log_info() { echo "$@" >&2; }; log_warn() { echo "$@" >&2; }; log_error() { echo "$@" >&2; }

# Requires: DISK_DIR, DEFAULT_DIR
function spread_parts()
{
    local hosts=( $REMOTE_HOSTS ) jobs=${JOBS:-1}
    local N=${#hosts[@]}
    # Ideal batch_size =~ total_numer_of_parts / number_of_remote_hosts
    local batch_size=${RSYNC_BATCH_SIZE:-500}
    cd $DISK_DIR

    local terminate_xargs_on_error='[ $? == 0 ] || exit 255'; [ "$RSYNC_STRICT" == true ] || terminate_xargs_on_error=':'
    # time seq 100000 -1 1 | awk '{n=strtonum($0); print "data/db/table", int(n/10), "store/aeb/aeb53f/"n"_"n  }' > /dev/null
    # 0.106s
    # time seq 100000 -1 1 | awk '{n=strtonum($0); print "data/db/table", int(n/10), "store/aeb/aeb53f/"n"_"n  }' | while read _ partition_id path; do host=${hosts[$(( 0x${partition_id:0:15} % N))]}; dst="$SSH_USER@$host:$REMOTE_DIR"; echo $path/ $dst; done > /dev/null
    # 6.45s
    # time seq 100000 -1 1 | awk '{n=strtonum($0); print "data/db/table", int(n/10), "store/aeb/aeb53f/"n"_"n  }' | awk ...
    # 0.346s
    enumerate_parts | awk -v N=$N -v SSH_USER=$SSH_USER -v REMOTE_DIR=$REMOTE_DIR -v hosts_str="${hosts[*]}" -v max_batch_size=$batch_size -v ARG_MAX=$(getconf ARG_MAX) '
        # Batch $batch_size parts into one line by partition ID.
        # Input:
        #   <link>   <partition ID>   <part path>
        #   data/db/table 1 store/aeb/aeb53f/1_1_1
        #   data/db/table 1 store/aeb/aeb53f/1_2_2
        #   data/db/table 2 store/aeb/aeb53f/2_1_3
        # Output:
        #   <part path>...  <ssh_user@remote_host:/remote/directory>
        #   store/aeb/aeb53f/1_1_1 store/aeb/aeb53f/1_2_2 $SSH_USER@host1:/remote/dir
        #   store/aeb/aeb53f/2_1_3                        $SSH_USER@host2:/remote/dir
        BEGIN {
            split(hosts_str, hosts, " ");
            batch_size = 10 * N;
            batch_size = batch_size<=max_batch_size ? batch_size : max_batch_size;
            ARG_MAX = ARG_MAX>1024*1024+1024 ? 1024*1024+1024 : ARG_MAX;
        }
        {
            buf[NR % batch_size] = host_index_of($2) " " $0
            count++; len+=length($0) + 1
            if (count == batch_size || len >= ARG_MAX-1024)
            {
                process_batch()
                delete buf; count=0; len=0
                if (batch_size < max_batch_size) # We need a ramp-up.
                    batch_size = batch_size*2 < max_batch_size ? batch_size*2 : max_batch_size
            }
        }
        END { if (count > 0) process_batch() }

        function process_batch()
        {
            asort(buf)
            # for (i in buf) print "-- " buf[i];

            split(buf[1],f,FS)
            key=f[1]; run=f[4]
            for (i = 2; i <= count; i++)
            {
                split(buf[i],f,FS); cur_key=f[1]
                if (key == cur_key)
                    run=run " " f[4]
                else
                {
                    print compose(key, run)
                    key=cur_key; run=f[4]
                }
            }
            if (length(run) > 0)
                print compose(key, run)
            fflush()
        }
        function host_index_of(partition_id)
        {
            return (strtonum("0x"substr(partition_id, 1, 15)) % N) + 1
        }
        function compose(idx, run)
        {
            dst = SSH_USER "@" hosts[idx] ":" REMOTE_DIR
            return run " " dst
        }
    ' | $XARGS -P$jobs -I{} bash -c "rsync_with_record -aR --partial --inplace --delete --force {}; $terminate_xargs_on_error"

    with_stats_locked 'SENT=$SENT.' # Trailing dot for completion indication
}

# Requires: DISK_DIR, DEFAULT_DIR
function calculate_total_file_size()
{
    set +e;
    local delta=0 acc=0 batch_size=$GiB jobs=${JOBS:-1}
    cd $DISK_DIR

    set_stats_var TOTAL 0;
    while read delta; do
        ((acc+=delta, acc >= batch_size)) && {
            # Retry locking on next iteration if it fails occasionally
            if inc_stats_var_nonblocking TOTAL $acc; then acc=0; fi
        }
    done < <(
        enumerate_parts | awk '{print$3}' | xargs -I_ find _ -type f -printf "%s\n" 2> >(with_suffix " (stack ${FUNCNAME[*]} from $$)" >&2) \
        | awk "{acc+=\$1;count++} acc>$((batch_size/10))&&count>=10000 {print acc;acc=0;count=0;fflush()} END {print acc}"
    )
    inc_stats_var TOTAL $acc
    with_stats_locked 'TOTAL=$TOTAL.' # Trailing dot for completion indication
}

function send_nondata()
{
    check_required_subdirectories $DEFAULT_DIR access metadata data user_defined || return 1
    cd $DEFAULT_DIR

    local terminate_xargs_on_error='[ $? == 0 ] || exit 255'; [ "$RSYNC_STRICT" == true ] || terminate_xargs_on_error=':'

    local pids="" names=""
    for host in $REMOTE_HOSTS; do
        local dst=$SSH_USER@$host:$REMOTE_DIR

        log_info "Sending subdirectories to $host: $(csv_quoted access metadata data user_defined)"
        {
            {
                echo access user_defined

                local -A metadatalink2rpath=()

                # symlink 'metadata/<db>', file 'metadata/<db>.sql', dictionaries, views
                while read -r db; do
                    local metadatalink="metadata/$db"
                    local metadata_rpath=$(readlink_as_rpath $metadatalink)
                    metadatalink2rpath[$metadatalink]=$metadata_rpath
                    echo "$metadatalink"
                    echo "$metadatalink.sql"
                    grep -l '^CREATE DICTIONARY' -r $metadata_rpath/ || :
                    grep -Pl '^ATTACH (MATERIALIZED )?VIEW' -r $metadata_rpath/ || :
                done < <(enumerate_database_directories)

                local awk_vars=$(bash_map_variable_to_awk_repr metadatalink2rpath)

                # symlink 'data/<db>/<table>', file 'store/.../.../<table>.sql'
                enumerate_table_directories | awk '
                    BEGIN { '"$awk_vars"' }
                    {
                        link=$1; split(link, f, "/")
                        db=f[2]; table=f[3];
                        metadatalink="metadata/" db
                        print link
                        print metadatalink2rpath[metadatalink] table ".sql"
                    }'
            } \
            | awk -v batch_size=${RSYNC_BATCH_SIZE:-500} -v ARG_MAX=$(getconf ARG_MAX) '
                    BEGIN { ARG_MAX = ARG_MAX>1024*1024+1024 ? 1024*1024+1024 : ARG_MAX; }
                    {
                        run=run" "$0; count++; len+=length($0);
                        if (count>=batch_size || len>=ARG_MAX-1024)
                        {
                            print run;
                            run=""; count=0; len=0
                        }
                    }
                    END { if (run) print run }
                ' \
            | $XARGS -I{} bash -c "rsync -lptgoDdR --partial --inplace --delete --force {} $dst; $terminate_xargs_on_error" # rsync -a == rsync -rlptgoD

            echo "cd $REMOTE_DIR; echo $DATABASE_ENGINE > database_engine.txt" | remote_bash $host
        } &
        pids+=" $!"; names+=" nondata-to-$host"
    done
    wait_pids_patiently 5 "$pids" "$names"
}

# On worker nodes
function send_worker()
{
    set -e;
    # Implicit variables DB,TABLES,PARTITION_IDS are not mandatory, yet affects behavior of enumerator functions.
    check_variables_defined RSYNC_STATS_FILE DEFAULT_DIR DISK_DIR REMOTE_HOSTS REMOTE_DIR
    # TODO also lock the $BASE_DIR on remote hosts.
    lock_stats_100

    check_required_subdirectories $DEFAULT_DIR .
    check_required_subdirectories $DISK_DIR .

    init_rsync_stats

    local pid
    calculate_total_file_size & pid=$!
    log_debug "Spawned thread $pid for background calculation of total file size."

    send_nondata

    if [ $WORKER_MODE == p2p ]; then
        log_info "Will send data parts to remote host: $REMOTE_HOSTS."
        spread_parts
        log_info "All data parts sent."
    else
        log_info "Will spread data parts to remote hosts: ${REMOTE_HOSTS// /,}."
        spread_parts
        log_info "All data parts spreaded out."
    fi
    wait $pid
}

function p2p_worker() { send_worker; }
function spread_worker() { send_worker; }

# Returns false if the distributed DDL queue is busy.
function check_busy_distributed_ddl_queue()
{(
    set -e
    local max_ddl_age=${1:-'0'}; # Max age of unfinished DDL entries to consider the queue as 'busy'
    local result sql="SELECT entry,query_create_time,host,replaceRegexpAll(query,'(\n *)|( {2,})',' ') AS query
        FROM system.distributed_ddl_queue
        WHERE status!='Finished' AND (now() - query_create_time) >= $max_ddl_age
        ORDER BY query_create_time ASC
        LIMIT 10
        FORMAT PrettyCompactMonoBlock"

    log_info "Checking distributed DDL queue ..."
    result=$(kube_chc_query "$sql")

    if [ -n "$result" ]; then
        log_debug "${NC}\n$result"
        return 1;
    fi
    return 0;
)}


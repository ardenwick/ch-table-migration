# ATTACH, DROP or REPLACE active with detached partitions
function attach_or_drop_detached_partitions()
{(
    set +e;
    local POD0=$1 action=${2^^} db=$3 table=$4 reason=$5 batch_size=100
    local quoted_qualified_table="\`$db\`.\`$table\`"
    local marker="$RST[$(get_color $POD0)$POD0$RST]"
    set_chc_params true --alter_sync=2 --allow_drop_detached=1;

    [[ "$action" =~ ^'ATTACH'|'DROP'|'REPLACE'$ ]] || {
        log_error "Passed argument #2 should be one of 'ADD','DROP' or 'REPLACE', got: '$action'"
        return 1
    }
    local cond_reason=''; (($# == 5)) && cond_reason="AND reason='$reason'" || :

    while true; do
        local tmp=$(mktmp)
        (
            local total partition_ids
            total=$(kube_chc_query "SELECT count(DISTINCT partition_id) FROM system.detached_parts WHERE (database='$db' AND table='$table') $cond_reason")

            if [ -z "$total" ]; then
                log_error "Error retrieving number of detached parts from ClickHouse $POD0"
                return 1
            fi

            log_info "$marker Found $total detached partitions in table $quoted_qualified_table."
            if [ "$total" == '0' ]; then return 0; fi

            local last_batch="" batch_repeat=0 # avoid dead loop
            while true; do
                partition_ids=$(kube_chc_query "SELECT DISTINCT partition_id FROM system.detached_parts WHERE (database='$db' AND table='$table') AND isNotNull(partition_id) $cond_reason ORDER BY partition_id LIMIT $batch_size")

                [ $? == 0 ] || return 1
                [ -z "$partition_ids" ] && {
                    log_info "$marker Done with table $quoted_qualified_table.";
                    break
                }

                local count=$(echo "$partition_ids" | wc -l)
                local commands_template=$(echo "$partition_ids" | sed -e "s|^|__PLACEHOLDER__ PARTITION ID '|g; s|$|'|g" | tr '\n' ',' | sed -e 's|,$||');

                if [ "$action" == ATTACH ]; then
                    local commands_attach=${commands_template//__PLACEHOLDER__/ATTACH}
                    # This is needed because ATTACH PARTITION leaves some inactive parts which may cause errors in future steps.
                    local commands_drop_detached=${commands_template//__PLACEHOLDER__/DROP DETACHED}
                    kube_chc_query "
                        ALTER TABLE $quoted_qualified_table $commands_attach;
                        ALTER TABLE $quoted_qualified_table $commands_drop_detached" -n --echo
                elif [ "$action" == DROP ]; then
                    local commands_drop_detached=${commands_template//__PLACEHOLDER__/DROP DETACHED}
                    kube_chc_query "ALTER TABLE $quoted_qualified_table $commands_drop_detached" --echo
                else # if REPLACE
                    local commands_drop=${commands_template//__PLACEHOLDER__/DROP}
                    local commands_attach=${commands_template//__PLACEHOLDER__/ATTACH}
                    local commands_drop_detached=${commands_template//__PLACEHOLDER__/DROP DETACHED}
                    kube_chc_query "
                        ALTER TABLE $quoted_qualified_table $commands_drop;
                        ALTER TABLE $quoted_qualified_table $commands_attach;
                        ALTER TABLE $quoted_qualified_table $commands_drop_detached;" -n --echo
                fi > >(log_prefix "$marker") # for messages from '--echo'

                if [ "$RESTORE_BEST_EFFORT" == true ]; then continue; fi

                if [[ " ${UNRETRYABLE_EXCEPTION_CODES[*]} " =~ " $EXCEPTION_CODE " ]]; then
                    log_error "$marker Exception code $EXCEPTION_CODE is not retryable. Will not continue."
                    return 1
                fi

                # if the same partition batch repeated
                if [[ "$last_batch" == "$partition_ids" ]]; then
                    (( ++batch_repeat >= 3 + count )) && {
                        log_error "$marker Max repeat times for dropping same batch of partitions reached for table $quoted_qualified_table. Will not continue."
                        return 1
                    }
                    sleep $((batch_repeat * 1))
                else
                    batch_repeat=0
                fi
                last_batch=$partition_ids
            done
        ) 2> >(tee $tmp >&2)
        local ret=$?;
        if [ $ret == 0 ]; then return 0; fi
        # Retry on "i/o timeout" error
        tmp=$(cat $tmp; rm -f $tmp)
        if [[ "$tmp" =~ "Error from server: error dialing backend: dial tcp ".*" i/o timeout" ]]; then
            log_info "Retrying on i/o timeout error"
            continue
        fi
        return $ret
    done
)}

function attach_or_drop_detached_partitions_for_tables()
{
    local pod=$1 action=$2 db=$3 tables=$4 reason=$5 jobs=${JOBS:-1}
    (($# == 5)) && reason="'$reason'" || :
    local repr_export_patch=$(bash_export_patch)
    array_transpose $tables | xargs -P$jobs -I{} bash -c ": attach_or_drop_detached; $repr_export_patch; attach_or_drop_detached_partitions $pod $action $db {} $reason; [ \$? == 0 ] || exit 255"
}

function get_physical_tables_list()
{
    local condition="database='$DB' ${TABLES:+AND table IN ( $(csv_quoted $TABLES) )}"
    kube_chc_query "SELECT DISTINCT table FROM system.tables WHERE $condition AND engine LIKE '%MergeTree'" --format TSVRaw
}

function freeze_partitions()
{(
    set -e
    if [[ -n "$FREEZE_PARTITIONS_WITH_NAME" ]]; then
        local backup_name=$FREEZE_PARTITIONS_WITH_NAME
        for table in $(get_physical_tables_list); do
            LOG_PREFIX=true kube_chc_query_all "
                ALTER TABLE \`$DB\`.\`$table\` UNFREEZE WITH NAME '$backup_name';
                ALTER TABLE \`$DB\`.\`$table\` FREEZE WITH NAME '$backup_name';
            " -n --echo
        done
        log_info "Backup '$backup_name' created."
    fi
)}

function unfreeze_partitions()
{(
    set -e
    if [[ -n "$FREEZE_PARTITIONS_WITH_NAME" && "$UNFREEZE_PARTITIONS" == true ]]; then
        local backup_name=$FREEZE_PARTITIONS_WITH_NAME
        for table in $(get_physical_tables_list); do
            LOG_PREFIX=true kube_chc_query_all "ALTER TABLE \`$DB\`.\`$table\` UNFREEZE WITH NAME '$backup_name';" --echo
        done
        log_info "Backup '$backup_name' released."
    fi
)}

# On worker nodes
function restore_access_worker()
{
    check_variables_defined RSYNC_STATS_FILE BASE_DIR DEFAULT_DIR || return 1
    lock_stats_100 || return 1

    if [ ! -d "$BASE_DIR" ]; then
        log_error "Directory '$BASE_DIR' does not exist."
        return 1
    fi
    cd $BASE_DIR

    for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
        LOG_LEVEL=WARN check_required_subdirectories $BASE_DIR/$dir access || continue;
        (
            cd $BASE_DIR/$dir
            local names=''
            for f in quotas.list roles.list row_policies.list settings_profiles.list users.list; do
                [ -f "access/$f" ] || names+="${names:+ }$f";
            done
            if [ -n "$names" ]; then
                log_warn "Skipped directory '$BASE_DIR/$dir' that does not contain necessary access entity list files $(csv_quoted $names)"
                exit # subshell
            fi
            rsync -aR --partial --inplace --delete --force access $DEFAULT_DIR
            log_info "Replaced all access entities with that from directory '$BASE_DIR/$dir/access'"
        )
        break
    done
}

# Checks that all tables from $SOURCE_DIR exist in target $DEFAULT_DIR
# Also populates 'link2rpath', mapping from symbolic link in $SOURCE_DIR to relative path in target $DEFAULT_DIR
# Requires: DEFAULT_DIR (of target instance)
function get_map_of_link_2_target_rpath()
{
    check_variables_defined DEFAULT_DIR || return 1
    var_defined link2rpath || { log_error "Variable $link2rpath undefined."; return 1; }

    # local -n link2rpath_ref=$1 # incompatible with bash <4.3

    while read link rpath; do
        IFS=/ read _ p2 p3 <<<"$link"
        read db table <<<"$(unescape_filename $p2 $p3)"
        hint="";
        if [ "data/$db/$table" != "$link" ]; then
            hint=" (for table \`$db\`.\`$table\`)"
        fi

        # Translate database and table names
        local link_mapped=$link
        if [[ -n "${MAP2NEWDB_ESCAPED[$p2]}" || -n "${MAP2NEWTABLE_ESCAPED[$p3]}" ]]; then
            local p2_mapped=$p2 p3_mapped=$p3
            [ -z "${MAP2NEWDB_ESCAPED[$p2]}" ] || p2_mapped=${MAP2NEWDB_ESCAPED[$p2]}
            [ -z "${MAP2NEWTABLE_ESCAPED[$p3]}" ] || p3_mapped=${MAP2NEWTABLE_ESCAPED[$p3]}
            link_mapped="data/$p2_mapped/$p3_mapped"
            if [ -n "$hint" ]; then
                read db_mapped table_mapped <<<"$(unescape_filename $p2_mapped $p3_mapped)"
                hint=" (for table \`$db\`.\`$table\` from '$BASE_DIR', mapped to \`$db_mapped\`.\`$table_mapped\`)"
            fi
            log_debug "Source link '$link' mapped to '$link_mapped'."
        fi

        if [ $DATABASE_ENGINE == 'Atomic' ]; then # Don't use $(database_engine)
            if ! [ -L $DEFAULT_DIR/$link_mapped ]; then
                log_error "Symbolic link file '$link_mapped'$hint does not exist in target directory '$DEFAULT_DIR'."
                return 1
            fi
        else
            if ! [ -d $DEFAULT_DIR/$link_mapped ]; then
                log_error "Data directory '$link_mapped'$hint does not exist in target directory '$DEFAULT_DIR'."
                return 1
            fi
        fi

        link2rpath[$link_mapped]=$(cd $DEFAULT_DIR; readlink_as_rpath $link_mapped);
        if [ -z "${link2rpath[$link_mapped]}" ]; then
            log_error "Relative path '${link2rpath[$link_mapped]} ($link_mapped)'$hint does not exist in target directory '$DEFAULT_DIR'."
            return 1
        fi
    done < <(DEFAULT_DIR=. DISK_DIR=. enumerate_table_directories)
}

# Requires: link2rpath, DISK_DIR
function enumerate_detached_directories()
{
    var_defined link2rpath || { log_error "Variable $link2rpath undefined."; return 1; }
    for target_rpath in ${link2rpath[@]}; do
        local dir="$DISK_DIR/${target_rpath%/}/detached"
        if [ -d "$dir" ]; then echo $dir; fi
    done
}

function restore_worker()
{(
    set -e
    check_variables_defined RSYNC_STATS_FILE SOURCE_DIR DEFAULT_DIR DISK_DIR || return 1
    # Lock to avoid any concurrent restore commands.
    lock_stats_100 || return 1

    check_required_subdirectories $SOURCE_DIR .
    check_required_subdirectories $DEFAULT_DIR data metadata
    check_required_subdirectories $DISK_DIR store

    local restore_command=${RESTORE_COMMAND:-'mv'}

    if [ "$restore_command" == 'mv' ]; then
        restore_command='mv --backup=numbered -f'
        log_info "Will 'mv' data parts from directory '$SOURCE_DIR' to detached directory of corresponding tables in '$DISK_DIR'."
    else
        restore_command='rsync -a --partial --inplace --delete --force'
        log_info "Will 'rsync' data parts from directory '$SOURCE_DIR' to detached directory of corresponding tables in '$DISK_DIR'."
    fi
    cd $SOURCE_DIR

    local jobs=${JOBS:-1} batch_size=${RESTORE_BATCH_SIZE:-50}

    local -A link2rpath
    get_map_of_link_2_target_rpath

    log_debug "$(declare -p link2rpath)"

    local awk_vars="
        $(bash_map_variable_to_awk_repr link2rpath)
        $(bash_map_variable_to_awk_repr MAP2NEWDB_ESCAPED)
        $(bash_map_variable_to_awk_repr MAP2NEWTABLE_ESCAPED)"

    local awk_script='
            BEGIN { '"$awk_vars"' }
            {
                link=$1; path=$3;
                split(link, f, "/")
                db=f[2]; table=f[3]

                if (MAP2NEWDB_ESCAPED[db] || MAP2NEWTABLE_ESCAPED[table])
                {
                    if (MAP2NEWDB_ESCAPED[db]) db=MAP2NEWDB_ESCAPED[db]
                    if (MAP2NEWTABLE_ESCAPED[table]) table=MAP2NEWTABLE_ESCAPED[table]
                }
                link="data/" db "/" table
                print DISK_DIR "/" link2rpath[link] "detached/", path
            }
        '
    if [[ ${#MAP2NEWDB_ESCAPED[@]} == 0 && ${#MAP2NEWTABLE_ESCAPED[@]} == 0 ]]; then
        awk_script='
            BEGIN { '"$awk_vars"' }
            {
                link=$1; path=$3;
                print DISK_DIR "/" link2rpath[link] "detached/", path
            }
        '
    fi

    if [ "$CLEAR_EXISTING_DETACHED" == true ]; then
        log_info "Removing existing detached data parts."
        enumerate_detached_directories \
        | xargs -I{} find {} -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/$REGEX_PART_NAME$" \
        | $XARGS -P$jobs -I{} command rm -rf {}
    fi

    # Move or copy data parts to detached/
    DEFAULT_DIR=. DISK_DIR=. enumerate_parts \
    | awk -v DISK_DIR=$DISK_DIR "$awk_script" \
    | awk -v batch_size=$batch_size -v ARG_MAX=$(getconf ARG_MAX) '
        # Input:    Output:
        #   T1 S1     S1 S2 T1
        #   T1 S2     S3 S4 T2
        #   T2 S3     S5    T3
        #   T2 S4
        #   T3 S5
        BEGIN { ARG_MAX = ARG_MAX>1024*1024+1024 ? 1024*1024+1024 : ARG_MAX; }
        {
            buf[NR % batch_size] = $0
            count++; len+=length($0);
            if (count>=batch_size || len>=ARG_MAX-1024)
            {
                process_batch()
                delete buf; count=0; len=0
            }
        }
        END { if (count > 0) process_batch() }

        function process_batch()
        {
            asort(buf)
            split(buf[1],f,FS); key=f[1]; run=f[2]
            for (i = 2; i <= count; i++)
            {
                split(buf[i],f,FS); cur_key=f[1]
                if (key == cur_key)
                    run=run " " f[2]
                else
                {
                    print compose(key, run)
                    key=cur_key; run=f[2]
                }
            }
            if (length(run) > 0)
                print compose(key, run)
        }
        function compose(key, run)
        {
            return run " " key
        }
    ' \
    | $XARGS -P$jobs -I_ sh -c "command $restore_command _ || exit 255"

    local a_part=$(
        enumerate_detached_directories \
        | while read -r dir; do find $dir -ignore_readdir_race -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex ".*/$REGEX_PART_NAME$"; done \
        | head -1
    )
    [ -n "$a_part" ] || { log_info "No data part was restored from '$SOURCE_DIR'."; return 0; }

    # Do chown if needed
    local expected_uid_gid='' actual_uid_gid=''
    if [ -n "$RESTORE_UID_GID" ]; then
        expected_uid_gid=$RESTORE_UID_GID
    else
        expected_uid_gid=$(stat -c "%u:%g" $DEFAULT_DIR/data)
        actual_uid_gid=$(stat -c "%u:%g" $a_part)
        [ -n "$expected_uid_gid" ] || { log_error "Error retrieving file permisson of '$DEFAULT_DIR/data'."; return 1; }
        [ -n "$actual_uid_gid" ] || { log_error "Error retrieving file permisson of restored data parts in detached."; return 1; }
    fi

    if [ "$actual_uid_gid" == "$expected_uid_gid" ]; then expected_uid_gid=''; fi

    local repr_export_patch=$(bash_export_patch)
    enumerate_detached_directories | xargs -P$jobs -I{} bash -c ": launder_data_parts; $repr_export_patch; launder_data_parts {} $expected_uid_gid"
)}

function format_readable_time_delta_compact()
{
    local sec=$1 zero_padding=$2
    awk -v sec=$sec -v zero_padding=$zero_padding '
        BEGIN {
            f = zero_padding ? "%02d%s" : "%d%s"
            d = int(sec / 86400); r = sec % 86400;
            h = int(r / 3600); r %= 3600; m = int(r / 60); s = r % 60
            s=sprintf("%s%s%s%s", component(d,"d"), component(h,"h"), component(m,"m"), component(s,"s"))
            print s ? s : "0s"
        }
        function component(v,u){ return v>0 ? sprintf(f, v, u) : "" }
    ' | sed -r 's|^(([0-9]+[dhms]){2}).*$|\1|' # preserve 2 parts for readability
}

function report_worker()
{(
    set -e
    check_variables_defined RSYNC_STATS_FILE POD
    [ -f $RSYNC_STATS_FILE ] || {
        log_warn "Statistics file does not exist: '$RSYNC_STATS_FILE'."
        return 1
    }
    read -r total sent inflight timestamp_start <<<"$(
        # shellcheck disable=SC2094
        {
            if ! flock -w 60 -x 10; then
                log_error "Timeout aquiring lock on file $RSYNC_STATS_FILE"
                return 1
            fi
            source $RSYNC_STATS_FILE
            # concat numbers from the array with '+', and evaluate the resulting expression
            inflight=$(( $(IFS='+'; echo "${INFLIGHT[*]}") ))
            echo $TOTAL $SENT $inflight $TIMESTAMP_START
        } 10< $RSYNC_STATS_FILE
    )"
    if [[ -z "$total" || "$total" == '0' ]]; then
        echo -e "$POD\t 0\t 0\t 0 (still summing)\t        N/A\t N/A"
    elif [ "$total" == '0.' ]; then
        echo -e "$POD\t 0\t 0\t 0 (no data)\t  100.00000\t N/A"
    else
        summing_hint=''; [ "${total: -1}" == '.' ] || summing_hint='.'
        completion_hint=''; [ "${sent: -1}" != '.' ] || completion_hint='.'
    
        total=${total%.}; sent=${sent%.};
        progress=$(awk "BEGIN {printf \"%10.5lf\", ($sent+$inflight)*100/$total}")

        function grouped() { numfmt --from=none --to=none --format="%'f" $1; }
        function iec() { numfmt --from=none --to=iec $1; }

        total_grouped=$(grouped $total); sent_grouped=$(grouped $sent); inflight_grouped=$(grouped $inflight)
        total_readable=$(iec $total); sent_readable=$(iec $sent); inflight_readable=$(iec $inflight)

        eta_readable='N/A' elapsed=$(( $(timestamp) - timestamp_start ))
        [ -n "$completion_hint" ] || eta_readable=$(
            if [[ $progress =~ ^[0\.\ ]+$ ]]; then echo INF; exit; fi
            eta_sec=$(awk "BEGIN {print int($elapsed / $progress * (100 - $progress))}")
            format_readable_time_delta_compact $eta_sec true
        )

        [ -z "$summing_hint" ] || total_readable="$total_readable, still summing"
        [ -z "$completion_hint" ] || sent_readable="$sent_readable, done"
        echo -e "$POD\t $inflight_grouped ($inflight_readable)\t $sent_grouped ($sent_readable)\t $total_grouped ($total_readable)\t $progress\t $eta_readable"
    fi
)}

# DDL query should be formated first
function ddl_replace_zk_path()
{
    local zookeeper=$1 new_path=$2;
    sed -r "s|^(ENGINE = Replicated.*MergeTree)\('([^']*)'|\1('${zookeeper:+$zookeeper:}$new_path'|";
}

function enumerate_create_database_queries()
{
    enumerate_database_directories | while read -r db; do
        [ -z "${MAP2NEWDB_ESCAPED[$db]}" ] || db=${MAP2NEWDB_ESCAPED[$db]};
        # We don't care about actual database engine. Atomic is the best
        echo "CREATE DATABASE IF NOT EXISTS \`$(unescape_filename $db)\` ON CLUSTER '{cluster}';"
    done
}

function collect_create_queries_worker()
{
    check_variables_defined BASE_DIR || return 1

    if [ ! -d "$BASE_DIR" ]; then
        log_error "Directory '$BASE_DIR' does not exist."
        return 1
    fi

    # log_info "Enumerating CREATE queries in $BASE_DIR" # No stdout
    cd $BASE_DIR;

    if [ "$RESTORE_DDL" == true ]; then
        local zookeepers=(''); [ -z "$ZOOKEEPERS" ] || zookeepers=( $ZOOKEEPERS )
        local n_zookeepers=${#zookeepers[@]} zookeeper_idx=0

        echo "--- BEGIN VARIABLE TABLES"
        for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
            LOG_LEVEL=WARN check_required_subdirectories $BASE_DIR/$dir metadata || continue;
            (
                cd $dir
                enumerate_create_database_queries
                enumerate_table_directories | while read -r link _; do
                    IFS=/ read _ p2 p3 <<<"$link"
                    metadata_path="$(readlink_as_rpath metadata/$p2)/$p3.sql"
                    [ -z "${MAP2NEWDB_ESCAPED[$p2]}" ] || p2=${MAP2NEWDB_ESCAPED[$p2]};
                    [ -z "${MAP2NEWTABLE_ESCAPED[$p3]}" ] || p3=${MAP2NEWTABLE_ESCAPED[$p3]};
                    db=$(unescape_filename $p2) table=$(unescape_filename $p3)

                    local uuid=$(uuidgen) zookeeper=${zookeepers[$((zookeeper_idx++ % n_zookeepers))]}

                    sed -r "1{s|^.+\$|CREATE TABLE IF NOT EXISTS \`$db\`.\`$table\` UUID '$uuid' ON CLUSTER '{cluster}'|}; \${s|\$|;|}" "$metadata_path" \
                    | ddl_replace_zk_path "$zookeeper" "/clickhouse/tables/{shard}/{database}/{table}/${RESTORE_REPLICA_PATH_ID:-$uuid}"
                done
            )
            break
        done
        echo "--- END VARIABLE TABLES"
    fi

    if [ "$RESTORE_DICTIONARIES" == true ]; then
        echo "--- BEGIN VARIABLE DICTIONARIES"
        for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
            LOG_LEVEL=WARN check_required_subdirectories $BASE_DIR/$dir metadata || continue;
            (
                cd $dir
                enumerate_create_database_queries
                enumerate_database_directories | while read -r db_escaped; do
                    local db=$(unescape_filename $db_escaped)
                    [ -z "${MAP2NEWDB_ESCAPED[$db]}" ] || db=${MAP2NEWDB_ESCAPED[$db]};
                    metadata_rpath=$(readlink_as_rpath metadata/$db_escaped)
                    for file in $(grep -l '^CREATE DICTIONARY' -r $metadata_rpath/); do
                        local name=$(unescape_filename $(basename ${file%.sql}))
                        sed -r "1{s|^.+\$|CREATE OR REPLACE DICTIONARY \`$db\`.\`$name\` ON CLUSTER '{cluster}'|}; \${s|\$|;|}" $file
                    done
                done
            )
            break
        done
        echo "--- END VARIABLE DICTIONARIES"
    fi

    if [ "$RESTORE_FUNCTIONS" == true ]; then
        echo "--- BEGIN VARIABLE FUNCTIONS"
        for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
            LOG_LEVEL=WARN check_required_subdirectories $BASE_DIR/$dir user_defined || continue;
            (
                cd $dir
                find user_defined -maxdepth 1 -mindepth 1 -type f -name "*.sql" \
                | xargs -I{} sed -r "s|CREATE FUNCTION ([^ ]+) (.+)\$|CREATE OR REPLACE FUNCTION \1 ON CLUSTER '{cluster}' \2|; \${s|\$|;|}" {}
            )
            break
        done
        echo "--- END VARIABLE FUNCTIONS"
    fi

    if [ "$RESTORE_VIEWS" == true ]; then
        echo "--- BEGIN VARIABLE VIEWS"
        for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
            LOG_LEVEL=WARN check_required_subdirectories $BASE_DIR/$dir metadata || continue;
            (
                cd $dir
                enumerate_create_database_queries
                enumerate_database_directories | while read -r db_escaped; do
                    local db=$(unescape_filename $db_escaped)
                    [ -z "${MAP2NEWDB_ESCAPED[$db]}" ] || db=${MAP2NEWDB_ESCAPED[$db]};
                    metadata_rpath=$(readlink_as_rpath metadata/$db_escaped)
                    for file in $(grep -Pl '^ATTACH (MATERIALIZED )?VIEW' -r $metadata_rpath/); do
                        local name=$(unescape_filename $(basename ${file%.sql}))
                        sed -r "
                            1{
                                s|^ATTACH VIEW .+\$|CREATE OR REPLACE VIEW \`$db\`.\`$name\` ON CLUSTER '{cluster}'|;
                                s|^ATTACH MATERIALIZED VIEW .+\$|DROP VIEW IF EXISTS \`$db\`.\`$name\` ON CLUSTER '{cluster}';\nCREATE VIEW \`$db\`.\`$name\` ON CLUSTER '{cluster}'|;
                            };
                            \${s|\$|;|}
                        " $file
                    done
                done
            )
            break
        done
        echo "--- END VARIABLE VIEWS"
    fi
}

# Remove data parts in $1/ that are empty, containing zero sized metadata files (corrupted), or backups from 'mv --backup=numbered'.
# Do chown if given $2=<UID>:<GID>.
function launder_data_parts()
{(
    set -eo pipefail
    local dir=$1 uid_gid=$2
    check_variables_defined dir
    check_required_subdirectories $dir .

    log_info "Laundering data parts in '$dir'."

    find $dir -maxdepth 1 -mindepth 1 -type d -empty \
    | while read -r part_path; do
        (set -x; rm -r $part_path) 2> >(with_suffix " # it's empty." >&2)
    done

    find $dir -regextype posix-extended -maxdepth 2 -mindepth 2 -type f -size 0 -regex '.*/(columns.txt|count.txt|primary.idx)' -printf '%f %h\n' \
    | sort -k2 | uniq -f1 \
    | while read -r file part_path; do
        (set -x; rm -rf $part_path) 2> >(with_suffix " # for zero sized file '$file'." >&2)
    done

    find $dir -regextype posix-extended -maxdepth 1 -mindepth 1 -type d -regex '.*/.*\.~[0-9]+~' \
    | $XARGS -I{} command rm -rf {}

    if [ -n "$uid_gid" ]; then
        (set -x; chown --preserve-root -R $uid_gid $dir)
    fi
)}


# Enumerate detached/ directories in target instance of all tables found in $BASE_DIR, and apply launder_data_parts()
function launder_detached_for_base_worker()
{
    set -eo pipefail
    check_variables_defined RSYNC_STATS_FILE BASE_DIR DEFAULT_DIR DISK_DIR

    check_required_subdirectories $BASE_DIR .
    check_required_subdirectories $DEFAULT_DIR metadata
    check_required_subdirectories $DISK_DIR store

    # Lock to avoid concurrent launder_detached_for_base commands.
    lock_stats_100

    cd $BASE_DIR;

    local uid_gid
    uid_gid=$(stat -c "%u:%g" $DEFAULT_DIR/metadata)

    local repr_export_patch=$(bash_export_patch)

    for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
        local subdirectories_to_check='metadata data'
        if [ $(cd $dir; database_engine) == 'Atomic' ]; then subdirectories_to_check='metadata data store'; fi

        LOG_LEVEL=INFO check_required_subdirectories $dir $subdirectories_to_check || continue;
        (
            cd $dir
            local -A link2rpath=()
            get_map_of_link_2_target_rpath
            enumerate_detached_directories
        )
    done | sort -u \
    | xargs -P${JOBS:-1} -I{} bash -c ": launder_data_parts; $repr_export_patch; launder_data_parts {} $uid_gid; [ \$? == 0 ] || exit 255"
}

# Data parts restore procedure executed on master node
function restore_node()
{(
    set -e
    trap_kill_group
    local pod=$1 node=$2 result=$3
    local marker="$RST$(get_color $pod)$pod($node)$RST"

    local directories=$(echo "$result" | awk '{print $1}' | sort -u)
    local db=$(echo "$result" | awk '{print $2}' | sort -u)
    local tables=$(echo "$result" | awk '{print $3}' | sort -u)

    if [ -z "$tables" ]; then log_warn "$marker No tables to restore from '$BASE_DIR'"; return 0; fi

    log_info "$marker Found $(plural "$directories" subdirectory subdirectories) in '$BASE_DIR'."

    # If there're more than 1 subdirectory in $BASE_DIR, and user specified '--replace', we have to drop the existing partitions in table.
    if [ $(wc -l <<<"$directories") -gt 1 ] && [ "$RESTORE_REPLACE" == true ]; then
        log_error "$marker Cannot perform replace partition because there're data parts from more than 1 subdirectory. Maybe '--map-database', '--map-table' or '--drop' meets your need."
        return 1
    fi

    set_chc_params true --send_logs_level=error
    declare -gx RESTORE_BEST_EFFORT

    local clear_existing_detached=false

    # Make first loop iteration to cope with the existing detached parts.
    [ "$WITH_EXISTING_DETACHED_PARTS" == 'ignore' ] || directories="~~WITH_EXISTING_DETACHED~~ $directories"

    for dir in $directories; do
        if [ "$dir" == '~~WITH_EXISTING_DETACHED~~' ]; then
            # Existing detached parts may have incorrect permission set, which causes error if we are to attach them.
            if [ "$WITH_EXISTING_DETACHED_PARTS" == 'attach' ]; then
                call_remote_worker $node launder_detached_for_base "$(
                    declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
                    declare -g DATABASE_ENGINE=${POD2DATABASE_ENGINE[$pod]};
                    declare -g DEFAULT_DIR=${PODDISK2HOSTPATH[$pod-default]} DISK_DIR=${PODDISK2HOSTPATH[$pod-$CHOSEN_DISK]};
                    variables_declaration ${common_variables[@]}
                )"
            fi
        else
            log_info "$marker Restoring data parts from subdirectory '$dir'"

            call_remote_worker $node restore "$(
                declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
                declare -g DATABASE_ENGINE=${POD2DATABASE_ENGINE[$pod]};
                declare -g SOURCE_DIR=$BASE_DIR/$dir;
                declare -g DEFAULT_DIR=${PODDISK2HOSTPATH[$pod-default]} DISK_DIR=${PODDISK2HOSTPATH[$pod-$CHOSEN_DISK]};
                declare -g CLEAR_EXISTING_DETACHED=$clear_existing_detached
                variables_declaration ${common_variables[@]} SOURCE_DIR TARGET_DIR RESTORE_COMMAND CLEAR_EXISTING_DETACHED
            )"
            clear_existing_detached=false
        fi

        while true; do
            tables_to_do=$(POD0=$pod kube_chc_query "SELECT DISTINCT table FROM system.detached_parts WHERE database='$db' AND table IN ($(csv_quoted $tables))")
            [ $? == 0 ] || {
                log_warn "$marker Some error occured on retrieving name of tables containing detached data parts. Will retry."
                sleep 3
                continue
            }
            if [ "$dir" == '~~WITH_EXISTING_DETACHED~~' ]; then
                if [ -n "$tables_to_do" ]; then
                    log_info "$marker Found existing detached parts in $(plural "$tables_to_do" table tables) $(csv_quoted $tables_to_do)."
                
                    if [ "$WITH_EXISTING_DETACHED_PARTS" == 'clear' ]; then
                        clear_existing_detached=true
                    elif [ "$WITH_EXISTING_DETACHED_PARTS" == 'attach' ]; then
                        attach_or_drop_detached_partitions_for_tables $pod ATTACH $db "$tables_to_do";
                    else
                        log_error "$marker Please re-run script and specify how to deal with them with option '--clear-detached' or '--attach-detached'."
                        return 1
                    fi
                fi
                break # break to continue outer loop
            else
                [ -n "$tables_to_do" ] || {
                    log_info "$marker Done with subdirectory '$dir'."
                    break
                }
                if [ "$RESTORE_REPLACE" == true ]; then
                    attach_or_drop_detached_partitions_for_tables $pod REPLACE $db "$tables_to_do";
                else
                    attach_or_drop_detached_partitions_for_tables $pod ATTACH $db "$tables_to_do";
                fi
            fi 2> >(tee >(
                [ "$RESTORE_BEST_EFFORT" == true ] || {
                    # for i in $(seq 1 10); do echo -- $i; sleep 0.5; done > >(tee >(echo 123)) # This makes bash v4.2 exit abnormally
                    # for i in $(seq 1 10); do echo -- $i; sleep 0.5; done > >(tee >(cat >/dev/null; echo 123))
                    cat > /dev/null; exit 0;
                }

                declare marker="$RST$(get_color $pod)[$pod]$RST"

                declare regex_detach_reason_prefixes="broken_|unexpected_|noquorum_|ignored_|broken-on-start_|clone_|attaching_|deleting_|tmp-fetch_|covered-by-broken_|merge-not-byte-identical_|mutate-not-byte-identica_|inactive_"
                # declare regex_error_part_relative_path="store/[a-f0-9]+/[a-f0-9-]+/detached/($regex_detach_reason_prefixes)*$REGEX_PART_NAME"
                declare regex_error_part_relative_path="(store|data)/[^/ ]+/[^/ ]+/detached/($regex_detach_reason_prefixes)*$REGEX_PART_NAME"
                declare regex_error_part_full_path="/[^ ]+/$regex_error_part_relative_path"

                while read -r l; do
                    [[ "$l" =~ '<Error>' ]] || continue
                    ec=$(grep_exception_code_no_anchor <<<"$l")

                    if [ -n "$ec" ]; then
                        if [[ "$l" =~ $regex_error_part_full_path ]]; then
                            local path=${BASH_REMATCH[0]}; path=${path/deleting_/}; path=${path/attaching_/}
                            log_info "Noticed error part with full path '$path'."
                            echo "set -x; rm -rf $path " | $KUBECTL exec -i $pod -- bash
                            continue
                        fi

                        ec_name=${EXCEPTION_CODE_NAMES[$ec]}
                        if [[ $ec =~ ^$CHEC_EXPECTED_END_OF_FILE|$CHEC_BAD_SIZE_OF_FILE_IN_DATA_PART|$CHEC_FILE_DOESNT_EXIST|$CHEC_NO_FILE_IN_DATA_PART|$CHEC_NO_SUCH_COLUMN_IN_TABLE$ ]]; then
                            # Checksum mismatch, file missing, permission error
                            read db table part <<<$(sed -nr "s|^.*?[^0-9a-z]($REGEX_PART_NAME).+in query: ALTER TABLE \`?([^ \`]+)\`?\.\`?([^ \`]+)\`? .+$|\2 \3 \1|gp" <<<"$l")
                            if [ -n "$part" ]; then
                                log_info "Noticed error part '$part' from table $db.$table."
                                db=$(escape_filename $db) table=$(escape_filename $table)
                                echo "$(declare -f with_suffix; variables_declaration db table part DISK2PATH ec_name);" '
                                    function remove() {( set -x; rm "$@"; )}
                                    for path in ${DISK2PATH[@]}; do
                                        target=$path/data/$db/$table/detached/$part
                                        if [ -d $target ]; then
                                            remove -rf $target 2> >(with_suffix " # for exception $ec_name" >&2)
                                        fi
                                    done
                                ' | $KUBECTL exec -i $pod -- bash
                            fi
                        elif [[ $ec =~ ^$CHEC_LOGICAL_ERROR$ ]]; then
                            # Parts intersection errors
                            # "Part {} intersects previous part {}. It is a bug!",
                            # "Part {} intersects previous part {}. "
                            # "Part {} intersects next part {}. It is a bug!",
                            # "Part {} intersects part {}. It is a bug or a result of manual intervention "
                            read db table part1 part2 <<<$(
                                sed -nr "s|^.+Part ($REGEX_PART_NAME) intersects.* part ($REGEX_PART_NAME).+in query: ALTER TABLE \`?([^ \`]+)\`?\.\`?([^ \`]+)\`? .+$|\3 \4 \1 \2|gp" <<<"$l"
                            )
                            if [ -n "$part2" ]; then
                                log_info "Noticed parts intersecting error between '$part1' and '$part2'."
                                db=$(escape_filename $db) table=$(escape_filename $table)
                                # Compare number of rows, and delete the part with less rows
                                echo "$(declare -f with_suffix; variables_declaration db table part1 part2 DISK2PATH);" '
                                    function remove() {( set -x; rm "$@"; )}
                                    function count_in_part()
                                    {
                                        local -n part=$1 count=$2 part_path=$3
                                        for path in ${DISK2PATH[@]}; do
                                            part_path=$path/data/$db/$table/detached/$part
                                            if [ -d $part_path ]; then
                                                count=$(cat $part_path/count.txt 2>/dev/null)
                                                return
                                            fi
                                        done
                                        part_path=''
                                    }
                                    count_in_part part1 count1 path1
                                    count_in_part part2 count2 path2
                                    [ -z "$path1" ] || { ((count1 > 0)) || { remove -rf $path1 2> >(with_suffix " # it is empty" >&2); exit 0; } }
                                    [ -z "$path2" ] || { ((count2 > 0)) || { remove -rf $path2 2> >(with_suffix " # it is empty" >&2); exit 0; } }
                                    [[ -n "$path1" && -n "$path2" ]] || {
                                        echo "One of the intersecting parts does not exist: '\''$path1'\'','\''$path2'\''." >&2
                                        exit 0;
                                    }
                                    if ((count1 < count2)); then
                                        remove -rf $path1 2> >(with_suffix " # it has fewer rows ($count1) than the other part $part2($count2)" >&2)
                                    else
                                        remove -rf $path2 2> >(with_suffix " # it has equal or fewer rows ($count2) than the other part $part1($count1)" >&2)
                                    fi
                                ' | $KUBECTL exec -i $pod -- bash
                            fi
                        else
                            log_warn "Cannot handle exception code $ec."
                        fi
                    fi
                done 2> >(log_error_prefix "$marker")
            ) | grep -Pv 'in (/usr/bin/clickhouse|\?)$' >&2) # error handling done
        done # attached data parts from $dir
    done # for dir in $directories
)}

# Enumerate (subdirectory name, database name, table name) from $BASE_DIR
function gather_directories_and_table_names_in_base_worker()
{
    check_variables_defined BASE_DIR || return 1

    check_required_subdirectories $BASE_DIR . || return 1

    # log_info "Enumerating table names in $BASE_DIR" # No stdout
    cd $BASE_DIR;

    for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
        local subdirectories_to_check='metadata data'
        if [ $(cd $dir; database_engine) == 'Atomic' ]; then subdirectories_to_check='metadata data store'; fi

        LOG_LEVEL=INFO check_required_subdirectories $dir $subdirectories_to_check || continue;
        (
            cd $dir
            enumerate_table_directories | while read -r link _; do
                IFS=/ read _ p2 p3 <<<"$link"
                [ -z "${MAP2NEWDB_ESCAPED[$p2]}" ] || p2=${MAP2NEWDB_ESCAPED[$p2]};
                [ -z "${MAP2NEWTABLE_ESCAPED[$p3]}" ] || p3=${MAP2NEWTABLE_ESCAPED[$p3]};
                echo "$dir $(unescape_filename $p2) $(unescape_filename $p3)"
            done
        )
    done
}

# On master node
# TODO reschedule on error
function p2p()
{
    local local_pods=( ${PODS[@]} )
    local remote_hosts=() given_remote_hosts=( $REMOTE_HOSTS )
    local N M

    while true; do
        remote_hosts+=(${given_remote_hosts[@]})
        N=${#local_pods[@]} M=${#remote_hosts[@]}
        (( N - M < ${#given_remote_hosts[@]} )) && break || :;
    done
    # special case where N < M
    if ((N < M)) && [ "$REDISTRIBUTE" == true ]; then
        # The branching should have been done by caller. But it's much cleaner if written here.
        log_info "Number of local pods is less than number of remote hosts. Nothing to do in 'p2p' mode given REDISTRIBUTE=true."
        return 0
    fi
    if [ "$REDISTRIBUTE" != true ] && ((N > M)); then
        # Not redistributing data, just pair extra local nodes with remote hosts in round-robin manner
        remote_hosts+=(${given_remote_hosts[@]})
        M=${#remote_hosts[@]}
    fi

    # Print peering result
    local peering_result=$(
        local i=0
        for pod in ${local_pods[@]}; do
            ((i < M)) || break;
            is_pod_chosen $pod || { ((++i)); continue; }
            echo "  $pod --> ${remote_hosts[$((i++))]}"
        done
    )
    log_info "Peering:$RST\n$peering_result"

    local pids='' names=''
    local i=0
    for pod in ${local_pods[@]}; do
        ((i < M)) || break;

        is_pod_chosen $pod || { ((++i)); continue; }

        local node=${POD2NODE[$pod]} remote_host=${remote_hosts[$((i++))]}

        call_remote_worker $node p2p "$(
            declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
            declare -g DATABASE_ENGINE=${POD2DATABASE_ENGINE[$pod]};
            declare -g DEFAULT_DIR=${PODDISK2HOSTPATH[$pod-default]};
            declare -g DISK_DIR=${PODDISK2HOSTPATH[$pod-$CHOSEN_DISK]}${FREEZE_PARTITIONS_WITH_NAME:+"/shadow/$FREEZE_PARTITIONS_WITH_NAME"};
            declare -g PARTITION_IDS=${POD2PARTITIONIDS[$pod]};
            declare -g REMOTE_HOSTS=$remote_host REMOTE_DIR=$REMOTE_DIR/$pod;
            variables_declaration ${common_variables[@]} RSYNC_STRICT
        )" &
        pids+=" $!"; names+=" p2p-wiring-$node"
    done
    wait_pids_patiently 5 "$pids" "$names"
}

# On master node
function spread()
{
    if [ "$REDISTRIBUTE" != true ]; then log_info "Not redistributing data parts."; return 0; fi

    local local_pods=( ${PODS[@]} )
    local remote_hosts=( $REMOTE_HOSTS )

    local N=${#local_pods[@]} M=${#remote_hosts[@]}

    local R=$(( N % M ))
    local remainder_pods=(${local_pods[@]: -R})

    if (( R == 0 )); then
        log_info "No remainder local nodes to spread data from.";
        return 0;
    fi

    # Print peering result
    local peering_result=$(
        for pod in ${remainder_pods[@]}; do
            is_pod_chosen $pod || continue
            echo "  $pod --> ${REMOTE_HOSTS// /,}"
        done
    )
    log_info "Redistributing:$RST\n$peering_result"

    local pids='' names=''
    for pod in ${remainder_pods[@]}; do
        is_pod_chosen $pod || continue

        local node=${POD2NODE[$pod]}

        call_remote_worker $node spread "$(
            declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
            declare -g DATABASE_ENGINE=${POD2DATABASE_ENGINE[$pod]};
            declare -g DEFAULT_DIR=${PODDISK2HOSTPATH[$pod-default]};
            declare -g DISK_DIR=${PODDISK2HOSTPATH[$pod-${CHOSEN_DISK:-default}]}${FREEZE_PARTITIONS_WITH_NAME:+"/shadow/$FREEZE_PARTITIONS_WITH_NAME"};
            declare -g PARTITION_IDS=${POD2PARTITIONIDS[$pod]};
            declare -g REMOTE_DIR=$REMOTE_DIR/$pod;
            variables_declaration ${common_variables[@]} RSYNC_STRICT
        )" &
        pids+=" $!"; names+=" spread-wiring-$node"
    done
    wait_pids_patiently 5 "$pids" "$names"
}

# On master node
function send()
{(
    set -e;
    get_clickhouse_pods
    detect_clickhouse_credentials
    get_database_engine_of_pods
    get_disks_and_hostpaths

    if [ "$PATCH_RC" == true ]; then patch_bashrc_for_all_hosts; fi

    if [ "$SKIP_CHECKS" != true ]; then
        are_clickhouse_servers_ready;

        local engines
        engines=$(distinct_engines_of_database $DB)
        [ -n "$engines" ] || {
            log_error "Database '$DB' does not exist. Will not proceed."
            return 1;
        }
        [[ "$engines" =~ ('Atomic'|'Ordinary'|',') ]] || {
            log_error "Database '$DB' is not of Atomic or Ordinary engine. Will not proceed."
            return 1;
        }

        if (( ${#CHOSEN_PODS[@]} > 1 )); then
            check_consistency_of_objects_on_cluster
        fi
    fi

    if [ -n "$PARTITION_CONDITION" ]; then
        query_matching_partition_ids;
    elif [ -n "$PARTITION_IDS" ]; then
        for pod in ${PODS[@]}; do POD2PARTITIONIDS[$pod]=$PARTITION_IDS; done
    fi

    trap_kill_group

    create_remote_dir

    freeze_partitions

    p2p
    spread

    log_info "All data parts sent."

    unfreeze_partitions
)}

# On master node
function restore()
{(
    set -e
    if ! command -v uuidgen >/dev/null; then log_error "Command 'uuidgen' not found."; exit 1; fi

    if [[ "$RESTORE_DATA" == false && "$RESTORE_DDL" != true && "$RESTORE_ACCESS" != true \
        && "$RESTORE_FUNCTIONS" != true && "$RESTORE_DICTIONARIES" != true && "$RESTORE_VIEWS" != true ]]; then
        log_error "Nothing to restore."
        return 1
    fi

    local db=$DB; [ -z "${MAP2NEWDB[$db]}" ] || db=${MAP2NEWDB[$db]};

    get_clickhouse_pods
    detect_clickhouse_credentials
    get_disks_and_hostpaths

    if [ "$PATCH_RC" == true ]; then patch_bashrc_for_all_hosts; fi

    if [ "$SKIP_CHECKS" != true ]; then
        are_clickhouse_servers_ready

        local engines
        engines=$(distinct_engines_of_database "$db")
        [[ -z "$engines" || "$engines" =~ ('Atomic'|'Ordinary'|',') ]] || {
            log_error "Database '$db' is not of Atomic or Ordinary engine. Will not proceed."
            return 1;
        }
    fi

    trap_kill_group

    log_info "Gathering subdirectories and table names from base directory '$BASE_DIR'."
    local files='' nodes=''
    for pod in ${CHOSEN_PODS[@]}; do
        local node=${POD2NODE[$pod]}
        if [[ " $nodes " =~ " $node " ]]; then continue; fi
        nodes+=" $node"
    
        call_remote_worker $node gather_directories_and_table_names_in_base "$(
            declare -g POD=$pod; variables_declaration ${common_variables[@]}
        )" > $TMPDIR/gathered_tables.$node || : &

        files+=" $TMPDIR/gathered_tables.$node"
        pids+=" $!"; names+=" gather-tables-wiring-$node"
    done
    wait_pids_patiently 5 "$pids" "$names"

    local result=$(cat $files)
    local directories=$(echo "$result" | awk '{print $1}' | sort -u)
    local db=$(echo "$result" | awk '{print $2}' | sort -u) # should be only one database
    local tables=$(echo "$result" | awk '{print $3}' | sort -u)

    if [ -z "$tables" ]; then log_warn "No tables to restore from '$BASE_DIR' for any nodes."; return 0; fi

    log_debug "Found $(plural "$directories" subdirectory subdirectories) in '$BASE_DIR' in total: $(csv_quoted $directories)."

    [ "$SKIP_CHECKS" == true ] || check_busy_distributed_ddl_queue

    # Drop existing tables that are to be restored
    if [ -n "$RESTORE_DROP_OR_TRUNCATE" ]; then
        log_info "Will try to $RESTORE_DROP_OR_TRUNCATE tables directly and create the flag file 'force_drop_table' when needed to."
        local tables_to_do drop_tables_commands
        tables_to_do=$(kube_chc_query "SELECT DISTINCT table FROM clusterAllReplicas('{cluster}',system.tables) WHERE database='$db' and table IN ($(csv_quoted $tables))")
        for table in $tables_to_do; do
            drop_tables_commands[$table]="${RESTORE_DROP_OR_TRUNCATE^^} TABLE IF EXISTS \`$db\`.\`$table\` ON CLUSTER '{cluster}' SYNC;"
        done
        kube_chc_query "${drop_tables_commands[*]}" -n --echo --ignore-error || :;

        if [ "$RESTORE_DROP_OR_TRUNCATE" == 'drop' ]; then
            tables_to_do=$(kube_chc_query "SELECT DISTINCT table FROM clusterAllReplicas('{cluster}',system.tables) WHERE database='$db' and table IN ($(csv_quoted $tables))")
        else
            tables_to_do=$(kube_chc_query "SELECT DISTINCT table FROM clusterAllReplicas('{cluster}',system.tables) WHERE total_rows>0 AND database='$db' and table IN ($(csv_quoted $tables))")
        fi
        for table in $tables_to_do; do
            array_transpose ${PODS[@]} | xargs -P$(nproc) -IPOD $KUBECTL exec POD -- touch /var/lib/clickhouse/flags/force_drop_table
            kube_chc_query "${drop_tables_commands[$table]}" --echo;
        done
        array_transpose ${PODS[@]} | xargs -P$(nproc) -IPOD $KUBECTL exec POD -- rm -f /var/lib/clickhouse/flags/force_drop_table
        
        if [ "$RESTORE_DROP_OR_TRUNCATE" == 'drop' ]; then RESTORE_DDL=true; fi
        RESTORE_REPLACE=false;
    fi

    if [[ "$RESTORE_DDL" == true || "$RESTORE_FUNCTIONS" == true || "$RESTORE_DICTIONARIES" == true || "$RESTORE_VIEWS" == true ]]; then
        (
            set -e
            tmp=$(mktmp); rm_on_exit -f $tmp

            local nodes=''
            for pod in ${CHOSEN_PODS[@]}; do
                local node=${POD2NODE[$pod]}
                [[ " $nodes " =~ " $node " ]] && continue || :
                nodes+=" $node"

                log_info "Collecting CREATE TABLE|VIEW|FUNCTION|DICTIONARY queries from host $node."

                call_remote_worker $node collect_create_queries "$(
                    variables_declaration ${common_variables[@]} RESTORE_REPLICA_PATH_ID RESTORE_DDL RESTORE_FUNCTIONS RESTORE_DICTIONARIES RESTORE_VIEWS
                )" > $tmp || :

                # Found the first node that contains CREATE queries
                if [ -n "$(grep -v '^--- ' $tmp)" ]; then log_info "Got some CREATE queries from $node:$BASE_DIR"; break; fi
            done

            if [ -z "$(grep -v '^--- ' $tmp)" ]; then
                log_error "Did not find any CREATE queries in directory '$BASE_DIR' on all remote hosts.";
                return 1;
            fi
            # Mind the order of types of objects
            for type in 'DICTIONARIES' 'FUNCTIONS' 'VIEWS' 'TABLES'; do
                local queries=$(read_variable "$type" $tmp)
                [ -n "$queries" ] || continue
                kube_chc_query "$queries" -n --echo
                log_info "Done creating ${type,,}."
            done
        )
        [ $? == 0 ] || return 1;
    fi
    # Databases should exist on cluster after DDL restore.
    get_database_engine_of_pods $db

    if [ "$RESTORE_ACCESS" == true ]; then
        (
            set -e
            local pids='' names=''
            for pod in ${PODS[@]}; do
                is_pod_chosen $pod || continue;
                local node=${POD2NODE[$pod]}

                log_info "Will restore access entities for $pod running on $node."

                call_remote_worker $node restore_access "$(
                    declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
                    declare -g DEFAULT_DIR=${PODDISK2HOSTPATH[$pod-default]};
                    variables_declaration ${common_variables[@]}
                )" &
                pids+=" $!"; names+=" restore-access-wiring-$node"
            done
            wait_pids_patiently 5 "$pids" "$names"

            kube_chc_query "SYSTEM RELOAD USERS ON CLUSTER '{cluster}'" --echo
            log_info "Done restoring access entities."
        )
        [ $? == 0 ] || return 1;
    fi

    log_info "Checking that all tables to restore exist on cluster."
    local existing_tables
    existing_tables=$(kube_chc_query "
        WITH
            ( SELECT count() FROM system.clusters WHERE cluster = getMacro('cluster') ) AS count_hosts,
            count() AS count
        SELECT table
        FROM clusterAllReplicas('{cluster}', system.tables)
        WHERE database='$db' AND table IN ($(csv_quoted $tables))
        GROUP BY table
        HAVING count == count_hosts
        ORDER BY table
    " | sort)
    # variables_declaration existing_tables tables
    if [ "$(echo $existing_tables)" != "$(echo $tables)" ]; then
        local not_existing_tables=$(array_transpose $tables $existing_tables | sort | uniq -u)
        if [ "$RESTORE_DDL" == true ]; then
            log_error "Unexpected error: $(plural "$not_existing_tables" table tables) still not exist after CREATE: $(csv_quoted $not_existing_tables)"
        else
            log_error "$(plural "$not_existing_tables" 'required table does' 'required tables do') not exist: $(csv_quoted $not_existing_tables)"
        fi
        return 1
    fi

    # Restore data parts for each node
    if [ "${RESTORE_DATA:-true}" == true ]; then
        if (( ${#NODE2POD[@]} < ${#POD2NODE[@]} )); then
            log_warn "Number of nodes is less than number of ClickHouse server PODs. Some of the PODs may not get restored with data parts."
        fi

        if [ "${RESTORE_COMMAND:-mv}" == 'mv' ]; then
            log_info "Checking that 'mv' command does not copy data."
            local pids='' names=''
            for pod in ${CHOSEN_PODS[@]}; do
                local node=${POD2NODE[$pod]}
                (
                    set +e
                    declare source_dir=$BASE_DIR target_dir=${PODDISK2HOSTPATH[$pod-$CHOSEN_DISK]}
                    echo "$(variables_declaration source_dir target_dir)"'
                        function same_fs() { [ "$(stat -c %d "$1")" = "$(stat -c %d "$2")" ]; }
                        same_fs "${source_dir}" "${target_dir}"
                    ' | remote_bash $node
                    [ $? == 0 ] || {
                        log_info "File moving between '$source_dir' and '$target_dir' requires data copying on host '$node'."
                        exit 1
                    }
                ) &
                pids+=" $!"; names+=" restore-check-mv-$node"
            done
            wait_pids_patiently 1 "$pids" "$names" || {
                log_warn "File moving between source directories and target directories requires data copying. Please consider '--command rsync'."
            }
            unset pids names
        fi

        local pids='' names=''
        local -A node2pod=()

        for pod in ${CHOSEN_PODS[@]}; do
            local node=${POD2NODE[$pod]}

            if [[ " ${!node2pod[*]} " =~ " $node " ]]; then
                log_warn "Node $node is already taken by POD ${node2pod[$node]}. Will not restore data parts for $pod"
                continue
            fi
            node2pod[$node]=$pod

            restore_node $pod $node "$(cat $TMPDIR/gathered_tables.$node)" &
            pids+=" $!"; names+=" restore-wiring-$node"
        done
        wait_pids_patiently 5 "$pids" "$names"
        log_info "All data parts restored."
    fi

    [ "$SKIP_CHECKS" == true ] || check_consistency_of_objects_on_cluster $db

    log_info "Done."

    trap_restore_kill_group
)}

function report()
{(
    set -e;
    trap_kill_group

    get_clickhouse_pods;
    if [ "$PATCH_RC" == true ]; then patch_bashrc_for_all_hosts; fi

    local wd="$TMPDIR/reports"
    mkdir -p $wd; rm_on_exit -rf $wd

    local files=''
    for pod in ${CHOSEN_PODS[@]}; do
        local node=${POD2NODE[$pod]}

        call_remote_worker $node report "$(
            declare -g POD=$pod RSYNC_STATS_FILE=$TMPDIR/stats.$pod;
            variables_declaration ${common_variables[@]}
        )" > "$wd/$pod" || : &
        pids+=" $!"; names+=" report-wiring-$node"
        files+=" $wd/$pod"
    done
    wait_pids_patiently 2 "$pids" "$names"

    {
        echo -e "Pod\t Inflight\t Sent\t Total\t Progress %\t ETA"
        echo -e "───\t ────────\t ────\t ─────\t ──────────\t ───"
        cat $files
    } | mktable | sed -r "s,(\([^\)]+\)|N/A),$FAINT\1$NC,g"

    trap_restore_kill_group
)}

function relay()
{(
    set -e;
    trap_kill_group
    check_variables_defined BASE_DIR REMOTE_HOSTS

    if [ ! -d "$BASE_DIR" ]; then
        log_error "Directory '$BASE_DIR' does not exist."
        return 1
    fi

    log_info "Sending data from local directory '$BASE_DIR' to remote $(plural "$REMOTE_HOSTS" host hosts): ${REMOTE_HOSTS// /,}"
    cd $BASE_DIR;
    
    local remote_hosts=() given_remote_hosts=( $REMOTE_HOSTS )
    local subdirectories=($(
        for dir in $(find . -maxdepth 1 -mindepth 1 -type d -printf '%P\n'); do
            LOG_LEVEL=WARN check_required_subdirectories $dir metadata data store || continue;
            echo $dir
        done
    ))
    local N M

    local DO_P2P=true DO_SPREAD=true

    while true; do
        remote_hosts+=(${given_remote_hosts[@]})
        N=${#subdirectories[@]} M=${#remote_hosts[@]}
        (( N - M < ${#given_remote_hosts[@]} )) && break || :;
    done
    if ((N < M)) && [ "$REDISTRIBUTE" == true ]; then
        log_info "Number of subdirectories is less than number of remote hosts. Nothing to do in 'p2p' mode given REDISTRIBUTE=true."
        DO_P2P=false
    fi
    if ((N == M)); then
        log_info "Excess subdirectories are paired with remote hosts in round-robin order without remainders, no subdirectories to spread data from.";
        DO_SPREAD=false
    fi
    if [ "$REDISTRIBUTE" != true ] && ((N > M)); then
        remote_hosts+=(${given_remote_hosts[@]})
        M=${#remote_hosts[@]}
    fi

    local i=0
    if [ $DO_P2P == true ]; then
        for dir in ${subdirectories[@]:0:M}; do
            local remote_host=${remote_hosts[$((i++))]}
            (
                cd $dir
                declare -g RSYNC_STATS_FILE="$TMPDIR/stats.$dir" # subdirectories are named the same as PODs
                declare -g SOURCE_DIR=$BASE_DIR/$dir
                declare -g REMOTE_HOSTS=$remote_host

                # Though "$RSYNC_STATS_FILE.lock" is the lock file used on source hosts, locking it here still makes some sense
                if [ -f "$RSYNC_STATS_FILE.lock" ] && ! flock -xn "$RSYNC_STATS_FILE.lock" true; then
                    log_warn "Skipped subdirectory '$dir'."
                    exit 0
                fi
                send_worker
            )
        done
    fi
    if [ $DO_SPREAD == true ]; then
        local R=$((N % M))
        for dir in ${subdirectories[@]: -R}; do
            (
                cd $dir
                declare -g RSYNC_STATS_FILE="$TMPDIR/stats.$dir"
                declare -g SOURCE_DIR=$BASE_DIR/$dir

                if [ -f "$RSYNC_STATS_FILE.lock" ] && ! flock -xn "$RSYNC_STATS_FILE.lock" true; then
                    log_warn "Skipped subdirectory '$dir'."
                    exit 0
                fi
                send_worker
            )
        done
    fi

    trap_restore_kill_group
)}


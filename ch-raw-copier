# On worker nodes
function worker()
{
    redefine_logger_for_host
    init_tmpdir
    local pid
    exit_when_orphaned & pid=$!

    if [ -n "$IO_BANDWIDTH" ]; then
        create_and_enter_cgroup "${CGROUP_NAME}" $IO_BANDWIDTH || return
    fi

    if ! func_defined ${WORKER_MODE}_worker; then
        log_error "Unknown worker mode '$WORKER_MODE'"
        return 1
    fi

    local ret=0
    ${WORKER_MODE}_worker 2> >(log_error_prefix); ret=$?

    kill $pid
    # sleep 0.1 # wait asynchronous stdout/stderr flush
    return $ret
}

# Remote bash function call. Name it 'RBFC standard' :)
if [ -n "$WORKER_MODE" ]; then
    worker
    exit $?
fi


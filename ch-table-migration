function s_PreMovePartitions()
{
    declare -gA \
        STATE_MovePartitions_POD_SCRIPTS=() \
        STATE_MovePartitions_SCRIPTS_COMPLETED=()

    local concurrency=${STATE_MovePartitions_CONCURRENCY:-'1'}
    local -u direction=${STATE_MovePartitions_DIRECTION:-'ASC'}

    if (( concurrency <= 0 )); then
        log_state_error "Variable 'STATE_MovePartitions_CONCURRENCY' should be a positive integer, got $STATE_MovePartitions_CONCURRENCY";
        pause false; return 2;
    fi
    if ! [[ "$direction" =~ ^('ASC'|'DESC')$ ]]; then
        log_state_error "Variable 'STATE_MovePartitions_DIRECTION' should be 'ASC' or 'DESC', got '$STATE_MovePartitions_DIRECTION'";
        pause false; return 2;
    fi

    RELOAD=true;
    (
        set -e;
        r_PreMovePartitions;

        local query="
            SELECT concat('ALTER TABLE \`$DATABASE\`.\`$LOCAL_TABLE_DT\` MOVE PARTITION ID \'',partition_id,'\' TO TABLE \`$DATABASE\`.\`$LOCAL_TABLE\`; -- Partition ', partition)
            FROM (
                SELECT database,table,partition,partition_id
                FROM system.parts
                WHERE active AND (database = '$DATABASE') AND (table = '$LOCAL_TABLE_DT')
                GROUP BY database,table,partition,partition_id
                ORDER BY database ASC,table ASC,partition $direction
            )
            FORMAT TSVRaw"

        local -a server_pods=( $(get_replicated_server_pods) )

        local pids='';
        trap_kill_group;
        for pod in ${server_pods[@]}; do
            kube_ch $pod clickhouse-client "$query" "${CHC_FLAGS[@]}" > $DIR/move.$pod.sql &
            pids+=" $!"
        done
        for pid in $pids; do wait $pid; done
        trap_restore_kill_group;

        log_state_info "Wrote files '$RELATIVE_DIR/move.*.sql'"

        for pod in ${server_pods[@]}; do
            local f="$DIR/move.$pod.sql"
            if [ $concurrency != 1 ]; then
                if ! [ -f "$f" ]; then log_state_warn "File disappeared: '$f'."; return 1; fi
                # Split file: $f --> $f.splitted.01, $f.splitted.02 ...
                (cd $DIR; awk -v prefix=$f -v concurrency=$concurrency '{ file=sprintf("%s.splitted.%02d.sql", prefix, NR % concurrency + 1); print > file }' $f)
                STATE_MovePartitions_POD_SCRIPTS[$pod]=$(ls $f.splitted.*.sql | tr '\n' ' ')
            else
                STATE_MovePartitions_POD_SCRIPTS[$pod]=$f
            fi
        done
        log_state_debug "Gathered task files: ${STATE_MovePartitions_POD_SCRIPTS[*]}";
        store '' '' ''; # Commit variable STATE_MovePartitions_POD_SCRIPTS
    )
}


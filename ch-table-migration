function check_busy_replicated_event()
{(
    set -e;
    local table=${1:?} event=${2:?} threshold=${3:?};

    if [ "$ENGINE_REPLICATED" == false ]; then return 0; fi

    log_state_info "Checking if there are busy replicated $event on table \`$DATABASE\`.\`$table\`"
    local count
    count=$(kube_chc_query "SELECT count() FROM clusterAllReplicas('$CLUSTER',system.replication_queue) WHERE database='$DATABASE' AND table='$table' AND type='$event'");
    (( count <= threshold ));
)}

function check_busy_replicated_fetches() { check_busy_replicated_event ${1:-$LOCAL_TABLE_CHAMELEON} 'GET_PART' ${STATE_WaitBusyReplicatedFetches_THRESHOLD:-0}; }

function check_busy_replicated_merges() { check_busy_replicated_event ${1:-$LOCAL_TABLE_CHAMELEON} 'MERGE_PARTS' ${STATE_WaitBusyReplicatedMerges_THRESHOLD:-0}; }

function check_busy_merges()
{(
    set -e;
    local threshold=${STATE_WaitBusyMerges_THRESHOLD:-0};

    log_state_info "Checking if there are busy merges on table \`$DATABASE\`.\`$LOCAL_TABLE_DT\`"

    local count
    count=$(kube_chc_query "SELECT count() FROM clusterAllReplicas('$CLUSTER',system.merges) WHERE database='$DATABASE' AND table='$LOCAL_TABLE_DT'");
    (( count <= threshold ));
)}

function r_WaitBusyMerges() { return 0; }

function check_parts_stable()
{
    local table=${1:?};
    RELOAD=true;
(
    set -e;
    check_busy_merges;
    check_busy_replicated_fetches $table;
    check_busy_replicated_merges $table;
    if ((STATE_WaitPartsStable_INTERVAL == 0)); then return 0; fi

    local threshold=${STATE_WaitPartsStable_STABLE_THRESHOLD:-1};
    local interval=$STATE_WaitPartsStable_INTERVAL;

    log_state_info "Checking if number of parts has stabilized in table \`$DATABASE\`.\`$table\`."

    local ret=0 number_of_parts
    number_of_parts=$(kube_chc_query "SELECT count() FROM clusterAllReplicas('$CLUSTER',system.parts) WHERE active AND database='$DATABASE' AND table='$table'")

    if ((STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS == 0)); then # First time
        STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS=$number_of_parts;
        ret=1;
    else
        if ((STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS - number_of_parts >= threshold)) \
            || ((number_of_parts - STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS >= threshold)); then # Still increasing ?
            log_state_info "Sleeping for $interval seconds..."
            STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS=$number_of_parts;
            ret=1;
        else
            STATE_WaitPartsStable_LAST_NUMBER_OF_PARTS=0;
            log_state_info "Yes, it's stable."
        fi
    fi
    store '' '' '';
    sleep $interval
    return $ret;
)}


function dir_is_root()
{
    local dir=${1:-$DIR} ret=0
    if [ -f "$dir" ]; then # regular file
        ret=1;
    elif [ -d "$dir" ]; then # directory
        [ $(realpath "$dir") == '/' ]; ret=$?
    else
        [ $(realpath -m "$dir") == '/' ]; ret=$?
    fi
    return $ret;
}


function r_RedirectDistributedView()
{(
    set -e;
    s_WaitOnBusyDistributedDDLQueue 0;
    kube_chc_query "$DDL_ON_CLUSTER_DISTRIBUTED" --echo;
)}

function normalize_ddl_for_comparison()
{
    local ddl=$1
    local include_settings=${STATE_SwapTables_COMPARE_DDL_INCLUDING_SETTINGS:-'false'}
    local ignored_regex=${STATE_SwapTables_COMPARE_DDL_IGNORING_REGEX:-'`_invert_flag`'}
    # Remove table name and zookeeper path. maybe also remove the SETTINGS ?
    local sed_remove_settings=''; [ $include_settings != true ] && sed_remove_settings='/^SETTINGS .+/d'
    local sed_remove_ignored_regex=''; [ -n "$ignored_regex" ] && sed_remove_ignored_regex="/$ignored_regex/d"
    echo "$ddl" | sed "1d; $sed_remove_ignored_regex; $sed_remove_settings"
}

function local_table_has_new_structure()
{
    # Check if structure of $LOCAL_TABLE is same as $DDL_ON_CLUSTER_CHAMELEON.
    local ddl_local_table
    ddl_local_table=$(show_create_table $LOCAL_TABLE)
    ddl_normalized_local_table=$(normalize_ddl_for_comparison "$ddl_local_table")
    ddl_normalized_templated_local_table=$(normalize_ddl_for_comparison "$DDL_ON_CLUSTER_CHAMELEON")

    [ "$ddl_normalized_local_table" == "$ddl_normalized_templated_local_table" ];
}

function s_SwapTables()
{(
    set -e;
    s_WaitOnBusyDistributedDDLQueue 0;
    kube_chc_query "EXCHANGE TABLES \`$DATABASE\`.\`$LOCAL_TABLE\` AND \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` ON CLUSTER '$CLUSTER'" --echo;
)}

function r_SwapTables()
{(
    set -e;
    s_WaitOnBusyDistributedDDLQueue 0; # Wait until all servers become consistent.
    # Had they actually exchanged ?
    if local_table_has_new_structure; then
        local res
        res=$(kube_chc_query "
            SELECT count
            FROM (
                SELECT 1 AS i, count() AS count FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE')
                UNION ALL
                SELECT 2 AS i, count() AS count FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_CHAMELEON')
            )
            ORDER BY i ASC
        ")
        local count_local=$(index_line 1 "$res") count_local_chameleon=$(index_line 2 "$res")

        log_state_debug "Total rows of table \`$DATABASE\`.\`$LOCAL_TABLE\`: $count_local, \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`: $count_local_chameleon"

        if (( count_local > 0 && count_local >= count_local_chameleon )); then
            log_state_warn "Table \`$DATABASE\`.\`$LOCAL_TABLE\` has new structure, but the data amount is larger than that of \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`. This is suspicious, please have a check before resuming the task."
            pause false;
            return 1;
        fi
        log_state_info "Table \`$DATABASE\`.\`$LOCAL_TABLE\` has new structure. Will exchange tables \`$DATABASE\`.\`$LOCAL_TABLE\` and \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`"
        kube_chc_query "EXCHANGE TABLES \`$DATABASE\`.\`$LOCAL_TABLE\` AND \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` ON CLUSTER '$CLUSTER'" --echo;
    else
        log_state_info "Table \`$DATABASE\`.\`$LOCAL_TABLE\` does not have new structure. No thing to revert."
    fi

    # Some new data may have been inserted into the new table (Now it's named $LOCAL_TABLE_CHAMELEON because we reverted)
    res=$(kube_chc_query "SELECT count() FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_CHAMELEON')")

    if (( res >= 1 )); then
        log_state_info "Some data has been inserted into the new table \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`, migrating it back to the old table \`$DATABASE\`.\`$LOCAL_TABLE\`."
        s_CheckTablesNotReadOnly $LOCAL_TABLE;

        local dst_table="\`$DATABASE\`.\`$LOCAL_TABLE\`" src_table="\`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`"
        local datetime_column=$STATE_MigrateData_DATETIME_COLUMN interval=${STATE_MigrateData_TIMESLOT_INTERVAL:-'4 HOUR'}

        local -a server_pods=( $(get_replicated_server_pods) )

        trap_kill_group;

        local pids='';
        for pod in ${server_pods[@]}; do
            ./for_each_line2.sh --log-level $LOG_LEVEL \
                --file "$DIR/revert.dt.$pod.sql" --pod $pod \
                --chc "${CHC_FLAGS[*]}" \
                --templated-generator gen insert_select_with_columns_by_timeslot \
                "dst_table=$dst_table,src_table=$src_table,datetime_column=$datetime_column,interval=$interval,direction=DESC" &
            pids+=" $!"
        done
        for pid in $pids; do wait $pid; done

        trap_restore_kill_group;
        rm -rf $DIR/revert.dt.*.sql $DIR/revert.dt.*.sql.state

        kube_chc_query "TRUNCATE TABLE \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` ON CLUSTER '$CLUSTER'" --echo;
    fi
)}


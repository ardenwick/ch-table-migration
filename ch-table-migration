function get_previous_state()
{
    local cur=${1:-$STATE} res='Initialize'

    for i in ${!states[@]}; do
        if [ ${states[i]} == "$cur" ]; then res=${states[i-1]}; break; fi
    done
    echo "$res"
}

function get_next_state()
{
    local cur=${1:-$STATE} res='Initialize'
    [ "$cur" == 'Complete' ] && { echo 'Complete'; return; }

    for i in ${!states[@]}; do
        if [ ${states[i]} == "$cur" ]; then res=${states[i+1]}; break; fi
    done
    echo "$res"
}

function expand_macro()
{(
    set -e;
    local macro_name=$1;
    local macro_value=$macro_name;
    if [[ "$macro_name" =~ '{' ]]; then
        macro_name=$(echo "$macro_name" | tr -d '{}')
        macro_value=$(kube_chc_query "SELECT getMacro('$macro_name')")
        if [ -z "$macro_value" ]; then return 1; fi
    fi
    echo "$macro_value"
)}

function show_create_table() { kube_chc_query "SHOW CREATE TABLE \`$DATABASE\`.\`$1\` FORMAT TSVRaw"; }

function table_exists_on_cluster()
{(
    set -e;
    local table=$1 all=${2:-true};

    local expr="count_hosts == count()"; [ "$all" != true ] && expr="count() > 0" || :;

    kube_chc_query "
        WITH ( SELECT count() FROM system.clusters WHERE cluster='$EXPANDED_CLUSTER' ) AS count_hosts
        SELECT $expr
        FROM clusterAllReplicas('$CLUSTER', system.tables)
        WHERE database='$DATABASE' AND table='$table'
    "
)}

## Functions for States

# Check configuration and initialize some internal variables
function s_Initialize()
{
    if ! [ -f "$DIR/config" ]; then log_state_error "Configuration file does not exist: '$RELATIVE_DIR/config'"; return 1; fi

    declare -gA STATES_START_TIME=(['Initialize']=$(timestamp))
    # declare -g CLUSTER='{cluster}' # ON CLUSTER '?'
    # declare -g DATABASE='business'
    # declare -g LOCAL_TABLE='tcp_log_local'
    # declare -g DISTRIBUTED_TABLE='tcp_log'
    declare -g DISTRIBUTED_TABLE_SHARDING_KEY='rand()'
    # declare -g NEW_DDL_REFERENCE='tcp_log_new.sql'
    declare -g ENGINE_REPLICATED=false
    declare -g ENGINE_DEDUPLICATING=false

    source $DIR/config

    set_chc_params false --receive_timeout=36000 --lock_acquire_timeout=36000 --distributed_ddl_task_timeout=36000;
    set_chc_params true --history_file=/tmp/.clickhouse-history "--log_comment=table-migration-task-${TASK_NAME}"

    # Check configuration complete
    local config_complete=true
    for var in ${config_required_state_variables[@]}; do
        if [ "${!var}" == "" ]; then
            log_state_error "Variable '$var' is not defined in config '$RELATIVE_DIR/config', please define it and resume the task."
            config_complete=false
        fi
    done
    if [ $config_complete == false ]; then pause false; return 1; fi

    if [ -z "$EXPANDED_CLUSTER" ]; then
        if ! EXPANDED_CLUSTER=$(expand_macro $CLUSTER); then
            log_state_error "Error retrieving value of macro '$CLUSTER', please revise the config and resume the task."
            pause false; return 1
        fi
    fi

    s_CheckDatabaseAtomic || return 1

    # Wrap $STATE_MigrateData_DATETIME_COLUMN with toDateTime()
    local datetime_column_type
    datetime_column_type=$(kube_chc_query "SELECT type FROM system.columns WHERE database='$DATABASE' AND table='$LOCAL_TABLE' AND name='$STATE_MigrateData_DATETIME_COLUMN'")
    if [ -z "$datetime_column_type" ]; then
        log_state_error "Not found column '$STATE_MigrateData_DATETIME_COLUMN' in table \`$DATABASE\`.\`$LOCAL_TABLE\`, please revise the config and resume the task."
        pause false; return 1
    fi
    if [[ $datetime_column_type =~ 'Int' ]]; then
        STATE_MigrateData_DATETIME_COLUMN="toDateTime($STATE_MigrateData_DATETIME_COLUMN)"
        log_state_debug "Set STATE_MigrateData_DATETIME_COLUMN=$STATE_MigrateData_DATETIME_COLUMN"
    fi

    # Assign table names and UUIDs
    LOCAL_TABLE_CHAMELEON="${LOCAL_TABLE}__CHAMELEON"
    LOCAL_TABLE_DT="${LOCAL_TABLE}__DT"
    LOCAL_TABLE_MERGED="${LOCAL_TABLE}__MERGED"

    UUID_CHAMELEON=$(uuidgen); UUID_DT=$(uuidgen)

    # Check successful assignment of variables
    local variables_complete=true
    for var in LOCAL_TABLE_CHAMELEON LOCAL_TABLE_DT LOCAL_TABLE_MERGED UUID_CHAMELEON UUID_DT; do
        if [ "${!var}" == "" ]; then
            log_state_error "Variable '$var' is not assigned successfully"
            variables_complete=false
        fi
    done
    if [ $variables_complete == false ]; then return 1; fi # Retry it

    assign_ddl_queries || return 1

    # Check tables exist
    if ! kube_chc_query_all "SELECT 1" >/dev/null; then
        log_state_error "Cannot connect to ClickHouse server."
        pause false; return 1;
    fi

    local pids="" tmp_exists_1=$(mktmp) tmp_exists_2=$(mktmp) tmp_exists_3=$(mktmp)
    (table_exists_on_cluster $LOCAL_TABLE true > $tmp_exists_1) & pids+=" $!"
    (table_exists_on_cluster $LOCAL_TABLE_CHAMELEON false > $tmp_exists_2) & pids+=" $!"
    (table_exists_on_cluster $DISTRIBUTED_TABLE true > $tmp_exists_3) & pids+=" $!"

    wait_pids_patiently 5 "$pids" "$LOCAL_TABLE-exists $LOCAL_TABLE_CHAMELEON-exists $DISTRIBUTED_TABLE-exists" || {
        log_error "Error while checking existence of tables: $LOCAL_TABLE, $LOCAL_TABLE_CHAMELEON, $DISTRIBUTED_TABLE".
        return 1
    }
    if [ "$(cat $tmp_exists_1; rm -f $tmp_exists_1)" == '0' ]; then
        log_state_error "Table \`$DATABASE\`.\`$LOCAL_TABLE\` does not exist, please revise the config before resuming the task."
        pause false; return 1;
    fi
    if [ "$(cat $tmp_exists_2; rm -f $tmp_exists_2)" == '1' ]; then
        log_state_error "Table \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` already exists, please have a check before resuming the task."
        pause false; return 1;
    fi
    if [ "$(cat $tmp_exists_3; rm -f $tmp_exists_3)" == '0' ]; then
        log_state_error "Table \`$DATABASE\`.\`$DISTRIBUTED_TABLE\` does not exist, please revise the config before resuming the task."
        pause false; return 1;
    fi

    s_CheckDataVisibility || return 1;

    if [ -z "$PROCEDURE" ]; then
        s_Rearrange || return 1;
    elif [ ${#states[@]} -eq 0 ]; then
        switch_procedure $PROCEDURE;
    fi

    # Warning on migrating non-classic MergeTree tables
    if [[ "$ENGINE_DEDUPLICATING" == true && "$PROCEDURE" != 'lazy' && "$PROCEDURE" != 'simplest' ]]; then
        log_warn "Table '$LOCAL_TABLE' uses a non-classic MergeTree. It is highly likely that data was deduplicated during migration, making it difficult to determine whether it is consistent with the original table. We recommend: 1) Run \`rearrange $RELATIVE_DIR lazy\` to switch to the lazy procedure, which avoids data migration; 2) Run query \"OPTIMIZE TABLE \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` FINAL\" on ClickHouse servers (at your own risk) before resuming the task."
        pause false;
    fi

    truncate --no-create --size=0 $DIR/last_error

    declare -gA STATES_FINISH_TIME=(['Initialize']=$(timestamp))
}

function r_Initialize()
{
    REVERT=''; # Stop reverting here
    store '' false false; # No pause
    log_state_info "Reverted to initial state. Please resume to re-run the task if needed."
    exit 0;
}

function switch_procedure()
{
    if ! [[ " ${procedures[*]} " =~ " $1 " ]]; then
        log_error "Unknow procedure: $1, expecting one of '$(IFS='|'; echo "${procedures[*]}")'."
        exit 1;
    fi

    PROCEDURE=$1;
    states=( $(eval "echo \${states_$PROCEDURE[@]}") );

    store_override states PROCEDURE
    log_info "Procedure '$PROCEDURE'"
}

function mktable(){ local sep=${1:-$'\t'}; column -t -s "$sep"; }

function s_CheckDatabaseAtomic()
{(
    set -e;
    local res

    log_info "Checking if database '$DATABASE' is Atomic"
    res=$(kube_chc_query "SELECT arrayStringConcat(groupUniqArray(engine), '') FROM clusterAllReplicas('$CLUSTER', system.databases) WHERE database='$DATABASE'")

    if [[ "$res" != 'Atomic' ]]; then
        log_error "Database '$DATABASE' is not of Atomic engine."
        return 1;
    fi
)}

function s_CheckDataVisibility()
{(
    set -e;
    local res diff user
    res=$(kube_chc_query "
        SELECT currentUser();
        WITH
            ( SELECT sum(total_rows) FROM clusterAllReplicas('$CLUSTER',system.tables) WHERE database='$DATABASE' AND table='$LOCAL_TABLE' ) AS actual_rows,
            ( SELECT sum(count) FROM (SELECT count() AS count FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE') GROUP BY _part) ) AS visible_rows
        SELECT actual_rows AS \`Actual Rows\`, visible_rows AS \`Visible Rows\`, (actual_rows - visible_rows) AS Diff, round(Diff * 100 / actual_rows) AS \`Diff %\`
        FORMAT TabSeparatedWithNames
    " -n)
    user=$(head -1 <<<"$res")
    res=$(tail -n+2 <<<"$res")

    IFS=$'\t' read _ _ diff _ <<<"$(index_line 2 "$res")"

    if [ -z "$diff" ]; then log_state_error "Failed to check data visibility on table '$LOCAL_TABLE'."; return 1; fi
    if ((diff > 0)); then
        log_state_error "Data in table '$LOCAL_TABLE' is partially visible to current user '$user':${RST}\n$res"
        pause false; return 1
    fi
)}

# Rearrange states
function s_Rearrange()
{
    (
        set -e;
        local threshold=${STATE_Rearrange_THRESHOLD:-'1000000'}
        local res;
        res=$(kube_chc_query "SELECT max(count) FROM (SELECT count() AS count FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE') GROUP BY hostname())")

        if ((res == 0)); then # Simplest states flow
            log_state_info "Table '$LOCAL_TABLE' is empty, going with the simplest procedure."
            switch_procedure simplest
            STATE_DropTables_DROP_OLD_TABLE_IF_CONSISTENT=true;
        elif ((res <= threshold)); then # Simple states flow
            log_state_info "Table '$LOCAL_TABLE' contains a small amount of data, will rearrange to a simple procedure."
            switch_procedure simple
            if [ -z "$STATE_MigrateData_TIMESLOT_INTERVAL" ]; then STATE_MigrateData_TIMESLOT_INTERVAL='10 DAY'; fi
        else # Full states flow
            switch_procedure full
        fi
        store '' '' '';
    ) && load;
}

function r_Rearrange() { return 0; }

# DDL query should be formated first
function ddl_replace_zk_path()
{
    local new_path=$1;
    sed -r "s|^(ENGINE = Replicated.*MergeTree)\('([^']*)'|\1('${ZOOKEEPER:+$ZOOKEEPER:}$new_path'|";
}

function assign_ddl_queries()
{
    if [ "$(kube_chf_query 'select 1')" != "SELECT 1" ]; then
        log_state_error "Error trying to format a simple query.";
        return 1;
    fi
    # Format the reference CREATE TABLE query
    if ! [ -f "$DIR/$NEW_DDL_REFERENCE" ]; then
        log_state_error "DDL template file does not exist: $DIR/$NEW_DDL_REFERENCE."
        return 1;
    fi
    local create_table_query=$(kube_chf_query "$(cat $DIR/$NEW_DDL_REFERENCE)")
    # CREATE TABLE <DATABASE>.<TABLE> UUID '<UUID>' ON CLUSTER '<CLUSTER>'
    create_table_query=$(echo "$create_table_query" | sed -re "s|^CREATE .+|CREATE TABLE \`$DATABASE\`.\`<TABLE>\` UUID '<UUID>' ON CLUSTER '$CLUSTER'|")
    # ENGINE = ReplicatedMergeTree('/clickhouse/tables/{shard}/<DATABASE>/<LOCAL_TABLE>/<UUID>', '{replica}')
    create_table_query=$(echo "$create_table_query" | ddl_replace_zk_path "/clickhouse/tables/{shard}/$DATABASE/$LOCAL_TABLE/<UUID>")

    DDL_TEMPLATE=$create_table_query
    if [ -z "$DDL_TEMPLATE" ]; then
        log_state_error "Variable 'DDL_TEMPLATE' is not assigned successfully"
        return 1
    fi
    log_state_debug "Template of create table query: \n$DDL_TEMPLATE"

    # Using Replicated MergeTree engine ?
    [[ -n "$(sed -nr '/^ENGINE = Replicated.*MergeTree/p' <<<"$DDL_TEMPLATE")" ]] && ENGINE_REPLICATED=true || :;
    [[ -n "$(sed -nr '/^ENGINE = (Replicated)?(Replacing|Summing|Aggregating|VersionedCollapsing)MergeTree/p' <<<"$DDL_TEMPLATE")" ]] && ENGINE_DEDUPLICATING=true || :;

    DDL_ON_CLUSTER_CHAMELEON=$(sed -re "s|<TABLE>|$LOCAL_TABLE_CHAMELEON|g; s|<UUID>|$UUID_CHAMELEON|g" <<<"$DDL_TEMPLATE")
    DDL_ON_CLUSTER_DT=$(sed -re "s|<TABLE>|$LOCAL_TABLE_DT|g; s|<UUID>|$UUID_DT|g" <<<"$DDL_TEMPLATE")

    DDL_ON_CLUSTER_MERGE_CHAMELEON="
    CREATE OR REPLACE TABLE \`$DATABASE\`.\`$LOCAL_TABLE_MERGED\` ON CLUSTER '$CLUSTER' AS \`$DATABASE\`.\`$LOCAL_TABLE\`
    ENGINE = Merge('$DATABASE', '^($LOCAL_TABLE|$LOCAL_TABLE_CHAMELEON)\$')
    "
    DDL_ON_CLUSTER_MERGE_DT="
    CREATE OR REPLACE TABLE \`$DATABASE\`.\`$LOCAL_TABLE_MERGED\` ON CLUSTER '$CLUSTER' AS \`$DATABASE\`.\`$LOCAL_TABLE\`
    ENGINE = Merge('$DATABASE', '^($LOCAL_TABLE|$LOCAL_TABLE_DT)\$')
    "
    # Before tables swapped
    DDL_ON_CLUSTER_DISTRIBUTED_MERGED="
    CREATE OR REPLACE TABLE \`$DATABASE\`.\`$DISTRIBUTED_TABLE\` ON CLUSTER '$CLUSTER' AS \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`
    ENGINE = Distributed('$CLUSTER', '$DATABASE', '$LOCAL_TABLE_MERGED', $DISTRIBUTED_TABLE_SHARDING_KEY)
    "
    DDL_ON_CLUSTER_DISTRIBUTED="
    CREATE OR REPLACE TABLE \`$DATABASE\`.\`$DISTRIBUTED_TABLE\` ON CLUSTER '$CLUSTER' AS \`$DATABASE\`.\`$LOCAL_TABLE\`
    ENGINE = Distributed('$CLUSTER', '$DATABASE', '$LOCAL_TABLE', $DISTRIBUTED_TABLE_SHARDING_KEY)
    "
}

function ensure_state_functions_defined()
{
    local -A states_set=()
    local duplicate=false

    for state in ${states[@]}; do
        if [[ ! "$state" =~ ^[a-zA-Z0-9_]+$ ]]; then
            log_error "Invalid state name '$s'.";
            exit 1
        fi
        states_set[$state]=$((${states_set[$state]:-0} + 1))
        if ((${states_set[$state]} > 1)); then
            log_error "Duplicate state name: $state"
            duplicate=true;
        fi
        if [[ $state =~ ^'Pause_'[0-9a-zA-Z_]+$ ]]; then
            if ! func_defined "s_$state" || ! func_defined "r_$state"; then
                eval "function s_$state() { s_Pause; return 0; }"
                eval "function r_$state() { r_Pause; return 0; }"
            fi
        fi
        if ! func_defined "s_$state"; then
            log_error "Unknown state '$state': state function for '$state' is not defined.";
            exit 1;
        fi
    done
    if [ -n "$STATE" ] && ! func_defined "s_$STATE"; then
        log_error "Unknown state '$STATE', please manually revert to one of these states: $(IFS='|'; echo "${states[*]}")";
        exit 1;
    fi
    if [ $duplicate == true ]; then exit 1; fi
}

# Returns false if the distributed DDL queue is busy.
function s_CheckBusyDistributedDDLQueue()
{
    local max_ddl_age=${1:-'0'}; # Max age of unfinished DDL entries to consider the queue as 'busy'
    local result sql="SELECT entry,query_create_time,host,replaceRegexpAll(query,'(\n *)|( {2,})',' ') AS query
        FROM system.distributed_ddl_queue
        WHERE status!='Finished' AND (now() - query_create_time) >= $max_ddl_age
        ORDER BY query_create_time ASC
        LIMIT 10
        FORMAT PrettyCompactMonoBlock"

    log_state_info "Checking distributed DDL queue ..."
    result=$(kube_chc_query "$sql")

    if [ -n "$result" ]; then
        log_state_debug "${NC}\n$result"
        return 1;
    fi
    return 0;
}

function r_CheckBusyDistributedDDLQueue() { s_CheckBusyDistributedDDLQueue; }

function s_WaitOnBusyDistributedDDLQueue()
{
    while ! s_CheckBusyDistributedDDLQueue $1; do
        log_state_warn "Distributed DDL queue is busy, should re-check later."
        sleep 10;
    done
}

function r_WaitOnBusyDistributedDDLQueue() { s_WaitOnBusyDistributedDDLQueue; }

# Readonly tables can still be RENAME/EXCHANGE-ed.
function s_CheckTablesNotReadOnly()
{(
    set -e
    if [ "$ENGINE_REPLICATED" != true ]; then return 0; fi # Non-replicated tables cannot be readonly.

    local tables=( "$@" );
    if [ ${#tables[@]} == 0 ]; then tables=( "$LOCAL_TABLE" "$LOCAL_TABLE_CHAMELEON" "$LOCAL_TABLE_DT" ); fi

    tables=( $(IFS=$'\n'; echo "${tables[*]}" | sed -r "s|^.*$|'&'|") ) # Wrap each element in ''

    local result query="SELECT hostname() AS host,database,table,is_session_expired,is_readonly,future_parts,zookeeper_name,zookeeper_exception,last_queue_update_exception
        FROM clusterAllReplicas('$CLUSTER',system.replicas)
        WHERE is_readonly AND database='$DATABASE' AND table IN ( $(IFS=','; echo "${tables[*]}") )
        ORDER BY host,database,table
        FORMAT PrettyCompactMonoBlock"

    log_state_info "Checking readonly state of replicated MergeTree tables: ${tables[*]}"
    result=$(kube_chc_query "$query")

    if [ -n "$result" ]; then
        log_state_info "Some local tables are in readonly state:${NC}\n$result"
        return 1;
    fi
    return 0;
)}


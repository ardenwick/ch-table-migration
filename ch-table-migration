# ALTER TABLE $LOCAL_TABLE_DT [ON CLUSTER <cluster>] <ADD|DROP|MATERIALIZE|CLEAR> <INDEX|PROJECTION> [IF [NOT] EXISTS] <name>
function get_ddl_indexes_and_projections()
{
    local -u action=${1:-'ADD'}
    local conditional=${2:-'true'} on_cluster=${3:-'true'}

    local if_exists='' if_not_exists='';
    if [ $conditional == true ]; then if_exists="IF EXISTS"; if_not_exists="IF NOT EXISTS"; fi
    if [ $on_cluster == true ]; then on_cluster="ON CLUSTER '$CLUSTER'"; else on_cluster=''; fi

    if [ $action == 'ADD' ]; then

        local indexes_and_projections=$(echo "$DDL_TEMPLATE" | sed -nr '/^    INDEX /p; /^    PROJECTION /,/^    \)/p')

        if [ -z "$indexes_and_projections" ]; then return 0; fi

        echo -e "ALTER TABLE \`$DATABASE\`.\`$LOCAL_TABLE_DT\` $on_cluster\n$indexes_and_projections" \
            | sed -r "s/^    INDEX /    ADD INDEX $if_not_exists /g; s/^    PROJECTION /    ADD PROJECTION $if_not_exists /g" \
            | sed '${s/,$//}'

    elif [[ $action =~ ^('DROP'|'MATERIALIZE'|'CLEAR')$ ]]; then

        local indexes_and_projections=$(echo "$DDL_TEMPLATE" | sed -nr 's|^(    INDEX [^ ]+) .+$|\1,|gp; s|^(    PROJECTION [^ ]+)|\1,|gp')

        if [ -z "$indexes_and_projections" ]; then return 0; fi

        echo -e "ALTER TABLE \`$DATABASE\`.\`$LOCAL_TABLE_DT\` $on_cluster\n$indexes_and_projections" \
            | sed -r "s/^    INDEX /    $action INDEX $if_exists /g; s/^    PROJECTION /    $action PROJECTION $if_exists /g" \
            | sed '${s/,$//}'
    else
        log_state_error "Unknown clause '$action', expecting one of ADD|DROP|MATERIALIZE|CLEAR."
        return 1;
    fi
}

function s_DropProjectionsAndIndexes()
{(
    set -e;
    local timeout=${STATE_DropProjectionsAndIndexes_DISTRIBUTED_DDL_TASK_TIMEOUT:-'21600'} # 6 hours

    local ddl_on_cluster
    ddl_on_cluster=$(get_ddl_indexes_and_projections DROP false true)

    if [ -z "$ddl_on_cluster" ]; then return 0; fi

    s_WaitOnBusyDistributedDDLQueue 0;
    s_WaitOnBusyMutationsOnTable $LOCAL_TABLE_DT;

    kube_chc_query "$ddl_on_cluster SETTINGS distributed_ddl_task_timeout=$timeout" --echo;
)}

function r_DropProjectionsAndIndexes()
{(
    set -e;
    local ddl
    ddl=$(get_ddl_indexes_and_projections ADD true false)

    if [ -z "$ddl" ]; then return 0; fi

    s_WaitOnBusyDistributedDDLQueue 0;
    (
        SERVER_PODS=( $(get_replicated_server_pods) );
        LOG_PREFIX=true kube_chc_query_all "$ddl";
    )
)}


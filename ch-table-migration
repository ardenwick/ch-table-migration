function func_defined() { declare -F "$1" >/dev/null; }

function lock_dir_100_or_exit()
{
    if [ -e /proc/$$/fd/100 ]; then
        log_error "Logical error: file discriptor 100 is already in use.";
        exit 2;
    fi
    exec 100< $DIR # open

    local ret
    flock -E 249 -xn 100; ret=$?

    if [ $ret != 0 ]; then
        if [ $ret == 249 ]; then
            log_error "Unable to lock task directory '$RELATIVE_DIR', maybe another instance is running ?";
        fi
        exit 1;
    fi
}

function unlock_dir_100()
{
    if ! [ -e /proc/$$/fd/100 ]; then
        log_error "Logical error: file discriptor 100 is not opened.";
        exit 2;
    fi
    exec 100<&-;
}

function last_error()
{(
    set +x;
    local truncated=false;
    while read -r; do
        if [ "$truncated" == false ]; then truncate -s0 $DIR/last_error; truncated=true; fi
        echo "$REPLY" | tee -a $DIR/last_error;
    done
)}

function walk_state_unlocked()
{
    if ! func_defined "r_${STATE}"; then
        log_warn "Revert function for state '$STATE' not found. Reverting is not possible.";
    fi

    local ret='' state=$STATE next_state=$STATE;

    if [ -n "$REVERT" ]; then # Reverting
        log_info "Reverting state '$state'"
        unset STATES_START_TIME[$state] STATES_FINISH_TIME[$state];

        set_dirty true; # Keep it true if reverting.
        r_${state}; ret=$?

        if [[ "$RELOAD" == true || "$RELOCATE" == true ]]; then load; RELOAD=false; fi
        if [ $ret != 0 ]; then
            log_warn "Code $ret, failed to revert state '$state'. Retrying."
        else
            if [[ "$REVERT" != "$state" ]]; then
                next_state=$(get_previous_state) # Continue to revert 'all'
            else
                log_info "Reverted to the begining of state $state.";
                REVERT=''; DIRTY=false;
                pause;
            fi
        fi;
    elif [ "$DIRTY" == true ]; then # Cleaning
        log_info "State '$state' dirty, cleaning"

        if func_defined "c_${state}"; then
            c_${state}; ret=$?
        elif func_defined "r_${state}"; then
            r_${state}; ret=$?
        else
            log_state_error "Dirty state cannot be cleared: not found cleaning function or revert function for state '$STATE'."
            pause;
        fi
        if [ -n "$ret" ]; then
            if [[ "$RELOAD" == true || "$RELOCATE" == true ]]; then load; RELOAD=false; fi
            if [ $ret != 0 ]; then
                log_warn "Code $ret, failed to revert or clean the state '$state'. Retrying."
            else
                DIRTY=false;
            fi;
        fi
    else # Advancing
        log_info "At state '$state'"
        if [ -z "${STATES_START_TIME[$state]}" ]; then STATES_START_TIME[$state]=$(timestamp); fi

        set_dirty true; # Commit to disk
        s_${state}; ret=$?

        if [[ "$RELOAD" == true || "$RELOCATE" == true ]]; then load; RELOAD=false; fi # Some state functions may update state variables in subshell.
        if [ $ret != 0 ]; then
            log_warn "State '$state' failed with code $ret. Retrying."
        else
            DIRTY=false; # Commit to disk together with $next_state at the end of function
            next_state=$(get_next_state)
            STATES_FINISH_TIME[$state]=$(timestamp)
        fi;
    fi

    if [ "$RELOCATE" == true ]; then
        log_info "Relocating to STATE=$STATE, DIRTY=$DIRTY, PAUSED=$PAUSED"
        RELOCATE=false;
        store '' '' '';
    else
        log_info "Transfering to state STATE=$next_state, DIRTY=$DIRTY, PAUSED=$PAUSED"
        store $next_state '' '';
    fi
    return $ret;
}

function walk_state()
{
    ensure_state_functions_defined;
    redefine_error_loggers_with_dir;

    lock_dir_100_or_exit;

    walk_state_unlocked 2> >(last_error >&2);

    unlock_dir_100;
}

function walk()
{
    ensure_state_functions_defined;
    redefine_error_loggers_with_dir;

    lock_dir_100_or_exit;

    while true; do
        walk_state_unlocked 2> >(last_error >&2);
        if [ $? != 0 ]; then sleep 3; fi
    done

    unlock_dir_100;
}

## Functions for Task Management

SYSTEMD_UNIT_FILES_DIR="/etc/systemd/system"

function task_unit_file_exists() { [ -f $TASK_UNIT_FILE ]; }

function ensure_task_unit_file_exists()
{
    if ! task_unit_file_exists; then
        log_info "Directory '$RELATIVE_DIR' is not registered as a task in systemd. Please create the task with \`$PROG_NAME create $RELATIVE_DIR\` first."
        exit 1;
    fi
}

function list_tasks()
{
    local unit_files=$(ls $SYSTEMD_UNIT_FILES_DIR/chtm_*.service 2>/dev/null)
    {
        echo -e "Name\tState\tDirty\tPaused\tRevert To\tTask Directory\tLocked*\tSystemd Unit"
        echo -e "────\t─────\t─────\t──────\t─────────\t──────────────\t───────\t────────────"
        for f in $unit_files; do
            local name=$(echo $f | sed -nr 's|.+/chtm_(.+).service|\1|gp')
            local dir=$(awk '/^ExecStart/ {print$4}' $f | tr -d '"')
            local state dirty paused revert locked
            read state dirty paused revert locked < <(
                DIR=$dir; load;
                locked=''; dir_locked && locked='*';
                echo "${STATE:-Unknown} ${DIRTY:-Unknown} ${PAUSED:-Unknown} ${REVERT:-N/A} $locked"
            )
            [ "$FLAG_LIST_RELATIVE" == true ] && dir=$(realpath -ms --relative-to="$PWD" "$dir") || :
            echo -e "$name\t$state\t$dirty\t$paused\t$revert\t$dir\t$locked\t$(basename $f)"
        done
    } | mktable | sed "s|*|$BOLD$GREEN*$RST|g"
}

function prune_tasks()
{
    set -e;
    local unit_files=$(ls $SYSTEMD_UNIT_FILES_DIR/chtm_*.service 2>/dev/null)
    for f in $unit_files; do
        local name=$(echo $f | sed -nr 's|.+/chtm_(.+).service|\1|gp')
        local dir=$(awk '/^ExecStart/ {print$4}' $f | tr -d '"')
        log_debug "Checking $name"
        if ! [[ -f "$dir/state" || -f "$dir/config" ]]; then
            if index_line 3 "$(systemctl status chtm_$name.service)" | grep -q "Active: active"; then
                log_warn "Systemd unit chtm_$name.service is still running."
            else
                (
                    systemctl disable chtm_$name.service
                    systemctl stop chtm_$name.service
                ) > /dev/null 2>&1
                rm -rf "$f";
                log_info "Directory '$dir' of task '$name' is missing or invalid, removed systemd unit $f"
            fi
        fi
    done
    systemctl daemon-reload;
}

function init_task()
{
    if [ -d $DIR ]; then
        log_error "Directory '$RELATIVE_DIR' already exists."
        return 1
    fi
(
    set -e;
    # Discover CLUSTER, EXPANDED_CLUSTER
    if [ -z "$CLUSTER" ]; then
        CLUSTER="{cluster}"
        if [ -n "$CLUSTER" ]; then
            log_info "Assigned default variable CLUSTER=$CLUSTER"
        fi
    fi
    if ! EXPANDED_CLUSTER=$(expand_macro $CLUSTER); then
        log_state_error "Error retrieving value of macro '$CLUSTER'."
        exit 1
    fi

    if [[ -z "$LOCAL_TABLE" ]]; then
        log_error "Variable 'LOCAL_TABLE' is not defined, please specify it with flag '--local <local_table_name>'"
        exit 1;
    fi
    # Discover DATABASE
    if [ -z "$DATABASE" ]; then
        DATABASE=$(kube_chc_query "SELECT database FROM system.tables WHERE name='$LOCAL_TABLE'")
        if [ -z "$DATABASE" ]; then
            log_error "Cannot find database containing table '$LOCAL_TABLE'. Does the table exist ?"
            exit 1
        fi
        if [ $(echo "$DATABASE" | wc -l) -gt 1 ]; then
            log_error "Found more than 1 databases containing table named '$LOCAL_TABLE': $(tr '\n' ' ' <<<"$DATABASE"). Please specify it with flag '--db <database_name>'"
            exit 1
        fi
        log_info "Assigned variable DATABASE=$DATABASE"
    fi

    exists=$(table_exists_on_cluster $LOCAL_TABLE)
    if [ "$exists" == '0' ]; then
        log_error "Table does not exist: $DATABASE.$LOCAL_TABLE"
        exit 1
    fi
    # Discover DISTRIBUTED_TABLE
    if [ -z "$DISTRIBUTED_TABLE" ]; then
        DISTRIBUTED_TABLE=$(kube_chc_query "
            SELECT table FROM system.tables WHERE engine='Distributed' AND database='$DATABASE' AND match(engine_full,'\'$DATABASE\'') AND match(engine_full,'\'$LOCAL_TABLE\'')
            ")
        if [ -z "$DISTRIBUTED_TABLE" ]; then
            log_error "Cannot find distributed table for $DATABASE.$LOCAL_TABLE"
            exit 1
        fi
        if [ $(echo "$DISTRIBUTED_TABLE" | wc -l) -gt 1 ]; then
            log_error "Found more than 1 distributed tables for $DATABASE.$LOCAL_TABLE: $(tr '\n' ' ' <<<"$DISTRIBUTED_TABLE")"
            exit 1
        fi
        log_info "Assigned variable DISTRIBUTED_TABLE=$DISTRIBUTED_TABLE"
    fi
    # Async discover DISTRIBUTED_TABLE_SHARDING_KEY
    local tmp_ddl_distributed_table write_ddl_distributed_table_pid
    if [ -z "$DISTRIBUTED_TABLE_SHARDING_KEY" ]; then
        tmp_ddl_distributed_table=$(mktmp)
        show_create_table $DISTRIBUTED_TABLE > $tmp_ddl_distributed_table &
        write_ddl_distributed_table_pid=$!
    fi

    # Async discover NEW_DDL_REFERENCE, DDL_TEMPLATE
    if [ -z "$NEW_DDL_REFERENCE" ]; then
        NEW_DDL_REFERENCE=$LOCAL_TABLE.sql;
        log_info "Assigned variable NEW_DDL_REFERENCE=$NEW_DDL_REFERENCE"
    fi

    mkdir -p $DIR; rm -rf $DIR/state.override;

    local write_ddl_local_table_pid
    if ! [ -f "$NEW_DDL_REFERENCE" ]; then
        show_create_table $LOCAL_TABLE > $DIR/$NEW_DDL_REFERENCE &
        write_ddl_local_table_pid=$!
    else
        command cp "$NEW_DDL_REFERENCE" $DIR/
        NEW_DDL_REFERENCE=$(basename $NEW_DDL_REFERENCE)
    fi

    # Discover STATE_MigrateData_DATETIME_COLUMN
    if [ -z "$STATE_MigrateData_DATETIME_COLUMN" ]; then
        local res column type
        res=$(kube_chc_query "
            WITH (
                SELECT splitByRegexp(', ', sorting_key)[1] FROM system.tables
                WHERE (database = '$DATABASE') AND (table = '$LOCAL_TABLE')
            ) AS key
            SELECT name,type FROM system.columns
            WHERE (database = '$DATABASE') AND (table = '$LOCAL_TABLE') AND (name = key)
            ")
        read column type <<<"$res"
        if [[ -z "$column" || -z "$type" ]]; then
            log_error "Not found sorting key of table $LOCAL_TABLE or cannot determine data type of first column in the sorting key."
            exit 1;
        fi
        if [[ $column =~ [Tt]'ime' && $type =~ 'Int'|'DateTime' ]]; then # very likely
            log_debug "Found sorting column '$column' of type '$type'"
            STATE_MigrateData_DATETIME_COLUMN=$column;
            log_info "Assigned variable STATE_MigrateData_DATETIME_COLUMN=$STATE_MigrateData_DATETIME_COLUMN"
        fi
    fi

    # Finish discover DISTRIBUTED_TABLE_SHARDING_KEY
    if [ -n "$write_ddl_distributed_table_pid" ]; then
        wait $write_ddl_distributed_table_pid;
        local engine_full
        engine_full=$(sed -nr '/^ENGINE = Distributed/p' $tmp_ddl_distributed_table; rm -rf $tmp_ddl_distributed_table)
        if [ -z "$engine_full" ]; then
            log_error "Cannot retrieve ENGINE of distributed table '$DISTRIBUTED_TABLE'"
            exit 1;
        fi
        local regex=", ([^ \)']+)\)$"
        if [[ "$engine_full" =~ $regex ]]; then
            DISTRIBUTED_TABLE_SHARDING_KEY=${BASH_REMATCH[1]}
            log_info "Assigned variable DISTRIBUTED_TABLE_SHARDING_KEY=$DISTRIBUTED_TABLE_SHARDING_KEY"
        fi
    fi

    # Finish discover DDL_TEMPLATE
    if [ -n "$write_ddl_local_table_pid" ]; then
        wait $write_ddl_local_table_pid;
        log_info "Wrote file $RELATIVE_DIR/$NEW_DDL_REFERENCE"
    fi

    DDL_TEMPLATE=$(cat $DIR/$NEW_DDL_REFERENCE);
    if [ -z "$DDL_TEMPLATE" ]; then
        log_error "Unexpected error: DDL reference file is empty '$NEW_DDL_REFERENCE'"
        exit 1;
    fi

    # Table structural changes

    local engine partitionby primarykey orderby ttl settings
    engine=$(sed -nr "s|^ENGINE = (.+)|\1|p" <<<"$DDL_TEMPLATE")
    partitionby=$(sed -nr "s|^PARTITION BY (.+)|\1|p" <<<"$DDL_TEMPLATE")
    primarykey=$(sed -nr "s|^PRIMARY KEY (.+)|\1|p" <<<"$DDL_TEMPLATE")
    orderby=$(sed -nr "s|^ORDER BY (.+)|\1|p" <<<"$DDL_TEMPLATE")
    ttl=$(sed -nr "s|^TTL (.+)|\1|p" <<<"$DDL_TEMPLATE")
    settings=$(sed -nr "s|^SETTINGS (.+)|\1|p" <<<"$DDL_TEMPLATE")

    if [ -n "$ENGINE" ]; then engine=${ENGINE%%+([[:space:]])}; fi
    if [ -n "$PARTITIONBY" ]; then partitionby=${PARTITIONBY%%+([[:space:]])}; fi
    if [ -n "$PRIMARYKEY" ]; then primarykey=${PRIMARYKEY%%+([[:space:]])}; fi
    if [ -n "$ORDERBY" ]; then orderby=${ORDERBY%%+([[:space:]])}; fi
    if [ -n "$TTL" ]; then ttl=${TTL%%+([[:space:]])}; fi

    engine_full=$(echo "
    ENGINE = $engine
    PARTITION BY $partitionby
    PRIMARY KEY $primarykey
    ORDER BY $orderby
    TTL $ttl
    SETTINGS $settings
    " | sed -r '/ $/d') # remove empty clauses

    log_info "Assigned full engine to local table '$LOCAL_TABLE':${NC}$engine_full"

    DDL_TEMPLATE=$(sed -nr "/^CREATE /,/^\)/p" <<<"$DDL_TEMPLATE")
    DDL_TEMPLATE="$DDL_TEMPLATE$(unindent "$engine_full")"
    echo "$DDL_TEMPLATE" > $DIR/$NEW_DDL_REFERENCE

    store Initialize false false;
    command cp --remove-destination $DIR/state $DIR/config;

    log_info "Trying to initialize for validation..."
    if ! s_Initialize; then
        log_error "Initialization failed, please revise the command line arguments and \`init $RELATIVE_DIR\` again."
        exit 1;
    fi
    WAIT_PAUSED=false store CreateTables false '';

    log_info "Initialized task directory '$RELATIVE_DIR'."

    if [ "$FLAG_CREATE" == true ]; then
        INITIALIZED=true create_task;
    fi
)
    local ret=$?
    if [ $ret != 0 ]; then rm -rf $DIR; return $ret; fi
}

function create_task()
{
    if dir_locked; then
        log_error "Directory is locked: '$DIR', maybe there's an already running instance. This is unexpected."
        return 1;
    fi

    if [ "$INITIALIZED" != true ]; then
        store Initialize false false
        # Execute the initialization here to find out any configuration problem.
        if ! s_Initialize; then
            log_error "Initialization failed, please revise the configuration and create the task again."
            return 1;
        fi
        WAIT_PAUSED=false store CreateTables false '';
    fi

    if task_unit_file_exists; then
        if [ "$FLAG_FORCE" != true ]; then
            log_error "Systemd unit file already exists: $TASK_UNIT_FILE"
            return 1;
        fi
    fi

    unindent "
    [Unit]
    Description=ClickHouse Table Structural Migration Task $TASK_NAME
    After=network.target
    # StartLimitIntervalSec=0

    [Service]
    Type=simple
    Restart=on-failure
    RestartSec=1
    StartLimitInterval=0
    User=root
    WorkingDirectory=$(dirname $(realpath "$0"))
    ExecStart=/bin/bash \"$(realpath "$0")\" walk \"$DIR\"
    StandardOutput=syslog
    StandardError=syslog
    Environment=\"KUBECONFIG=$KUBECONFIG\" \"LOG_LEVEL=$LOG_LEVEL\"

    [Install]
    WantedBy=multi-user.target
    " > $TASK_UNIT_FILE

    log_info "Wrote systemd unit '$TASK_UNIT_FILE_NAME', file '$TASK_UNIT_FILE'"

    if [ "$FLAG_START" == true ]; then
        FLAG_DAEMON=true resume_task;
    else
        log_info "Run \`resume $RELATIVE_DIR --daemon\` to activate the task."
    fi
}

function delete_task()
{
    set -e;
    ensure_task_unit_file_exists;
    load;

    if [[ $STATE != 'Complete' && "$FLAG_FORCE" != true ]]; then
        log_info "Task $TASK_NAME is not in Complete state, will not proceed."
        return 1;
    fi
    # Ensure paused if not Complete
    if dir_locked; then
        if [ "$FLAG_PAUSE" == true ]; then
            FLAG_DAEMON=true pause_task;
        else
            log_info "Task $TASK_NAME is running, will not proceed."
            return 1;
        fi
        if dir_locked; then
            log_warn "Task directory is still locked: there's a running process out of control of systemd. Please be careful."
        fi
    fi

    rm -f $TASK_UNIT_FILE;
    # systemctl daemon-reload # Is this necessary ?
    log_info "Task $TASK_NAME unregistered."

    if [ "$FLAG_DIRECTORY" == true ]; then
        if ! dir_locked; then
            rm -rf $DIR;
            log_info "Removed task directory '$RELATIVE_DIR'."
        else
            log_error "Task directory '$RELATIVE_DIR' is locked, will not remove it."
        fi
    fi
}

function pause_task()
{
    flock -x $DIR/state echo "declare -g PAUSED=true" >> $DIR/state.override
    load;

    if [ "$FLAG_DAEMON" != true ]; then
        log_info "Task $TASK_NAME state STATE=$STATE, PAUSED=$PAUSED"
        return 0;
    fi
    if task_unit_file_exists; then
        if ! await_running_instance; then
            log_warn "Timed out (grace=${FLAG_GRACE}s), will force stop the active process."
        fi
        (
            set -e
            systemctl disable $TASK_UNIT_FILE_NAME
            systemctl stop $TASK_UNIT_FILE_NAME # This command waits until the process is actually stopped.
            log_info "Systemd unit $TASK_UNIT_FILE_NAME stopped."
        )  > >(log_prefix "[systemctl]") 2> >(log_error_prefix "[systemctl]")
    else
        log_info "Task $TASK_NAME is not registered as a systemd service. Only changed state to STATE=$STATE, PAUSED=$PAUSED"
    fi
}

function resume_task()
{
    if paused; then
        flock -x $DIR/state echo "declare -g PAUSED=false" >> $DIR/state.override
        load;
        log_info "State resumed";
    fi
    if [ "$FLAG_DAEMON" != true ]; then
        log_info "Task $TASK_NAME state STATE=$STATE, PAUSED=$PAUSED"
        return 0;
    fi
    if task_unit_file_exists; then
        (
            set -e;
            local now=$(datetime)
            systemctl enable $TASK_UNIT_FILE_NAME
            systemctl start $TASK_UNIT_FILE_NAME
            log_info "Systemd unit $TASK_UNIT_FILE_NAME activated. Run \`journalctl -o cat -u $TASK_UNIT_FILE_NAME -f --since '$now' \` to follow log messages."
        ) > >(log_prefix "[systemctl]") 2> >(log_error_prefix "[systemctl]")
    fi
}

function restart_task()
{
    if dir_locked; then
        FLAG_DAEMON=true pause_task;
        if dir_locked; then
            log_error "Task directory is still locked after 'systemctl stop': there's a running process out of control of systemd."
            FLAG_DAEMON=false resume_task
            return 1
        fi
    fi
    FLAG_DAEMON=true resume_task
}

function revert_task()
{
    if [ $STATE == 'Complete' ]; then
        log_warn "Task $TASK_NAME is completed, will not revert. Please create a new task instead."
        return 1;
    fi
    local to=$STATE;
    if [ -n "$FLAG_REVERT_TO" ]; then
        if ! func_defined "s_$FLAG_REVERT_TO"; then
            log_error "Unknown state '$FLAG_REVERT_TO', should be one of: $(IFS='|'; echo "${states[*]}")";
            return 1;
        fi
        to=$FLAG_REVERT_TO
    elif [ "$FLAG_ALL" == true ]; then
        to='Initialize'
    fi

    flock -x $DIR/state echo "declare -g REVERT=$to PAUSED=false" >> $DIR/state.override
    load;
    if paused; then log_info "Will resume state."; resume_task; fi

    log_info "Task $TASK_NAME state STATE=$STATE, REVERT=$REVERT"

    if [ "$FLAG_DAEMON" == true ]; then
        log_info "Restarting task '$RELATIVE_DIR'..."
        restart_task;
    elif dir_locked; then
        log_warn "The running process will take the revert only after finishing current state. To apply it immediately, run command \`restart $RELATIVE_DIR\` afterwards."
    fi
}

function dir_locked()
{
    flock -E 249 -xn $DIR true;
    local ret=$?;
    if [ $ret == 0 ]; then
        return 1; # unlocked
    elif [ $ret == 249 ]; then
        return 0; # locked
    else
        log_error "Unknown error: cannot check locking status of task directory.";
        exit 2;
    fi
}

function await_running_instance()
{
    FLAG_GRACE=${FLAG_GRACE:-'0'}

    if dir_locked; then
        log_info "Waiting for running instance to stop..."
        local start=$(timestamp_ms)
        while (( $(timestamp_ms) - start <= FLAG_GRACE * 1000 )); do
            if ! dir_locked; then break; fi
            sleep 0.2;
        done
        # if timed out
        if (( $(timestamp_ms) - start > FLAG_GRACE * 1000 )); then
            return 1;
        fi
    else
        log_info "No running instance found."
    fi
}

function kube_chc_simple_query_pods()
{
    local -a server_pods=( $1 ); shift
    local query=$1 prefix=$2 suffix=$3

    local pids='';
    trap_kill_group;

    for pod in ${server_pods[@]}; do
        kube_ch $pod clickhouse-client "$query" "${CHC_FLAGS[@]}" > $prefix$pod$suffix 2>/dev/null &
        pids+=" $!"
    done
    for pid in $pids; do wait $pid; done

    trap_restore_kill_group;
}

function two_column_if_needed()
{
    local header=$1 content=$(cat)
    if [ ! "$FLAG_TWO_COLUMN" == true ]; then echo "$header"; echo "$content"; return; fi
    local nr_lines=0 half=0 file1=$(mktmp) file2=$(mktmp)
    nr_lines=$(echo "$content" | wc -l);
    half=$(( (nr_lines + 1) / 2 ))
    { echo "$header"; echo "$content" | head -n$half; } > $file1
    { echo "$header"; echo "$content" | tail -n+$((half+1)); } | sed 's/^/│ /g' > $file2
    paste -d $'\t' $file1 $file2
    rm -f $file1 $file2
}

function format_readable_time_delta_compact()
{
    local sec=$1 zero_padding=$2
    awk -v sec=$sec -v zero_padding=$zero_padding '
        BEGIN {
            f = zero_padding ? "%02d%s" : "%d%s"
            d = int(sec / 86400); r = sec % 86400;
            h = int(r / 3600); r %= 3600; m = int(r / 60); s = r % 60
            s=sprintf("%s%s%s%s", component(d,"d"), component(h,"h"), component(m,"m"), component(s,"s"))
            print s ? s : "0s"
        }
        function component(v,u){ return v>0 ? sprintf(f, v, u) : "" }
    ' | sed -r 's|^(([0-9]+[dhms]){2}).*$|\1|' # preserve 2 parts for readability
}

function report_task()
{
    ensure_state_functions_defined;

    local -A state_indexes=()
    for i in ${!states[@]}; do s=${states[$i]}; state_indexes[$s]=$i; done

    # overview
    local locked; dir_locked && locked="$BOLD$GREEN*$RST" || :;
    echo -en "\n${BOLD}Overview${RST}\n    STATE=$STATE  DIRTY=$DIRTY  PAUSED=$PAUSED  REVERT=${REVERT:-N/A}\n"

    echo -en "\n${BOLD}States Flow ${RST}${FAINT}${ITALIC}($PROCEDURE)${RST}${locked}\n"
    # state1 -> state2 -> state3 ...
    local i=0 N=${#states[@]};
    while ((i < N)); do
        local s=${states[$i]}; ((++i));
        if [ $s == $STATE ]; then echo -n "${BOLD}${BLUE}${UNDERLINE}${s}${RST}"; else echo -n "${s}"; fi
        if [[ -n "${STATES_FINISH_TIME[$s]}" && -n "${STATES_FINISH_TIME[$s]}" ]]; then
            echo -n "($( format_readable_time_delta_compact $((STATES_FINISH_TIME[$s] - STATES_START_TIME[$s])) ))"
        elif [[ -n "${STATES_START_TIME[$s]}" ]]; then
            echo -n "($( format_readable_time_delta_compact $(($(timestamp) - STATES_START_TIME[$s])) ))"
        fi
        if ((i < N)); then echo -n " → "; else echo; fi
    done | folded_indent | sed -r "s|\([^\)]+\)|$FAINT$GREEN&$RST|g"

    # state variables
    if [ "$FLAG_VARIABLE" == true ]; then
        echo -e "\n${BOLD}Variables${RST} "
        for var in ${state_variables[@]}; do [[ $var =~ ^"STATE_${STATE}_" ]] && echo -e "$var\t=\t${!var:-DEFAULT}"; done | mktable | folded_indent
    fi

    # detail
    echo -en "\n${BOLD}Detail:${RST} "

    if [ $STATE == MigrateData ]; then
        local query="
            WITH
                (SELECT count() FROM \`$DATABASE\`.\`$LOCAL_TABLE_DT\`) AS count_dt,
                (SELECT count() FROM \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`) AS count_chameleon
            SELECT count_dt, count_chameleon, round(count_dt * 100 / count_chameleon, 5) AS progress
            FORMAT TSVRaw
        "
        kube_chc_simple_query_pods "${SERVER_PODS[*]}" "$query" "$DIR/report.dt." ""

        echo -e "Data migration progress\n"

        local elapsed=$(($(timestamp) - STATES_START_TIME[MigrateData]))
        local header=$(
            echo -e "Pod\t DT Table\t Chameleon Table\t Progress %\t ETA"
            echo -e "───\t ────────\t ───────────────\t ──────────\t ───"
        )
        {
            for pod in ${SERVER_PODS[@]}; do
                local count_dt count_chameleon progress
                IFS=$'\t' read count_dt count_chameleon progress < <(cat $DIR/report.dt.$pod; rm -rf $DIR/report.dt.$pod)
                local eta=$(
                    eta_sec=$(awk "BEGIN { if($progress==0) {print "INF";exit} print int($elapsed / $progress * (100 - $progress) + 0.5) }")
                    format_readable_time_delta_compact $eta_sec true
                )
                echo -e "$pod\t $count_dt\t $count_chameleon\t $progress\t $eta"
            done
        } | two_column_if_needed "$header" | mktable | folded_indent
    elif [ $STATE == WaitMaterializationDone ]; then
        local query="
            WITH
                ( SELECT count() FROM system.merges WHERE is_mutation AND database='$DATABASE' AND table='$LOCAL_TABLE_DT' ) AS executing_mutations
            SELECT executing_mutations,parts_to_do,if((parts_to_do + executing_mutations) == 0, 'Yes', 'No') AS finished,left(latest_fail_reason,100) AS latest_fail_reason
            FROM system.mutations
            WHERE database='$DATABASE' AND table='$LOCAL_TABLE_DT' AND startsWith(command,'MATERIALIZE ')
            ORDER BY is_done ASC, create_time DESC
            LIMIT 1
            FORMAT TSVRaw
        "
        kube_chc_simple_query_pods "${SERVER_PODS[*]}" "$query" "$DIR/report.mat." ""

        echo -e "Progress on materialization of indexes and projections\n"

        local header=$(
            echo -e "Pod\t Parts Executing\t Parts To Do\t Finished\t Latest Fail Reason"
            echo -e "───\t ───────────────\t ───────────\t ────────\t ──────────────────"
        )
        {
            for pod in ${SERVER_PODS[@]}; do
                local executing_mutations parts_to_do finished latest_fail_reason
                IFS=$'\t' read executing_mutations parts_to_do finished latest_fail_reason < <(cat $DIR/report.mat.$pod; rm -rf $DIR/report.mat.$pod)
                echo -e "$pod\t $executing_mutations\t $parts_to_do\t $finished\t $latest_fail_reason"
            done
        } | two_column_if_needed "$header" | mktable | folded_indent

    elif [ $STATE == MovePartitions ]; then
        local query="
            SELECT count() AS parts_to_do,if(parts_to_do==0,'Yes','No') AS finished
            FROM system.parts
            WHERE active AND database='$DATABASE' AND table='$LOCAL_TABLE_DT'
            FORMAT TSVRaw
        "
        kube_chc_simple_query_pods "${SERVER_PODS[*]}" "$query" "$DIR/report.move." ""

        echo -e "Progress on MovePartitions\n"

        local header=$(
            echo -e "Pod\t Parts To Move\t Finished"
            echo -e "───\t ─────────────\t ────────"
        )
        {
            for pod in ${SERVER_PODS[@]}; do
                local parts_to_do finished
                IFS=$'\t' read parts_to_do finished < <(cat $DIR/report.move.$pod; rm -rf $DIR/report.move.$pod)
                echo -e "$pod\t $parts_to_do\t $finished"
            done
        } | two_column_if_needed "$header" | mktable | folded_indent

    elif (( ${state_indexes[$STATE]} >= ${state_indexes['Complete']} )); then
        echo "Task Completed";
        return 0;
    elif (( ${state_indexes[$STATE]} >= ${state_indexes['ConsistencyReport']} )); then
        echo -e "Data consistency report\n"
        if [ -f "$DIR/consistency_report" ]; then
            cat $DIR/consistency_report
        else
            log_error "File does not exist: $RELATIVE_DIR/consistency_report"
        fi | folded_indent
    else
        echo "Unknown";
    fi

    # last error
    echo -e "\n${BOLD}Most Recent Error Messages${RST}"
    if [ -f "$DIR/last_error" ]; then
        local errors starting_point
        errors=$(cat $DIR/last_error | tail -20 | sed -r 's|^(.{640}).+|\1 ...|g')
        starting_point=$(
            {
                echo "$errors" | grep -Po '\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}';
                date -d @$(( $(date +%s) - 6*3600 )) +'%F %T.%3N ==SEPARATOR==';
            } | sort | grep -n ==SEPARATOR== | cut -d: -f1
        )
        echo "$errors" | tail -n+$starting_point
    fi
}

function print_vars()
{
    {
        echo "${BOLD}All Available State Variables${RST}";
        cat "$0" | sed -nr '/^declare -a state_variables/,/^\)/p' | grep -v 'Internal state' | indent


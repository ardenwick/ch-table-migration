function variables_declaration() { for var; do declare -p $var 2>/dev/null | sed -r '1{ /^declare -[-aAfFgilrtux ]*a/{ s|\[[0-9]+\]=||g }; s|^declare |declare -g |g}'; done; }

function load()
{
    if ! [ -f $DIR/state ]; then log_error "State file $DIR/state does not exist."; exit 1; fi
    {
        flock -x 10;
        unset ${state_variables[@]}
        source $DIR/state
        [ -f $DIR/state.override ] && source $DIR/state.override;

    } 10< $DIR/state

    log_trace "load: STATE=$STATE DIRTY=$DIRTY PAUSED=$PAUSED"
}

function store()
{
    if (($# != 3)); then log_error "Wrong number of arguments passed to store(): $#, should be 3."; exit 1; fi
    {
        flock -x 10;
        disable_signals SIGINT SIGTERM SIGTSTP EXIT

        STATE=${1:-$STATE} DIRTY=${2:-$DIRTY} PAUSED=${3:-$PAUSED}

        if [ -f $DIR/state.override ]; then
            if [ $(cat $DIR/state.override | wc -l) -gt 1024 ]; then
                log_error "Too many lines in '$DIR/state.override', refusing to include it."
                command mv $DIR/state.override $DIR/state.override.refused
            else
                source $DIR/state.override && rm -f $DIR/state.override;
            fi
        fi
        variables_declaration ${state_variables[@]} >&10

        restore_signals SIGINT SIGTERM SIGTSTP EXIT
    } 10> $DIR/state

    log_trace "store: STATE=$STATE DIRTY=$DIRTY PAUSED=$PAUSED"

    if [ -f $SIGNAL_QUEUE_FILE ]; then
        local signals=$(cat $SIGNAL_QUEUE_FILE; rm -f $SIGNAL_QUEUE_FILE)
        for sig in $signals; do kill -s $sig -- -$$; done
    fi

    if [ ${WAIT_PAUSED:-'true'} == true ]; then wait_paused; fi # nasty but works fine
}

# store_override var1 var2 var3
function store_override()
{(
    set -e;
    { flock -x 10; variables_declaration "$@" >&10; } 10>> $DIR/state.override;
    log_debug "Wrote '$RELATIVE_DIR/state.override'"
)}

function set_dirty() { store '' "$1" ''; log_debug "set_dirty($1): DIRTY=$DIRTY"; }

# Note: Do not call load/store/pause/wait_paused in subshells unless you know what you're doing.

function pause()
{
    local immediately=${1:-'true'};
    flock -x $DIR/state echo "declare -g PAUSED=true" >> $DIR/state.override
    WAIT_PAUSED=$immediately store '' '' '';
}

function paused() { load; [ "$PAUSED" == true ]; }

function wait_paused()
{
    if paused; then
        log_info "Paused, waiting to resume...";
        while paused; do sleep 1; done
    fi
}


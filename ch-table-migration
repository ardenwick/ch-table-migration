}

function set_task()
{
    local tmp;
    while (($# > 0)); do
        # name=value
        if [[ "$1" =~ ^([a-zA-Z][a-zA-Z0-9_]+)'='.+$ ]]; then
            local var=${BASH_REMATCH[1]}
            if ! [[ " ${state_variables[*]} " =~ " $var " ]]; then
                log_error "Unknown state variable '$var'. Run \`vars\` to check all available variables"
                return 1;
            fi
            tmp="$tmp"$'\n'"declare -g $1"
        else
            log_error "Not an variable assignment: $1";
            return 1;
        fi
        shift
    done
    flock -x $DIR/state echo "$tmp" >> $DIR/state.override
    log_info "Wrote '$RELATIVE_DIR/state.override'"
}

declare -ga CHC_FLAGS=()

# Set '--name=value' flags for clickhouse-client
function set_chc_params()
{
    local override=${1:-'false'}; shift;
    local arg name value prefix regex='^([0-9]+[KMGTP])i?B?$';
    for arg; do
        if [[ ! "$arg" =~ ^- ]]; then log_error "[set_chc_params] Argument to pass to clickhouse-client should start with '-' or '--'."; exit 1; fi
        if [[ "$arg" =~ '=' ]]; then # has value
            name=${arg%%=*}; value=${arg#*=};
            [[ $value =~ $regex ]] && value=$(numfmt --from=iec --to=none ${BASH_REMATCH[1]}) || :;
            prefix="$name=";
            arg="$name=$value";
        else
            prefix="$arg";
        fi
        local i=$(
            i=0;
            for x in ${CHC_FLAGS[@]}; do if [[ "$x" =~ ^"$prefix" ]]; then echo $i; break; fi; ((++i)); done
        )
        if [ -n "$i" ]; then
            if [ "$override" == true ]; then
                unset "CHC_FLAGS[$i]";
            else
                continue;
            fi
        fi
        CHC_FLAGS=( "${CHC_FLAGS[@]}" "$arg" );
    done;
}

function get_server_pods()
{
    if ! command -v kubectl >/dev/null; then
        log_error "Command 'kubectl' not found."
        return 1;
    fi

    local ns=$1
    if [ -n "$ns" ]; then
        if ! $KUBECTL get ns "$ns" >/dev/null; then
            log_error "Cannot find namespace $ns."
            return 1;
        fi
        KUBECTL="$KUBECTL -n $ns";
    fi
    declare -ga SERVER_PODS=( $($KUBECTL get pods -l $CLICKHOUSE_SERVER_POD_LABEL -oname | cut -d/ -f2) )

    if ((${#SERVER_PODS[@]} == 0)); then
        log_error "Cannot find any ClickHouse server PODs in namespace $ns."
        return 1;
    fi
    # Verify these are actually ClickHouse PODs
    local res=$(kube_chc_query_all "SELECT 1") regex="^1{${#SERVER_PODS[@]}}\$"
    if ! [[ "$(echo "$res" | tr -d '\n')" =~ $regex ]]; then
        log_error "All PODs should be healthy ClickHouse server, but some are not responding to query 'SELECT 1'. Results: \n$res"
        return 1;
    fi
    log_debug "Server PODs: ${SERVER_PODS[*]}"

    # Randomly pick one POD, prefer -1 replicas
    local idx rand=$RANDOM
    if [[ "${SERVER_PODS[*]}" =~ '-1-0'$ ]]; then rand=$((rand * 2 + 1)); fi
    idx=$((rand % ${#SERVER_PODS[@]}))
    declare -g POD0=${SERVER_PODS[$idx]}
}

declare -gx KUBECTL=${KUBECTL:-kubectl}
declare -g CLICKHOUSE_SERVER_POD_LABEL='clickhouse.altinity.com/chi'

function usage()
{
    unindent "
        Usage:  $PROG_NAME  <COMMAND>  [TASK_DIR]  <[FLAG] | SET_VARS | PROCEDURE>...

            1) $PROG_NAME  list|prune|vars  [FLAG]...
            2) $PROG_NAME  init|create|delete|revert|pause|resume|restart|report|set|walk|walk_state  <TASK_DIR>  [FLAG]...
            3) $PROG_NAME  set  <TASK_DIR>  <SET_VARS>...
            4) $PROG_NAME  rearrange  <TASK_DIR>  PROCEDURE"

    local raw_content=$(sed -n '/^#>>> ARGUMENT BEGIN/,/^#>>> ARGUMENT END/p' $0)
    {
        echo "$raw_content" | sed -n '/^#>>> COMMAND ARGUMENT BEGIN/,/^#>>> COMMAND ARGUMENT END/p'
        echo "$raw_content" | sed -n '/^#>>> FLAG ARGUMENT BEGIN/,/^#>>> FLAG ARGUMENT END/p';
    } \
    | sed -nr '
            /^## ?/{ s|^## ?||; p }
            /^ {8}(-*[a-zA-Z0-9\|_\-]+)\)/{ s| +#:|: #|; s|^ {4}||; p }
            /^ {12,}#.+/{ p }
            /^ {4}#/{ s|^ {4}# ?||g; p }
        ' \
    | awk -F'#' '{ h=$1; $1=""; printf("%-24s%s\n",h,$0) }'

    unindent "
    Definitions
      'procedure'  A sequence of states that are mostly revertable with best effort.
      'state'      A defined set of actions to do, based on some prerequisites, to establish new prerequisites for the next state.
                   The actions are mostly revertable with best effort. A temporary 'try->fail->revert->retry' loop may occur.
      'Chameleon table'   The table with new structure created in state CreateTables, exchanged with the original \$LOCAL_TABLE
                          table in state SwapTables. Therefore it refers to the new empty table before state SwapTables and to
                          the original table after state SwapTables, thus the name 'chameleon'.
      'DT table'    A table with new structure created in state CreateTables alongside the 'Chameleon table'. It is used to
                    transform data from the original \$LOCAL_TABLE table, which is named <LOCAL_TABLE>__CHAMELEON after tables
                    swapped. On completing data transformation, all partitions will be moved from DT table to the new
                    \$LOCAL_TABLE table during state MovePartitions.

    Examples
        1. Initialize a task directory and register as systemd unit
            $PROG_NAME  init  tcp_log_local  --create --cluster '{cluster}' --db business --local tcp_log_local --procedure simple

        2. Configure the task to drop chameleon table in DropTables state
            $PROG_NAME  set  tcp_log_local  STATE_DropTables_DROP_OLD_TABLE=true

        3. Rearrange to 'full' procedure. This should be done right after state Initialize
            $PROG_NAME  rearrange  tcp_log_local  full

    Note
        Please ensure the 'default' account (or the account specified via --chc \"--user=<username>\") is authorized throughout the
        cluster to CREATE, DROP, INSERT INTO new tables, query on system tables and the target table. Otherwise the script is unable
        to carry out the task correctly, for example, runs into a wrong procedure 'simplest' which presumes chameleon table to be empty."
}

function normalize_opts()
{
    local raw_opts=$(sed -n '/^#>>> ARGUMENT BEGIN/,/^#>>> ARGUMENT END/p' $0 \
        | sed -nr '
                /^ {8}(-+[a-zA-Z0-9\|_\-]+)\)/ {
                    s| *\) *#:|:#|           # argument indicator #:
                    s| *#.*$||; s|[ \)]||g   # remove comments, parentheses, whitespaces
                    s/\|/\n/g                # substitute | with \n
                    /:$/ { s|:?$|:|gm }      # populate the argument indicator :
                    s|^-+||gm                # remove leading dash -
                    p
                }
            '
    )
    local short_opts=$(echo "$raw_opts" | awk '/^.:?$/ {print$0}' | tr -d '\n')
    local long_opts=$(echo "$raw_opts" | awk '/^[^:]{2,}:?$/ {print$0}' | tr '\n' ',' | sed 's/,$//')
    getopt -n $PROG_NAME -o $short_opts -l $long_opts -- "$@"
}
opts=$(normalize_opts "$@") || exit 1
eval "set -- $opts"

expected_arg_type='COMMAND'

while (( $# > 0 )); do
#>>> ARGUMENT BEGIN
    if [[ "$1" == '--' ]]; then shift; continue; fi
    if [[ $expected_arg_type = 'FLAG' || "$1" =~ ^'-'.+ ]]; then
        case $1 in
#>>> FLAG ARGUMENT BEGIN
##
## Flags for command init
        --create) # Create the task as well. As if `init <TASK_DIR>` followed by `create <TASK_DIR>`
            FLAG_CREATE=true;
            shift;;
        --cluster) #: The CLUSTER variable.
            CLUSTER=$2
            shift 2;;
        --db|--database) #: The DATABASE variable.
            DATABASE=$2
            shift 2;;
        --distributed) #: The DISTRIBUTED_TABLE variable.
            DISTRIBUTED_TABLE=$2
            shift 2;;
        --shardingkey) #: The DISTRIBUTED_TABLE_SHARDING_KEY variable.
            DISTRIBUTED_TABLE_SHARDING_KEY=$2
            shift 2;;
        --local) #: The LOCAL_TABLE variable. Mandatory.
            LOCAL_TABLE=$2
            shift 2;;
        --reference-file) #: File that stores DDL query of the new table. The NEW_DDL_REFERENCE variable
            NEW_DDL_REFERENCE=$2
            shift 2;;
        --partitionby) #: Creates a template DDL from existing $LOCAL_TABLE with different PARTITION BY clause.
            PARTITIONBY=$2
            shift 2;;
        --primarykey) #: Creates a template DDL from existing $LOCAL_TABLE with different PRIMARY KEY clause.
            PRIMARYKEY=$2
            shift 2;;
        --orderby) #: Creates a template DDL from existing $LOCAL_TABLE with different ORDER BY clause.
            ORDERBY=$2
            shift 2;;
        --ttl) #: Creates a template DDL from existing $LOCAL_TABLE with different TTL clause.
            TTL=$2
            shift 2;;
        --procedure) #: The PROCEDURE variable.
            PROCEDURE=$2
            shift 2;;
        --states) #: The `states' variable.
            PROCEDURE='CUSTOM'
            states=(${2//,/ })
            ensure_state_functions_defined
            shift 2;;
        -v) #: Specify variable assignments. For exmaple the flag --shardingkey 'rand()' can also be
            # given as -v 'DISTRIBUTED_TABLE_SHARDING_KEY="rand()"'. Can be specified multiple times.
            # Note: Please note the extra quotes if there are spaces inside the value:
            #     -v "name='v a l u e'"
            #     -v 'name="v a l u e"'
            #     -v "name=\"v a l u e\""
            if [[ "$2" =~ ^[a-zA-Z][a-zA-Z0-9_]+'='.+$ ]]; then eval "$2"; else log_error "Not an variable assignment: $2"; exit 1; fi
            shift 2;;
##
## Flags for command list
        --relative) # Display task directory path as relative to current working directory.
            FLAG_LIST_RELATIVE=true
            shift;;
##
## Flags for command create
        --start) # Start the newly created task immediately
            FLAG_START=true
            shift;;
##
## Flags for command revert
        --all) # Revert all operations that a task has done.
            FLAG_ALL=true
            shift;;
        --to) #: Revert all operations back until this state.
            FLAG_REVERT_TO=$2
            shift 2;;
##
## Flags for command delete
        --pause) # Pause the task first.
            FLAG_PAUSE=true
            shift;;
        --directory) # Delete task directory.
            FLAG_DIRECTORY=true
            shift;;
##
## Flags for command report
        -2|--two-column) # Display detail of task in 2 columns.
            FLAG_TWO_COLUMN=true
            shift;;
        --var) # Display variables for current state.
            FLAG_VARIABLE=true
            shift;;
##
## Common flags
        --ns|--namespace) #: Kubernetes namespace where ClickHouse cluster lives. Applies to command 'init', 'create'.
            if ! kubectl get ns "$2" >/dev/null; then exit $?; fi
            KUBECTL="$KUBECTL -n $2"
            shift 2;;
        --k8s-label) #: Kubernetes POD label of ClickHouse servers. Defaults to 'clickhouse.altinity.com/chi' Applies
            # to command 'init', 'create'.
            CLICKHOUSE_SERVER_POD_LABEL=$2
            shift 2;;
        --chc) #: A single string containing flags to pass to clickhouse-client. Value of a flag should be directly
            # connected to the flag by equal sign '='. e.g. --chc "--echo -n --max_threads=4". Can be specified multiple
            # times.
            set_chc_params true $2;
            shift 2;;
        --force) # Force action on command 'create', 'delete'
            FLAG_FORCE=true
            shift;;
        -d|--daemon) # Activate/deactivate systemd services. Without the flag, commands 'pause', 'resume', 'revert' only change
            # state variables in task directory. Applies to command 'pause', 'resume', 'revert'
            FLAG_DAEMON=true
            shift;;
        --grace) #: Wait for some time before killing the task process. Defaults to 0 seconds. Applies to command 'pause',
            # 'delete'
            FLAG_GRACE=$2
            if ! [[ "$FLAG_GRACE" =~ ^[0-9]+$ ]]; then log_error "Value of --grace should be an ingeter number, got '$2'"; exit 1; fi
            shift 2;;
        --ech) #: --ech flags to pass to for_each_line2.sh
            ECH_FLAGS+=(--ech "$2");
            shift 2;;
        --dry) # Dry run. Debugging usage only.
            DRY_RUN=true;
            shift;;
        --log-level) #: Logging level. It's persisted for the entire task if specified in command 'create'.
            LOG_LEVEL=$2;
            if [ -z "${LOG_LEVELS[$LOG_LEVEL]}" ]; then echo "Unknown log level $LOG_LEVEL, should be one of ${!LOG_LEVELS[@]}"; exit 1; fi
            shift 2;;
        -h|--help) # This help text.
            usage; exit 0;;
        *)
            log_error "Unknown flag: $1";
            usage; exit 1;
        esac;
#>>> FLAG ARGUMENT END
#>>> COMMAND ARGUMENT BEGIN
##
## Commands
    elif [ $expected_arg_type = 'COMMAND' ]; then
        case $1 in
        list) # List all tasks that are registered as systemd services.
            ;;
        init) # Initialize a task directory.
            ;;
        create) # Create a new task from an existing task directory. A newly created task is put in paused state, with
            # --start flag to run it immediately. With --force to overwrite an existing systemd service.
            ;;
        delete) # Delete systemd unit file of a task. The task should be in Complete state, or with --force flag to delete a
            # paused task. With both flags --force and --pause to pause a running task and delete it (at your own risk).
            # With flag --directory to remove the task directory.
            ;;
        prune) # Delete inactive systemd units of which the task directory does not exist.
            ;;
        revert) # Revert operations that current state of the task has done. With --all to revert all operations that a task
            # has done. With --to STATE_NAME to revert all operations back until STATE_NAME. The running process will
            # take the revert only after finishing current state. To apply it immediately, specify --daemon flag to
            # restart the running daemon process. Or run 'restart' afterwards.
            # Note: Tasks cannot be reverted in and after state MovePartitions.
            ;;
        pause) # Pause a task. By default this command only modifies states in task directory, with --deamon flag to
            # actually deactivate the systemd service. With --grace to wait for some time (defaults to 0 seconds) before
            # killing the process.
            ;;
        resume) # Resume a paused task. By default this command only modifies states in task directory, with --deamon flag
            # to actually activate the systemd service.
            ;;
        restart) # Restart the task.
            ;;
        report) # Report task progress or result of some state.
            ;;
        vars) # List all configurable state variables, also list the variables that are mandatory in 'config' file.
            ;;
        set) # Set state variables for a task. For example: set <TASK_DIR> "STATE_ConsistencyReport_TIMESLOT_INTERVAL='1 HOUR'"
            # Ensure to quote the assignment with extra quotation marks if value contains some spaces,
            # like 'var="va lue"', "var='va lue'", or "var=\"va lue\"", instead of var="va lue"
            ;;
        rearrange) # Rearrange procedures. Run `vars` to check all predefined procedures.
            ;;
        walk) # Execute util the end of the task.
            ;;
        walk_state) # Execute steps of current state.
            ;;
        *)
            log_error "Unknown command '$1', expecting one of list|init|create|delete|prune|revert|pause|resume|restart|report|vars|set|rearrange|walk|walk_state"
            exit 1;
            ;;
        esac
        COMMAND=$1
        if [ $COMMAND == 'list' ]; then
            expected_arg_type='FLAG';
        elif [ $COMMAND == 'prune' ]; then
            prune_tasks; exit $?; # No state dependencies.
        elif [ $COMMAND == 'vars' ]; then
            print_vars; exit $?; # No state dependencies.
        else
            expected_arg_type='TASK_DIR'
        fi
        shift;
    elif [ $expected_arg_type = 'SET_VARS' ]; then
        set_task "$@"; exit $?;
    elif [ $expected_arg_type = 'PROCEDURE' ]; then
        expected_arg_type='FLAG';
        switch_procedure $1;
        exit $?;
    elif [ $expected_arg_type = 'TASK_DIR' ]; then
        if [[ -z "$1" || "$1" =~ ^-.* ]]; then log_error "Expected argument type <TASK_DIR>, got likely <FLAG> = '$1'"; usage; exit 1; fi
        if [[ "$1" =~ [[:space:]] ]]; then log_error "The task directory path contains spaces, which is not supported."; exit 1; fi
        if [ ! -d "$1" ] && [ $COMMAND != 'init' ]; then log_error "Task directory should be a path to an existing directory, got <TASK_DIR> = '$1'"; exit 1; fi
        if dir_is_root "$1"; then log_error "Refusing to use root as task directory"; exit 1; fi

        # Base variable DIR
        DIR=$(realpath -ms "$1")
        if [ -z "$DIR" ]; then log_error "Task directory should be a path to an existing directory, got <TASK_DIR> = '$DIR'"; exit 1; fi

        RELATIVE_DIR=$(realpath -ms --relative-to="$PWD" "$1")
        if [ ${#RELATIVE_DIR} -ge ${#DIR} ]; then RELATIVE_DIR=$DIR; fi

        # Task management variables
        TASK_NAME=$(basename "$DIR")
        TASK_UNIT_FILE_NAME="chtm_$TASK_NAME.service"
        TASK_UNIT_FILE="$SYSTEMD_UNIT_FILES_DIR/$TASK_UNIT_FILE_NAME"

        # load state if <TASK_DIR> is ready.
        if ! [[ $COMMAND =~ ^('init'|'create')$ ]]; then load; fi

        if [ $COMMAND == 'set' ]; then
            expected_arg_type='SET_VARS';
        elif [ $COMMAND == 'rearrange' ]; then
            expected_arg_type='PROCEDURE';
        else
            expected_arg_type='FLAG';
        fi
        shift;
    else
        log_error "Logical Error: Unknown argument type <$expected_arg_type>.";
        usage; exit 1;
    fi
#>>> COMMAND ARGUMENT END
#>>> ARGUMENT END
done

# Incomplete arguments
if [ $expected_arg_type != 'FLAG' ]; then
    log_error "Expecting argument of type <$expected_arg_type>.";
    usage; exit 1;
fi

# Get server PODs if not already.
if ! [[ $COMMAND =~ 'list'|'prune'|'vars' ]]; then
    if [ -z "$POD0" ]; then
        if ! get_server_pods; then exit $?; fi
    fi
fi

if [[ "$COMMAND" == walk || "$COMMAND" == walk_state ]]; then
    $COMMAND
    exit $?
fi

if ! command -v systemctl >/dev/null; then
    log_error "Command 'systemctl' not found. It's needed for task management."
    exit 1;
fi

if func_defined ${COMMAND}_tasks; then
    ${COMMAND}_tasks;
else
    ${COMMAND}_task;
fi

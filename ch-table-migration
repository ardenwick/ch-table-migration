function get_state_indication()
{
    if [ "$REVERT" == 'Initialize' ]; then
        echo "$STATE(R)";
    elif [ -n "$REVERT" ]; then
        echo "$STATE(r)";
    elif [ "$DIRTY" == true ]; then
        echo "$STATE*";
    else
        echo "$STATE";
    fi
}

function log_state_trace(){ local MYPID=$BASHPID; ( set +x; LOG TRACE "[$(get_state_indication)]" "$@" >&$LOG_FD_STDOUT ); }

function s_PreMigrateData()
{
    declare -gA \
        STATE_MigrateData_POD_SCRIPTS=() \
        STATE_MigrateData_SCRIPTS_COMPLETED=()

    local dst_table="\`$DATABASE\`.\`$LOCAL_TABLE_DT\`" src_table="\`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`"
    local datetime_column=$STATE_MigrateData_DATETIME_COLUMN interval=${STATE_MigrateData_TIMESLOT_INTERVAL:-'4 HOUR'}
    local -u direction=${STATE_MigrateData_DIRECTION:-'DESC'}

    local concurrency=${STATE_MigrateData_CONCURRENCY:-'1'} mode=${STATE_MigrateData_CONCURRENCY_MODE:-'PROCESS'};

    if (( concurrency <= 0 )); then
        log_state_error "Variable 'STATE_MigrateData_CONCURRENCY' should be a positive integer, got $STATE_MigrateData_CONCURRENCY";
        pause; return 1;
    fi
    if ! [[ "$mode" =~ ^('PROCESS'|'THREAD')$ ]]; then
        log_state_error "Variable 'STATE_MigrateData_CONCURRENCY_MODE' should be 'PROCESS' or 'THREAD', got '$STATE_MigrateData_CONCURRENCY_MODE'";
        pause false; return 2;
    fi
    if ! [[ "$direction" =~ ^('ASC'|'DESC')$ ]]; then
        log_state_error "Variable 'STATE_MigrateData_DIRECTION' should be 'ASC' or 'DESC', got '$STATE_MigrateData_DIRECTION'";
        pause false; return 2;
    fi

    RELOAD=true;
    (
        set -e;
        r_PreMigrateData;
        log_state_info "Generating 'INSERT INTO $dst_table SELECT * FROM $src_table' queries..."

        local -a server_pods=( $(get_replicated_server_pods) )

        trap_kill_group;

        local pids='';
        for pod in ${server_pods[@]}; do
            ./for_each_line2.sh --log-level $LOG_LEVEL \
                --file "$DIR/dt.$pod.sql" --pod $pod \
                --chc "${CHC_FLAGS[*]}" \
                --templated-generator preview insert_select_with_columns_by_timeslot \
                "dst_table=$dst_table,src_table=$src_table,datetime_column=$datetime_column,interval=$interval,direction=$direction" 2> >(last_error >&2) &
            pids+=" $!"
        done
        for pid in $pids; do wait $pid; done
        trap_restore_kill_group;

        log_state_info "Wrote files '$RELATIVE_DIR/dt.*.sql'"

        if [ $mode == 'PROCESS' ] && [ $concurrency != 1 ]; then
            set_chc_params true --max_threads=1 --max_insert_threads=1
        else
            set_chc_params true --max_threads=$concurrency --max_insert_threads=$concurrency
        fi

        for pod in ${server_pods[@]}; do
            local f="$DIR/dt.$pod.sql"
            if [ $mode == 'PROCESS' ] && [ $concurrency != 1 ]; then
                if ! [ -f "$f" ]; then log_state_error "File disappeared: $f."; return 1; fi
                # Split file: $f --> $f.splitted.01, $f.splitted.02 ...
                (cd $DIR; awk -v prefix=$f -v concurrency=$concurrency '{ file=sprintf("%s.splitted.%02d.sql", prefix, NR % concurrency + 1); print > file }' $f)
                STATE_MigrateData_POD_SCRIPTS[$pod]=$(ls $f.splitted.*.sql | tr '\n' ' ')
            else
                STATE_MigrateData_POD_SCRIPTS[$pod]=$f
            fi
        done
        log_state_debug "Gathered task files: ${NC}\n$(IFS=$'\n'; echo "${STATE_MigrateData_POD_SCRIPTS[*]}")";
        store '' '' ''; # Commit variable STATE_MigrateData_POD_SCRIPTS
    )
}

function r_PreMigrateData() { (cd $DIR; rm -rf dt.*.sql dt.*.sql.splitted.* dt.*.state) }

function s_MigrateData()
{
    RELOAD=true;
(
    set -e;

    if [ ! -f './for_each_line2.sh' ] && ! command -v for_each_line2.sh >/dev/null; then
        log_state_error "Not found script for_each_line2.sh";
        pause;
        return 1;
    fi
    log_state_info "Got task files: ${NC}\n$(IFS=$'\n'; echo "${STATE_MigrateData_POD_SCRIPTS[*]}")"

    trap_kill_group true; # Fine if the trap not restored

    local -A script_pids=()

    while true; do
        local all_completed=true;
        for pod in ${!STATE_MigrateData_POD_SCRIPTS[@]}; do
            for script in ${STATE_MigrateData_POD_SCRIPTS[$pod]}; do
                if [ "${STATE_MigrateData_SCRIPTS_COMPLETED[$script]}" == true ]; then continue; fi
                local pid=${script_pids[$script]}
                # Process not spawned or has stopped.
                if [[ -z "$pid" || ! -e /proc/$pid ]]; then
                    if [ -z "$pid" ]; then
                        log_state_info "Spawning for_each_line2.sh with script '$script'"
                    else
                        if wait $pid; then
                            log_state_info "Script '$script' has been completed. Last process PID $pid"
                            STATE_MigrateData_SCRIPTS_COMPLETED[$script]=true;
                            store '' '' '';
                            continue;
                        else
                            log_state_warn "Process (PID $pid) of script '$script' exited with code $?, respawning it."
                        fi
                    fi
                    if s_CheckTablesNotReadOnly $LOCAL_TABLE_DT; then # Check before insert.

                        ./for_each_line2.sh --log-level $LOG_LEVEL \
                            --file "$script" --pod $pod \
                            --dsh insert_select_delete_where --ech '241 call insert_select_delete_where' "${ECH_FLAGS[@]}" --chc "${CHC_FLAGS[*]}" \
                            &
                        script_pids[$script]=$!
                    else
                        log_error "Table \`$LOCAL_TABLE_DT\` is readonly on replica $pod"
                    fi
                else
                    : # Process still running
                fi
                all_completed=false;
            done
        done
        if [ $all_completed == true ]; then
            log_state_info "All data migration tasks completed."
            break;
        else
            sleep 10;
        fi
    done
    trap_restore_kill_group;
)}


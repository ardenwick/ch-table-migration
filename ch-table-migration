function s_CreateTables()
{(
    set -e; # Fine, we are not changing any variable here
    s_CheckTablesNotReadOnly || :;
    s_WaitOnBusyDistributedDDLQueue 0;

    # Chameleon table
    log_state_info "Creating table $LOCAL_TABLE_CHAMELEON"
    kube_chc_query "$DDL_ON_CLUSTER_CHAMELEON"

    # Data transformation table
    log_state_info "Creating table $LOCAL_TABLE_DT"
    kube_chc_query "$DDL_ON_CLUSTER_DT"

    # Merge table
    log_state_info "Creating table $LOCAL_TABLE_MERGED"
    kube_chc_query "$DDL_ON_CLUSTER_MERGE_CHAMELEON"

    # Table settings
    log_state_info "Adjusting table settings for better ingestion behavior"
    kube_chc_query "
        ALTER TABLE \`$DATABASE\`.\`$LOCAL_TABLE_DT\` ON CLUSTER '$CLUSTER'
            MODIFY SETTING
                number_of_free_entries_in_pool_to_execute_mutation=1,
                replicated_deduplication_window=0,
                non_replicated_deduplication_window=0,
                old_parts_lifetime=60,
                max_parts_in_total=100000,
                parts_to_delay_insert=100000,
                parts_to_throw_insert=100000
        " --echo;

    local v=${REPLICATED_MUTATION_THREADS:-'2'};
    if [ "$ENGINE_REPLICATED" == true ]; then
        kube_chc_query "ALTER TABLE \`$DATABASE\`.\`$LOCAL_TABLE_DT\` ON CLUSTER '$CLUSTER' MODIFY SETTING max_replicated_mutations_in_queue=$v;" --echo;
    fi
)}


function s_ConsistencyReport()
{(
    set -e;
    # report data consistency
    local datetime_column=$STATE_MigrateData_DATETIME_COLUMN interval=${STATE_ConsistencyReport_TIMESLOT_INTERVAL:-${STATE_MigrateData_TIMESLOT_INTERVAL:-'4 HOUR'}}
    local res1 res2

    res1=$(kube_chc_query "
        WITH
            (SELECT count() FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_DT')) AS count_dt,
            (SELECT count() FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_CHAMELEON')) AS count_chameleon
        SELECT
            count_dt AS \`DT Table\`, count_chameleon AS \`Chameleon Table\`,
            count_chameleon - count_dt AS Diff, round(Diff * 100 / count_chameleon, 5) AS \`Diff %\`
    " --format PrettyCompactMonoBlock)

    res2=$(kube_chc_query "
        SELECT
            time_slot AS \`Time Slot\`, host AS Host, l.count AS \`DT Table\`, r.count AS \`Chameleon Table\`,
            r.count - l.count AS Diff, round(Diff * 100 / r.count, 5) AS \`Diff %\`
        FROM
        (
            SELECT hostname() AS host, toStartOfInterval($datetime_column, INTERVAL $interval) AS time_slot, count() AS count
            FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_DT')
            GROUP BY host, time_slot
        ) AS l
        FULL OUTER JOIN
        (
            SELECT hostname() AS host, toStartOfInterval($datetime_column, INTERVAL $interval) AS time_slot, count() AS count
            FROM clusterAllReplicas('$CLUSTER','$DATABASE','$LOCAL_TABLE_CHAMELEON')
            GROUP BY host, time_slot
        ) AS r USING (host, time_slot)
        WHERE abs(Diff) > 0
        ORDER BY time_slot, host
    " --format PrettyCompactMonoBlock)

    local consistent=false
    if [ -z "$res2" ]; then
        local count_dt count_chameleon diff
        read count_dt count_chameleon diff _ <<<"$(index_line 2 "$res1" | tr -d │)"
        if [[ -n "$count_dt" && -n "$count_chameleon" && -n "$diff" && "$count_dt" == "$count_chameleon" && "$diff" == '0' ]]; then
            consistent=true
        fi
    fi

    local res;
    if [ $consistent == true ]; then
        res="Data is consistent between tables \`$DATABASE\`.\`$LOCAL_TABLE_DT\` and \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`."
        res="$res\n\nSummary:\n$res1"
    else
        res="Data is NOT consistent between tables \`$DATABASE\`.\`$LOCAL_TABLE_DT\` and \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\`."
        res="$res\n\nRun \`set $RELATIVE_DIR STATE=MigrateData REVERT=state PAUSED=false\` to revert the data migration state, if needed, before proceeding to next states."
        if [ "$ENGINE_DEDUPLICATING" == true ]; then
            res="$res\n\nNote: This can be normal for Replacing|Summing|Aggregating|VersionedCollapsing MergeTree tables."
            res="$res  \n      Run query 'OPTIMIZE TABLE \`$DATABASE\`.\`$LOCAL_TABLE_CHAMELEON\` FINAL' on ClickHouse servers (at your own risk),"
            res="$res  \n      then \`revert $RELATIVE_DIR\` and repeat \`walk_state $RELATIVE_DIR\` twice to re-generate the consistency report."
        fi
        res="$res\n\nSummary:\n$res1"
        res="$res\nBy time slots:\n$res2"
    fi
    echo -e "$res\n$(datetime_ms) @ $(hostname -f)" > $DIR/consistency_report

    log_state_info "Wrote consistency report to '$RELATIVE_DIR/consistency_report':$RST\n$res"
)}


    log_state_info "Checking if materialization of indexes and projections is done..."
    local interval=${STATE_WaitMaterializationDone_INTERVAL:-10}

    local res1 query1="SELECT count() FROM clusterAllReplicas('$CLUSTER',system.mutations) WHERE is_done=0 AND database='$DATABASE' AND table='$LOCAL_TABLE_DT'"
    local res2 query2="SELECT count() FROM clusterAllReplicas('$CLUSTER',system.mutations) WHERE is_done=0 AND database='$DATABASE' AND table='$LOCAL_TABLE_DT' AND latest_fail_reason!=''"

    res1=$(kube_chc_query "$query1")
